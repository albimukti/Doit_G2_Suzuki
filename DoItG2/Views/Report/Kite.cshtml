@{
    Layout = "_Layout";
}

<div class="card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Saldo & Laporan KITE</h2>
            <div class="card-subtitle">Mengelola saldo bahan baku/barang jadi fasilitas KITE dan membuat laporan pertanggungjawaban</div>
        </div>
        <a href="/Report/ExportKiteExcel" class="btn btn-success" style="height: 38px; padding: 0 18px; font-weight: 700;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Export ke Excel
        </a>
    </div>

    <!-- KITE Summary Cards -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap:16px; margin-bottom:24px;">
        <div style="background:var(--bg-secondary);border-radius:10px;padding:20px;border:1px solid var(--border-color);">
            <div style="font-size:12px;color:var(--text-tertiary);text-transform:uppercase;font-weight:600;letter-spacing:0.5px">Saldo Bahan Baku</div>
            <div style="font-size:28px;font-weight:700;color:var(--primary);margin-top:4px">1,245</div>
            <div style="font-size:12px;color:var(--text-secondary);margin-top:4px">item aktif dalam SKEP</div>
        </div>
        <div style="background:var(--bg-secondary);border-radius:10px;padding:20px;border:1px solid var(--border-color);">
            <div style="font-size:12px;color:var(--text-tertiary);text-transform:uppercase;font-weight:600;letter-spacing:0.5px">Total Pemasukan (YTD)</div>
            <div style="font-size:28px;font-weight:700;color:var(--success, #22c55e);margin-top:4px">327</div>
            <div style="font-size:12px;color:var(--text-secondary);margin-top:4px">pengapalan impor masuk</div>
        </div>
        <div style="background:var(--bg-secondary);border-radius:10px;padding:20px;border:1px solid var(--border-color);">
            <div style="font-size:12px;color:var(--text-tertiary);text-transform:uppercase;font-weight:600;letter-spacing:0.5px">Total Pengeluaran (YTD)</div>
            <div style="font-size:28px;font-weight:700;color:var(--warning, #f59e0b);margin-top:4px">280</div>
            <div style="font-size:12px;color:var(--text-secondary);margin-top:4px">kontainer ekspor keluar</div>
        </div>
        <div style="background:var(--bg-secondary);border-radius:10px;padding:20px;border:1px solid var(--border-color);">
            <div style="font-size:12px;color:var(--text-tertiary);text-transform:uppercase;font-weight:600;letter-spacing:0.5px">BM Dibebaskan</div>
            <div style="font-size:28px;font-weight:700;color:var(--text-primary);margin-top:4px">5.57M</div>
            <div style="font-size:12px;color:var(--text-secondary);margin-top:4px">Rp (year to date)</div>
        </div>
    </div>

    <!-- Saldo Table -->
    <div style="margin-bottom:24px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--text-primary);margin-bottom:12px;display:flex;align-items:center;gap:8px;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
            Saldo Bahan Baku (Top 10)
        </h3>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Part No</th>
                        <th>Nama Barang</th>
                        <th>HS Code</th>
                        <th>Satuan</th>
                        <th style="text-align:right">Saldo Awal</th>
                        <th style="text-align:right">Pemasukan</th>
                        <th style="text-align:right">Pengeluaran</th>
                        <th style="text-align:right">Saldo Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>13801-77R10</code></td>
                        <td>FILTER ASSY, AIR CLEANER</td>
                        <td>84219910</td>
                        <td>PCS</td>
                        <td style="text-align:right">500</td>
                        <td style="text-align:right;color:var(--success, #22c55e)">+200</td>
                        <td style="text-align:right;color:var(--warning, #f59e0b)">-180</td>
                        <td style="text-align:right;font-weight:600">520</td>
                    </tr>
                    <tr>
                        <td><code>71711-77R00</code></td>
                        <td>BUMPER, REAR</td>
                        <td>87082990</td>
                        <td>PCS</td>
                        <td style="text-align:right">300</td>
                        <td style="text-align:right;color:var(--success, #22c55e)">+150</td>
                        <td style="text-align:right;color:var(--warning, #f59e0b)">-120</td>
                        <td style="text-align:right;font-weight:600">330</td>
                    </tr>
                    <tr>
                        <td><code>25185M68P00</code></td>
                        <td>GEAR, 5TH DRIVEN</td>
                        <td>87084029</td>
                        <td>PCS</td>
                        <td style="text-align:right">1,000</td>
                        <td style="text-align:right;color:var(--success, #22c55e)">+500</td>
                        <td style="text-align:right;color:var(--warning, #f59e0b)">-450</td>
                        <td style="text-align:right;font-weight:600">1,050</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Laporan Periodik -->
    <div>
        <h3 style="font-size:15px;font-weight:600;color:var(--text-primary);margin-bottom:12px;display:flex;align-items:center;gap:8px;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Laporan Pertanggungjawaban KITE
        </h3>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Periode</th>
                        <th>Jenis Laporan</th>
                        <th>Bahan Baku Impor (PIB)</th>
                        <th>Bea Masuk Bebas (IDR)</th>
                        <th>Hasil Produksi (PEB)</th>
                        <th>Status Laporan</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Triwulan I 2026</td>
                        <td>BCL.KT01</td>
                        <td>145 Pengapalan</td>
                        <td>Rp 2.450.000.000</td>
                        <td>120 Kontainer Ekspor</td>
                        <td><span class="badge badge-approved">SELESAI AUDIT</span></td>
                    </tr>
                    <tr>
                        <td>Triwulan II 2026</td>
                        <td>BCL.KT01</td>
                        <td>182 Pengapalan</td>
                        <td>Rp 3.120.500.000</td>
                        <td>160 Kontainer Ekspor</td>
                        <td><span class="badge badge-sent">SUBMITTED</span></td>
                    </tr>
                    <tr>
                        <td>Triwulan III 2026</td>
                        <td>BCL.KT01</td>
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td><span class="badge badge-draft">DRAFT</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
