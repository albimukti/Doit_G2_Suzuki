@model List<DoItG2.Models.PEB.PebHeaderModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Laporan Realisasi Ekspor (PEB BC 3.0)";
    var search = ViewBag.Search as string ?? "";
    var dateFrom = ViewBag.DateFrom as string ?? "";
    var dateTo = ViewBag.DateTo as string ?? "";
    
    int totalPeb = Model.Count;
    int npeCount = Model.Count(m => m.Status == "APPROVED" || m.Status == "NPE" || !string.IsNullOrEmpty(m.Nopen));
    decimal totalFob = Model.Sum(m => m.Fob);
    decimal totalNetto = Model.Sum(m => m.Netto);
}

<div class="glass-card mb-24" style="padding: 24px;">
    <!-- Header Section -->
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border-color);">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 52px; height: 52px; border-radius: 14px; background: #ffffff; padding: 6px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.18);">
                <img src="~/images/suzuki-logo-square.png" alt="Suzuki Logo" style="width: 100%; height: 100%; object-fit: contain;" asp-append-version="true" />
            </div>
            <div>
                <h2 class="card-title" style="font-size: 20px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 10px;">
                    Laporan Realisasi Ekspor (BC 3.0 / PEB)
                    <span class="badge badge-peb" style="font-size: 11px;">CEISA 4.0</span>
                </h2>
                <div class="card-subtitle" style="font-size: 13px; color: var(--text-muted); margin-top: 2px;">
                    Monitoring data pengapalan ekspor, kalkulasi FOB, dan perolehan Nota Pelayanan Ekspor (NPE)
                </div>
            </div>
        </div>

        <a href="/Report/ExportPebExcel?search=@search&dateFrom=@dateFrom&dateTo=@dateTo" class="btn btn-success" style="height: 40px; padding: 0 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; border-radius: var(--border-radius-sm);">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Export Excel</span>
        </a>
    </div>

    <!-- KPI Summary Grid (4 Mini Stat Cards) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 16px 20px;">
            <div style="font-size: 11.5px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Total Dokumen PEB</div>
            <div style="font-size: 26px; font-weight: 800; color: var(--text-primary); font-family: 'JetBrains Mono', monospace; margin-top: 4px;">@totalPeb <span style="font-size: 13px; font-weight: 500; color: var(--text-muted);">dokumen</span></div>
        </div>

        <div style="background: rgba(6,182,212,0.05); border: 1px solid rgba(6,182,212,0.2); border-radius: var(--border-radius); padding: 16px 20px;">
            <div style="font-size: 11.5px; font-weight: 600; color: var(--accent-info); text-transform: uppercase; letter-spacing: 0.5px;">Total Nilai FOB</div>
            <div style="font-size: 24px; font-weight: 800; color: var(--accent-info); font-family: 'JetBrains Mono', monospace; margin-top: 4px;">$ @totalFob.ToString("N2")</div>
        </div>

        <div style="background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--border-radius); padding: 16px 20px;">
            <div style="font-size: 11.5px; font-weight: 600; color: var(--accent-success); text-transform: uppercase; letter-spacing: 0.5px;">NPE Terbit (Approved)</div>
            <div style="font-size: 26px; font-weight: 800; color: var(--accent-success); font-family: 'JetBrains Mono', monospace; margin-top: 4px;">@npeCount <span style="font-size: 13px; font-weight: 500; color: var(--text-muted);">terbit</span></div>
        </div>

        <div style="background: rgba(99,102,241,0.05); border: 1px solid rgba(99,102,241,0.2); border-radius: var(--border-radius); padding: 16px 20px;">
            <div style="font-size: 11.5px; font-weight: 600; color: var(--accent-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Total Netto Ekspor</div>
            <div style="font-size: 24px; font-weight: 800; color: var(--accent-secondary); font-family: 'JetBrains Mono', monospace; margin-top: 4px;">@totalNetto.ToString("N2") <span style="font-size: 12px; font-weight: 500;">KGM</span></div>
        </div>
    </div>

    <!-- Filter Bar -->
    <form method="get" action="/Report/Peb" style="display: flex; align-items: flex-end; gap: 14px; margin-bottom: 24px; background: var(--bg-secondary); padding: 18px 20px; border-radius: var(--border-radius-lg); border: 1px solid var(--border-color); flex-wrap: wrap;">
        <div class="form-group" style="margin-bottom: 0; flex: 2; min-width: 220px;">
            <label class="form-label" style="font-size: 11.5px; font-weight: 600; margin-bottom: 4px;">Pencarian (Kata Kunci / Nomor CAR)</label>
            <input type="text" name="search" class="form-control" value="@search" placeholder="Cari Nomor CAR, Pembeli, Negara..." style="height: 38px;" />
        </div>
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label class="form-label" style="font-size: 11.5px; font-weight: 600; margin-bottom: 4px;">Tanggal Mulai</label>
            <input type="date" name="dateFrom" class="form-control" value="@dateFrom" style="height: 38px;" />
        </div>
        <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
            <label class="form-label" style="font-size: 11.5px; font-weight: 600; margin-bottom: 4px;">Tanggal Selesai</label>
            <input type="date" name="dateTo" class="form-control" value="@dateTo" style="height: 38px;" />
        </div>
        <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn btn-primary" style="height: 38px; padding: 0 20px; font-weight: 600;">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-right: 4px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                Terapkan Filter
            </button>
            <a href="/Report/Peb" class="btn btn-secondary" style="height: 38px; padding: 0 16px; font-weight: 500;">Reset</a>
        </div>
    </form>

    <!-- Table Stream -->
    <div class="table-wrapper" style="border-radius: var(--border-radius); border: 1px solid var(--border-color); overflow: hidden;">
        <table class="data-table">
            <thead>
                <tr style="background: var(--bg-tertiary);">
                    <th style="width: 50px; text-align: center;">No</th>
                    <th style="width: 220px;">Nomor CAR (AJU)</th>
                    <th>Pembeli &amp; Negara Tujuan</th>
                    <th style="width: 120px; text-align: center;">Tgl Ekspor</th>
                    <th style="width: 150px; text-align: right;">Nilai FOB (USD)</th>
                    <th style="width: 130px; text-align: right;">Netto (KGM)</th>
                    <th style="width: 120px; text-align: center;">Status CEISA</th>
                    <th style="width: 90px; text-align: center;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 48px; color: var(--text-muted);">
                            <div style="font-size: 15px; font-weight: 600; color: var(--text-secondary);">Tidak ada data laporan PEB</div>
                            <div style="font-size: 12.5px; margin-top: 4px;">Silakan sesuaikan filter tanggal di atas untuk melihat data transaksi lainnya.</div>
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr class="report-table-row">
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px; font-weight: 600;">@(no++)</td>
                            <td>
                                <span class="code-badge" style="font-size: 11.5px; letter-spacing: 0.3px;">@item.Car</span>
                            </td>
                            <td>
                                <div style="font-weight: 700; color: var(--text-primary); font-size: 13px;">
                                    @(string.IsNullOrEmpty(item.NamaBeli) ? "PT. SUZUKI INDOMOBIL MOTOR" : item.NamaBeli)
                                </div>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                    Negara: <strong style="color: var(--text-secondary);">@(string.IsNullOrEmpty(item.NegBeli) ? "ID - INDONESIA" : item.NegBeli)</strong>
                                </div>
                            </td>
                            <td style="text-align: center; font-size: 12.5px; font-weight: 500;">
                                @(item.TgEks.HasValue ? item.TgEks.Value.ToString("dd/MM/yyyy") : "-")
                            </td>
                            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--accent-info); font-size: 13.5px;">
                                $@item.Fob.ToString("N2")
                            </td>
                            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 12.5px;">
                                @item.Netto.ToString("N2")
                            </td>
                            <td style="text-align: center;">
                                @if (item.Status == "APPROVED" || item.Status == "NPE" || !string.IsNullOrEmpty(item.Nopen))
                                {
                                    <span class="badge badge-approved" style="font-size: 10.5px; padding: 4px 10px;">NPE TERBIT</span>
                                }
                                else if (item.Status == "SENT")
                                {
                                    <span class="badge badge-sent" style="font-size: 10.5px; padding: 4px 10px;">TERKIRIM</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft" style="font-size: 10.5px; padding: 4px 10px;">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <a href="/Peb/Detail/@item.Car" class="btn btn-sm btn-secondary" style="padding: 4px 10px; font-size: 11.5px; font-weight: 600;" title="Lihat Detail PEB">
                                    Detail
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (Model.Count > 0)
            {
                <tfoot>
                    <tr style="background: var(--bg-secondary); font-weight: 700;">
                        <td colspan="4" style="text-align: right; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); padding: 14px 16px;">
                            Grand Total Periodik:
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: var(--accent-info); font-size: 14px; padding: 14px 16px;">
                            $ @totalFob.ToString("N2")
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: var(--accent-secondary); font-size: 13px; padding: 14px 16px;">
                            @totalNetto.ToString("N2") KGM
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
