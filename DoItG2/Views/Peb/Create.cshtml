@section Styles {
<style>
    /* Uiverse.io Menu Expandable Tab System - Clean Flexbox without Collision */
    .peb-tabs.menu {
        padding: 0.5rem;
        background-color: var(--bg-card, #ffffff);
        position: relative;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 8px;
        border-radius: 15px;
        box-shadow: 0 10px 25px 0 rgba(0, 0, 0, 0.075);
        border: 1px solid var(--border-color, #e2e8f0);
        margin: 0 0 24px 0;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .peb-tab.link {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0;
        width: 58px;
        min-width: 58px;
        height: 46px;
        padding: 0 10px;
        border-radius: 10px;
        position: relative;
        z-index: 1;
        overflow: hidden;
        transform-origin: center left;
        transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.25s cubic-bezier(0.4, 0, 0.2, 1), gap 0.25s cubic-bezier(0.4, 0, 0.2, 1), padding 0.25s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, border-color 0.2s ease;
        text-decoration: none;
        color: var(--text-secondary, #64748b);
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        flex-shrink: 0;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
    }

    .peb-tab.link::before {
        position: absolute;
        z-index: -1;
        content: "";
        display: block;
        border-radius: 10px;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        transform: translateX(100%);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: center right;
        background-color: var(--bg-hover, #f1f5f9);
    }

    .peb-tab .tab-icon.link-icon {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: static;
        margin: 0;
        transition: transform 0.2s ease, color 0.2s ease;
        color: inherit;
    }

    .peb-tab .tab-icon.link-icon svg {
        width: 22px;
        height: 22px;
        stroke-width: 2;
    }

    .peb-tab .tab-label.link-title {
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        white-space: nowrap;
        transform: translateX(6px);
        transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 13px;
        font-weight: 700;
        text-indent: 0;
        margin: 0;
        padding: 0;
        display: inline-block;
    }

    /* Hover & Focus state: Expand Tab smoothly without overlapping icon */
    .peb-tab.link:hover,
    .peb-tab.link:focus {
        outline: 0;
        width: auto;
        min-width: 140px;
        padding: 0 16px;
        gap: 8px;
        color: var(--text-primary, #0f172a);
    }

    .peb-tab.link:hover::before,
    .peb-tab.link:focus::before {
        transform: translateX(0);
    }

    .peb-tab.link:hover .tab-label.link-title,
    .peb-tab.link:focus .tab-label.link-title {
        max-width: 130px;
        opacity: 1;
        transform: translateX(0);
    }

    /* Active State: Always Expanded with Vibrant Primary Accent */
    .peb-tab.link.active {
        width: auto;
        min-width: 145px;
        padding: 0 16px;
        gap: 8px;
        background: linear-gradient(135deg, var(--accent-primary, #2563eb), #1d4ed8) !important;
        color: #ffffff !important;
        border-color: transparent !important;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
    }

    .peb-tab.link.active::before {
        transform: translateX(0);
        background-color: transparent !important;
    }

    .peb-tab.link.active .tab-label.link-title {
        max-width: 130px;
        opacity: 1;
        transform: translateX(0);
        color: #ffffff !important;
    }

    .peb-tab.link.active .tab-icon.link-icon {
        color: #ffffff !important;
    }

    /* Tab Status Validation Colors */
    .peb-tab.tab-success {
        border-bottom: 3px solid #16a34a !important;
    }
    .peb-tab.tab-success .tab-icon.link-icon {
        color: #16a34a;
    }
    .peb-tab.active.tab-success .tab-icon.link-icon {
        color: #ffffff !important;
    }

    .peb-tab.tab-danger {
        border-bottom: 3px solid #dc2626 !important;
    }
    .peb-tab.tab-danger .tab-icon.link-icon {
        color: #dc2626;
    }
    .peb-tab.active.tab-danger .tab-icon.link-icon {
        color: #ffffff !important;
    }
    .peb-panel {
        display: none;
        padding: 0 24px 8px;
        animation: fadeInPanel 0.3s ease;
    }
    .peb-panel.active {
        display: block;
    }
    @@keyframes fadeInPanel {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }
    .panel-icon {
        color: var(--primary);
        flex-shrink: 0;
    }
    .entity-section {
        background: var(--bg-secondary);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid var(--border-color);
    }
    .section-subtitle {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 12px;
    }
    .doc-row {
        padding: 8px 0;
    }

    /* Input Field Real-time Status Colors */
    .form-control.field-valid {
        border-color: #16a34a !important;
        background-color: rgba(22, 163, 74, 0.03) !important;
    }
    .form-control.field-invalid {
        border-color: #dc2626 !important;
        background-color: rgba(220, 38, 38, 0.04) !important;
    }
</style>
}

@section Scripts {
<script>
(function() {
    var currentTab = 1;
    var totalTabs = 9;

    window.DoIt = window.DoIt || {};

    DoIt.switchPebTab = function(n) {
        currentTab = n;
        document.querySelectorAll('.peb-tab').forEach(function(t) {
            t.classList.toggle('active', parseInt(t.dataset.tab) === n);
        });
        document.querySelectorAll('.peb-panel').forEach(function(p) {
            p.classList.toggle('active', p.id === 'pebPanel' + n);
        });
        document.getElementById('prevPebTabBtn').style.display = n > 1 ? '' : 'none';
        document.getElementById('nextPebTabBtn').style.display = n < totalTabs ? '' : 'none';
        document.getElementById('submitPebBtn').style.display = n === totalTabs ? '' : 'none';

        DoIt.validateAllPebTabs();
    };

    DoIt.nextPebTab = function() {
        if (currentTab < totalTabs) {
            DoIt.switchPebTab(currentTab + 1);
        }
    };

    DoIt.prevPebTab = function() {
        if (currentTab > 1) DoIt.switchPebTab(currentTab - 1);
    };

    var pebTabNames = ['Header', 'Entitas', 'Dokumen', 'Pengangkut', 'Kemasan & Peti', 'Transaksi', 'Detail Barang', 'Pungutan', 'Pernyataan'];

    // Dynamic Tab & Field Validation System for PEB (Green = complete, Red = ada field kosong)
    DoIt.validateAllPebTabs = function(forceHighlight) {
        var invalidTabs = [];

        for (var i = 1; i <= totalTabs; i++) {
            var panel = document.getElementById('pebPanel' + i);
            var tabBtn = document.querySelector('.peb-tab[data-tab="' + i + '"]');
            if (!panel || !tabBtn) continue;

            var reqFields = panel.querySelectorAll('.req-field, [required]');
            var isComplete = true;

            reqFields.forEach(function(input) {
                var val = (input.value || '').trim();
                if (val !== '') {
                    input.classList.add('field-valid');
                    input.classList.remove('field-invalid');
                } else {
                    isComplete = false;
                    input.classList.remove('field-valid');
                    // Warnai field merah jika dipaksa atau sudah disentuh
                    if (forceHighlight || input.dataset.touched === 'true') {
                        input.classList.add('field-invalid');
                    }
                }
            });

            // Pemeriksaan khusus baris dinamis per tab
            if (i === 3) {
                var docInputs = panel.querySelectorAll('[name="DocNo[]"]');
                var hasDoc = Array.from(docInputs).some(function(inp) { return (inp.value || '').trim() !== ''; });
                if (!hasDoc) isComplete = false;
            } else if (i === 7) {
                var hsInputs = panel.querySelectorAll('[name="BrgHs[]"]');
                var hasItem = Array.from(hsInputs).some(function(inp) { return (inp.value || '').trim() !== ''; });
                if (!hasItem) isComplete = false;
            }

            tabBtn.classList.remove('tab-success', 'tab-danger');
            if (reqFields.length === 0 && i !== 3 && i !== 7) {
                // Tab tanpa field wajib
            } else if (isComplete) {
                tabBtn.classList.add('tab-success');
            } else {
                tabBtn.classList.add('tab-danger');
                invalidTabs.push({
                    index: i,
                    name: 'Tab ' + i + ' (' + (pebTabNames[i - 1] || '') + ')',
                    panel: panel
                });
            }
        }

        return invalidTabs;
    };

    // Validasi Peringatan Saat Menekan Tombol Simpan PEB
    DoIt.validatePebBeforeSubmit = function(e) {
        var invalidTabs = DoIt.validateAllPebTabs(true);
        if (invalidTabs && invalidTabs.length > 0) {
            if (e && typeof e.preventDefault === 'function') e.preventDefault();

            var firstInvalid = invalidTabs[0];
            var invalidNames = invalidTabs.map(function(t) { return t.name; }).join('\n• ');

            // Otomatis pindah ke tab pertama yang belum lengkap
            DoIt.switchPebTab(firstInvalid.index);

            // Fokus ke field pertama yang masih kosong
            var firstEmptyInput = firstInvalid.panel.querySelector('.field-invalid, [required]:invalid, .req-field:not(.field-valid), [name="DocNo[]"], [name="BrgHs[]"]');
            if (firstEmptyInput) {
                setTimeout(function() {
                    firstEmptyInput.focus();
                }, 150);
            }

            // Tampilkan notifikasi peringatan
            if (typeof DoIt.toast === 'function') {
                DoIt.toast('⚠️ Dokumen PEB belum lengkap! Masih ada ' + invalidTabs.length + ' tab bertanda merah.', 'error');
            }

            if (typeof DoIt.confirmModal === 'function' || typeof DoIt.alert === 'function') {
                DoIt.alert(
                    'Dokumen PEB (BC 3.0) belum dapat disimpan karena terdapat ' + invalidTabs.length + ' tab yang belum terisi lengkap (berwarna merah):\n\n• ' + invalidNames + '\n\nSilakan lengkapi semua tab bertanda merah terlebih dahulu.',
                    '⚠️ Peringatan: Dokumen Belum Lengkap'
                );
            } else {
                alert('⚠️ PERINGATAN: DOKUMEN PEB BELUM LENGKAP!\n\nDokumen tidak dapat disimpan karena masih ada ' + invalidTabs.length + ' tab yang belum terisi (berwarna merah):\n\n• ' + invalidNames + '\n\nHarap lengkapi semua tab bertanda merah terlebih dahulu sebelum menyimpan dokumen.');
            }

            return false;
        }

        if (typeof DoIt.showLoading === 'function') {
            DoIt.showLoading('Menyimpan dokumen PEB (BC 3.0)...');
        }
        return true;
    };

    DoIt.copyPebPenerima = function() {
        var nm = document.getElementById('peb_NamaPenerima').value;
        var al = document.getElementById('peb_AlmtPenerima').value;
        var neg = document.getElementById('peb_NegPenerima').value;

        document.getElementById('peb_NamaBeli').value = nm;
        document.getElementById('peb_AlmtBeli').value = al;
        document.getElementById('peb_NegBeli').value = neg;
        DoIt.toast('Data Pembeli disalin dari Penerima', 'success');
        DoIt.validateAllPebTabs();
    };

    DoIt.fillPebSampleData = async function() {
        var tabNames = ['Header', 'Entitas', 'Dokumen', 'Pengangkut', 'Kemasan & Peti', 'Transaksi', 'Detail Barang', 'Pungutan', 'Pernyataan'];
        var activeTabName = tabNames[currentTab - 1] || ('Tab ' + currentTab);
        var confirmed = await DoIt.confirm(
            'Isi sample data CEISA 4.0 (BC 3.0) untuk Tab ' + currentTab + ' – ' + activeTabName + '?',
            'Konfirmasi Isi Sample Data'
        );
        if (!confirmed) return;

        switch (currentTab) {
            case 1:
                if (document.getElementById('peb_Car')) document.getElementById('peb_Car').value = '000030LA7820202511220000337';
                if (document.getElementById('peb_KdKtrPemuatan')) document.getElementById('peb_KdKtrPemuatan').value = '010300 - CUKAI DUMAI, SUMATERA UTARA';
                if (document.getElementById('peb_PelMuat')) document.getElementById('peb_PelMuat').value = 'IDDUM - DUMAI';
                if (document.getElementById('peb_KdKtr')) document.getElementById('peb_KdKtr').value = '010300 - CUKAI DUMAI';
                if (document.getElementById('peb_JnEks')) document.getElementById('peb_JnEks').value = '1';
                if (document.getElementById('peb_KatEks')) document.getElementById('peb_KatEks').value = '25';
                if (document.getElementById('peb_CaraBayar')) document.getElementById('peb_CaraBayar').value = '1';
                if (document.getElementById('peb_Komoditi')) document.getElementById('peb_Komoditi').value = '2';
                if (document.getElementById('peb_BarangKiriman')) document.getElementById('peb_BarangKiriman').value = '0';
                break;
            case 2:
                if (document.getElementById('peb_NpwpEks')) document.getElementById('peb_NpwpEks').value = '00174392740460000';
                if (document.getElementById('peb_NitkuEks')) document.getElementById('peb_NitkuEks').value = '0017439274046000000000';
                if (document.getElementById('peb_NamaEks')) document.getElementById('peb_NamaEks').value = 'ELECTRONIC DATA INTERCHANGE INDONESIA';
                if (document.getElementById('peb_AlmtEks')) document.getElementById('peb_AlmtEks').value = 'WISMA SMR LANTAI 3 UNIT 02, JL YOS SUDARSO KAV. 89 009/011';
                if (document.getElementById('peb_StatusEks')) document.getElementById('peb_StatusEks').value = 'BUMN';
                if (document.getElementById('peb_NamaPenerima')) document.getElementById('peb_NamaPenerima').value = 'SUZUKI MOTOR CORPORATION JAPAN';
                if (document.getElementById('peb_AlmtPenerima')) document.getElementById('peb_AlmtPenerima').value = '300 TAKATSUKA-CHO, MINAMI-KU, HAMAMATSU-SHI, SHIZUOKA';
                if (document.getElementById('peb_NegPenerima')) document.getElementById('peb_NegPenerima').value = 'JP - JAPAN';
                if (document.getElementById('peb_NamaBeli')) document.getElementById('peb_NamaBeli').value = 'SUZUKI MOTOR CORPORATION JAPAN';
                if (document.getElementById('peb_AlmtBeli')) document.getElementById('peb_AlmtBeli').value = '300 TAKATSUKA-CHO, MINAMI-KU, HAMAMATSU-SHI, SHIZUOKA';
                if (document.getElementById('peb_NegBeli')) document.getElementById('peb_NegBeli').value = 'JP - JAPAN';
                if (document.getElementById('peb_KatKonsolidasi')) document.getElementById('peb_KatKonsolidasi').value = 'KONSOLIDATOR';
                if (document.getElementById('peb_NpwpKonsolidasi')) document.getElementById('peb_NpwpKonsolidasi').value = '4422354243424334';
                if (document.getElementById('peb_NamaKonsolidasi')) document.getElementById('peb_NamaKonsolidasi').value = 'ARUBI';
                if (document.getElementById('peb_AlmtKonsolidasi')) document.getElementById('peb_AlmtKonsolidasi').value = 'JAKARTA TIMUR';
                break;
            case 3:
                var docKd = document.querySelector('#pebDocRows [name="DocKd[]"]'); if (docKd) docKd.value = '380';
                var docNo = document.querySelector('#pebDocRows [name="DocNo[]"]'); if (docNo) docNo.value = 'EXP-INV-20251122';
                var docTg = document.querySelector('#pebDocRows [name="DocTg[]"]'); if (docTg) docTg.value = '22-11-2025';
                break;
            case 4:
                if (document.getElementById('peb_Tps')) document.getElementById('peb_Tps').value = 'TPSDUM - TPS DUMAI';
                if (document.getElementById('peb_LokasiPeriksa')) document.getElementById('peb_LokasiPeriksa').value = 'GUDANG EKSPORTIR';
                if (document.getElementById('peb_TglPeriksa')) document.getElementById('peb_TglPeriksa').value = '22-11-2025';
                if (document.getElementById('peb_PelMuatAsal')) document.getElementById('peb_PelMuatAsal').value = 'IDDUM - DUMAI';
                if (document.getElementById('peb_PelMuatEkspor')) document.getElementById('peb_PelMuatEkspor').value = 'IDDUM - DUMAI';
                if (document.getElementById('peb_PelBongkar')) document.getElementById('peb_PelBongkar').value = 'JPTYO - TOKYO';
                if (document.getElementById('peb_Carrier')) document.getElementById('peb_Carrier').value = 'MV SUZUKI EXPRESS';
                break;
            case 5:
                var kmsJml = document.querySelector('[name="KmsJml"]'); if (kmsJml) kmsJml.value = '10';
                var kmsJns = document.querySelector('[name="KmsJns"]'); if (kmsJns) kmsJns.value = 'PX';
                var kmsMerk = document.querySelector('[name="KmsMerk"]'); if (kmsMerk) kmsMerk.value = 'SUZUKI EXPORT BOX';
                break;
            case 6:
                if (document.getElementById('peb_KdVal')) document.getElementById('peb_KdVal').value = 'USD';
                if (document.getElementById('peb_Ndpbm')) document.getElementById('peb_Ndpbm').value = '17,527.0000';
                if (document.getElementById('peb_CaraPenyerahan')) document.getElementById('peb_CaraPenyerahan').value = 'EXW';
                if (document.getElementById('peb_Fob')) document.getElementById('peb_Fob').value = '150000.00';
                if (document.getElementById('peb_Freight')) document.getElementById('peb_Freight').value = '100.00';
                if (document.getElementById('peb_Asuransi')) document.getElementById('peb_Asuransi').value = 'DALAM NEGERI 100.0000';
                if (document.getElementById('peb_Bruto')) document.getElementById('peb_Bruto').value = '100.0000';
                if (document.getElementById('peb_Netto')) document.getElementById('peb_Netto').value = '95.00';
                break;
            case 7:
                var brgHs = document.querySelector('#pebBarangRows [name="BrgHs[]"]'); if (brgHs) brgHs.value = '87032110';
                var brgDesc = document.querySelector('#pebBarangRows [name="BrgDesc[]"]'); if (brgDesc) brgDesc.value = 'SUZUKI AUTOMOBILE PASSENGER CAR';
                var brgFob = document.querySelector('#pebBarangRows [name="BrgFob[]"]'); if (brgFob) brgFob.value = '150000.00';
                var brgQty = document.querySelector('#pebBarangRows [name="BrgQty[]"]'); if (brgQty) brgQty.value = '1';
                var brgSat = document.querySelector('#pebBarangRows [name="BrgSat[]"]'); if (brgSat) brgSat.value = 'UNT - Unit';
                break;
            case 8:
                if (document.getElementById('peb_KodeBank')) document.getElementById('peb_KodeBank').value = '008';
                if (document.getElementById('peb_NoNtpn')) document.getElementById('peb_NoNtpn').value = '0820263009918273';
                if (document.getElementById('peb_StatusBayar')) document.getElementById('peb_StatusBayar').value = 'LUNAS';
                if (document.getElementById('peb_NilaiBeaKeluar')) document.getElementById('peb_NilaiBeaKeluar').value = '0';
                if (document.getElementById('peb_NilaiPnbpEks')) document.getElementById('peb_NilaiPnbpEks').value = '50000';
                DoIt.recalcPebPungutan();
                break;
            case 9:
                if (document.getElementById('peb_TempatPernyataan')) document.getElementById('peb_TempatPernyataan').value = 'DUMAI';
                if (document.getElementById('peb_TglPernyataan')) document.getElementById('peb_TglPernyataan').value = '22-11-2025';
                if (document.getElementById('peb_NamaPernyataan')) document.getElementById('peb_NamaPernyataan').value = 'SUZUKI EXPORT LOGISTICS';
                if (document.getElementById('peb_JabatanPernyataan')) document.getElementById('peb_JabatanPernyataan').value = 'HEAD OF EXPORT';
                break;
        }

        // Tandai semua field di tab aktif sebagai touched
        var curPanel = document.getElementById('pebPanel' + currentTab);
        if (curPanel) {
            curPanel.querySelectorAll('input, select, textarea').forEach(function(el) {
                el.dataset.touched = 'true';
            });
        }
        document.querySelector('.peb-tab[data-tab="' + currentTab + '"]').dataset.touched = 'true';

        DoIt.toast('Sample data Tab ' + currentTab + ' (' + activeTabName + ') berhasil diisikan!', 'success');
        DoIt.validateAllPebTabs();
    };

    DoIt.recalcPebPungutan = function() {
        var bk = parseFloat(document.getElementById('peb_NilaiBeaKeluar')?.value || 0);
        var pnbp = parseFloat(document.getElementById('peb_NilaiPnbpEks')?.value || 0);
        var total = bk + pnbp;
        var displayEl = document.getElementById('peb_TotalPungutanDisplay');
        if (displayEl) {
            displayEl.value = 'Rp ' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    };

    DoIt.addPebDocRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 60px 180px 1fr 140px 40px; gap:10px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="DocKd[]" class="form-control"><option value="380">380 - INVOICE</option><option value="217">217 - PACKING LIST</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocNo[]" class="form-control req-field" placeholder="Nomor dokumen" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocTg[]" class="form-control" placeholder="DD-MM-YYYY" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPebTabs()">&times;</button>'
            + '</div>';
        document.getElementById('pebDocRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPebTabs();
    };

    DoIt.addPebBarangRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 50px 130px 1fr 110px 110px 110px 40px; gap:8px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgHs[]" class="form-control req-field" placeholder="87032110" maxlength="10" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgDesc[]" class="form-control req-field" placeholder="Uraian barang ekspor" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgFob[]" class="form-control" placeholder="0.00" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgQty[]" class="form-control req-field" placeholder="0" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgSat[]" class="form-control" placeholder="UNT - Unit" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPebTabs()">&times;</button>'
            + '</div>';
        document.getElementById('pebBarangRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPebTabs();
    };

    document.addEventListener('DOMContentLoaded', function() {
        // Reset semua nilai field agar tidak terisi oleh browser autocomplete
        document.querySelectorAll('#pebForm input[type="text"], #pebForm input[type="number"], #pebForm textarea').forEach(function(el) {
            el.value = '';
            el.removeAttribute('data-touched');
        });
        document.querySelectorAll('#pebForm select').forEach(function(el) {
            var firstEmpty = el.querySelector('option[value=""]');
            if (firstEmpty) el.value = '';
            el.removeAttribute('data-touched');
        });
        document.querySelectorAll('.peb-tab').forEach(function(btn) {
            btn.removeAttribute('data-touched');
        });

        // Pasang event listener
        document.querySelectorAll('#pebForm input, #pebForm select, #pebForm textarea').forEach(function(el) {
            el.addEventListener('input', function() {
                el.dataset.touched = 'true';
                var tabId = el.closest('.peb-panel')?.id?.replace('pebPanel', '');
                if (tabId) {
                    var btn = document.querySelector('.peb-tab[data-tab="' + tabId + '"]');
                    if (btn) btn.dataset.touched = 'true';
                }
                DoIt.validateAllPebTabs();
            });
            el.addEventListener('change', function() {
                el.dataset.touched = 'true';
                DoIt.validateAllPebTabs();
            });
        });

        // Real-time Check Duplicate CAR
        var carInput = document.getElementById('peb_Car');
        var carFeedback = document.getElementById('peb_car_feedback');
        if (carInput && carFeedback) {
            carInput.addEventListener('blur', async function() {
                var carVal = this.value.trim();
                if (!carVal) {
                    carFeedback.style.display = 'none';
                    return;
                }
                try {
                    var res = await fetch('/api/doc-lock/check-car-duplicate?car=' + encodeURIComponent(carVal) + '&docType=PEB');
                    var data = await res.json();
                    if (data.isDuplicate) {
                        carFeedback.style.display = 'block';
                        carFeedback.style.color = '#dc2626';
                        carFeedback.style.fontWeight = '600';
                        carFeedback.innerHTML = '⚠️ ' + data.message;
                        carInput.style.borderColor = '#dc2626';
                        carInput.setCustomValidity(data.message);
                    } else {
                        carFeedback.style.display = 'block';
                        carFeedback.style.color = '#16a34a';
                        carFeedback.style.fontWeight = '600';
                        carFeedback.innerHTML = '✓ Nomor Aju (CAR) tersedia';
                        carInput.style.borderColor = '#16a34a';
                        carInput.setCustomValidity('');
                    }
                } catch (err) {
                    console.error('Error checking CAR duplicate:', err);
                }
            });
        }

        DoIt.validateAllPebTabs();
    });
})();
</script>
}
