@model DoItG2.Models.PEB.PebHeaderModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Edit Dokumen PEB — {Model.Car}";
    ViewData["Breadcrumb"] = $"<a href='/'>Dashboard</a> <span class='breadcrumb-sep'>/</span> <a href='/Peb'>PEB</a> <span class='breadcrumb-sep'>/</span> <a href='/Peb/Detail?id={Model.Car}'>Detail</a> <span class='breadcrumb-sep'>/</span> Edit";
}

<div class="card" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 class="card-title" style="margin: 0; font-size: 18px;">Edit Dokumen PEB — @Model.Car</h2>
            <div class="card-subtitle" style="margin-top: 3px;">Perubahan data Pemberitahuan Ekspor Barang kepabeanan (Audit terintegrasi)</div>
        </div>
        <div style="display: flex; gap: 8px;">
            <a class="btn btn-secondary" href="/Peb/Detail?id=@Model.Car">Lihat Detail</a>
            <a class="btn btn-secondary" href="/Peb">Kembali ke Daftar</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
    {
        var errMsg = ViewData.ModelState[""]!.Errors.Count > 0 ? ViewData.ModelState[""]!.Errors[0].ErrorMessage : "Terjadi kesalahan saat menyimpan data.";
        <div class="alert alert-danger" style="margin-bottom: 20px;">
            @errMsg
        </div>
    }

    <form method="post" asp-controller="Peb" asp-action="Edit" onsubmit="DoIt.showLoading('Menyimpan perubahan dokumen PEB...')">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Car" value="@Model.Car" />
        
        <!-- Identitas Dokumen & Eksportir -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
            <div style="font-size: 13px; font-weight: 700; color: #1e3a8a; margin-bottom: 12px; text-transform: uppercase;">1. Identitas Dokumen &amp; Eksportir</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Nomor CAR (AJU)</label>
                    <input type="text" class="form-control" value="@Model.Car" disabled style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: #e2e8f0; color: #1e293b;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Eksportir</label>
                    <input type="text" class="form-control" value="@(string.IsNullOrEmpty(Model.NamaEks) ? "PT. SUZUKI INDOMOBIL MOTOR" : Model.NamaEks)" disabled style="background: #e2e8f0; color: #1e293b;" />
                </div>
            </div>
        </div>

        <!-- Data Pembeli & Tujuan -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
            <div style="font-size: 13px; font-weight: 700; color: #1e3a8a; margin-bottom: 12px; text-transform: uppercase;">2. Data Pembeli (Buyer) &amp; Tujuan Ekspor</div>
            
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Nama Pembeli (Buyer)<span class="required">*</span></label>
                    <input type="text" name="NamaBeli" class="form-control" value="@Model.NamaBeli" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Negara Pembeli (Kode)<span class="required">*</span></label>
                    <input type="text" name="NegBeli" class="form-control" value="@Model.NegBeli" required maxlength="2" />
                </div>
            </div>

            <div class="form-group" style="margin-top: 10px;">
                <label class="form-label">Alamat Pembeli<span class="required">*</span></label>
                <textarea name="AlmtBeli" class="form-control" rows="2" required>@Model.AlmtBeli</textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 10px;">
                <div class="form-group">
                    <label class="form-label">Tanggal Perkiraan Ekspor<span class="required">*</span></label>
                    <input type="date" name="TgEks" class="form-control" value="@(Model.TgEks?.ToString("yyyy-MM-dd"))" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Pelabuhan Muat</label>
                    <input type="text" name="PelMuat" class="form-control" value="@Model.PelMuat" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pelabuhan Bongkar</label>
                    <input type="text" name="PelBongkar" class="form-control" value="@Model.PelBongkar" />
                </div>
            </div>
        </div>

        <!-- Bobot & Nilai Transaksi -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
            <div style="font-size: 13px; font-weight: 700; color: #1e3a8a; margin-bottom: 12px; text-transform: uppercase;">3. Bobot Barang &amp; Nilai Ekspor (FOB)</div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Berat Bersih (Netto Kg)<span class="required">*</span></label>
                    <input type="number" step="0.01" name="Netto" class="form-control" value="@Model.Netto" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Berat Kotor (Bruto Kg)<span class="required">*</span></label>
                    <input type="number" step="0.01" name="Bruto" class="form-control" value="@Model.Bruto" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Total FOB (USD)<span class="required">*</span></label>
                    <input type="number" step="0.01" name="Fob" class="form-control" value="@Model.Fob" required />
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <a href="/Peb/Detail?id=@Model.Car" class="btn btn-secondary">Batal</a>
            <button type="submit" class="btn btn-primary" style="font-weight: 700;">
                💾 Simpan Perubahan
            </button>
        </div>
    </form>
</div>
