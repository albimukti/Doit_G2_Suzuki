@model List<DoItG2.Models.PEB.PebHeaderModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Daftar PEB (BC 3.0)";
}

<div class="card" style="max-width: 1300px; margin: 0 auto;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #e0f2fe; color: #0369a1; display: flex; align-items: center; justify-content: center; font-size: 22px;">
                🛫
            </div>
            <div>
                <h2 class="card-title" style="margin: 0; font-size: 18px;">Pemberitahuan Ekspor Barang (PEB - BC 3.0)</h2>
                <div class="card-subtitle">Pengelolaan dokumen ekspor kendaraan &amp; spare part, approval internal, dan transmisi NPE CEISA 4.0</div>
            </div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a class="btn btn-secondary" href="/Peb/DownloadTemplate" style="display: flex; align-items: center; gap: 5px;">
                <span>📥</span> Download Template Excel
            </a>
            <a class="btn btn-secondary" href="/Peb/Upload" style="display: flex; align-items: center; gap: 5px;">
                <span>📤</span> Upload Excel
            </a>
            <a class="btn btn-primary" href="/Peb/Create" style="display: flex; align-items: center; gap: 5px;">
                <span>+</span> Buat PEB Baru
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin: 16px 24px 0;">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 16px 24px 0;">✕ @TempData["Error"]</div>
    }

    <div style="padding: 24px;">
        <!-- Filter Bar -->
        <form method="get" style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <input type="text" name="search" class="form-control" placeholder="Cari Nomor CAR, Pembeli, Negara, No NPE..." value="@Context.Request.Query["search"]" />
            </div>
            <div style="width: 170px;">
                <select name="approvalStatus" class="form-control">
                    <option value="">Semua Approval</option>
                    <option value="DRAFT" selected="@(Context.Request.Query["approvalStatus"] == "DRAFT")">DRAFT</option>
                    <option value="PENDING_APPROVAL" selected="@(Context.Request.Query["approvalStatus"] == "PENDING_APPROVAL")">PENDING APPROVAL</option>
                    <option value="APPROVED" selected="@(Context.Request.Query["approvalStatus"] == "APPROVED")">APPROVED</option>
                    <option value="REJECTED" selected="@(Context.Request.Query["approvalStatus"] == "REJECTED")">REJECTED</option>
                    <option value="TRANSMITTED" selected="@(Context.Request.Query["approvalStatus"] == "TRANSMITTED")">TRANSMITTED</option>
                </select>
            </div>
            <div style="width: 160px;">
                <select name="status" class="form-control">
                    <option value="">Semua CEISA</option>
                    <option value="DRAFT" selected="@(Context.Request.Query["status"] == "DRAFT")">DRAFT CEISA</option>
                    <option value="APPROVED" selected="@(Context.Request.Query["status"] == "APPROVED")">NPE TERBIT</option>
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">Filter</button>
            @if (Context.Request.Query.Count > 0)
            {
                <a href="/Peb" class="btn btn-secondary">Reset</a>
            }
        </form>

        <!-- Table Data -->
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nomor CAR (AJU)</th>
                        <th>Pembeli / Penerima</th>
                        <th>Negara</th>
                        <th style="text-align: right;">FOB (@(Model.FirstOrDefault()?.KdVal ?? "USD"))</th>
                        <th style="text-align: right;">Netto (Kg)</th>
                        <th>Nomor NPE</th>
                        <th style="text-align: center;">Approval</th>
                        <th style="text-align: center;">Status CEISA</th>
                        <th style="text-align: center; width: 170px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                Tidak ada dokumen PEB ditemukan. Silakan buat baru atau tarik dari Oracle SILO.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="/Peb/Detail?id=@item.Car" style="font-family: monospace; font-weight: 700; color: #1e3a8a; text-decoration: none;">
                                    @item.Car
                                </a>
                            </td>
                            <td style="font-weight: 600;">@item.NamaBeli</td>
                            <td><span class="badge badge-info">@item.NegBeli</span></td>
                            <td style="text-align: right; font-family: monospace; font-size: 13px; font-weight: 700; color: #0f172a;">
                                $@item.Fob.ToString("N2")
                            </td>
                            <td style="text-align: right; font-family: monospace; font-size: 13px;">
                                @item.Netto.ToString("N2")
                            </td>
                            <td style="font-size: 12px;">
                                @if (!string.IsNullOrEmpty(item.Nopen))
                                {
                                    <span style="color: #059669; font-weight: 700;">NPE: @item.Nopen</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">-</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (item.ApprovalStatus == "APPROVED")
                                {
                                    <span class="badge badge-success">APPROVED</span>
                                }
                                else if (item.ApprovalStatus == "PENDING_APPROVAL")
                                {
                                    <span class="badge badge-warning">PENDING</span>
                                }
                                else if (item.ApprovalStatus == "REJECTED")
                                {
                                    <span class="badge badge-danger">REVISI</span>
                                }
                                else if (item.ApprovalStatus == "TRANSMITTED")
                                {
                                    <span class="badge badge-primary">TRANSMITTED</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (item.Status == "APPROVED" || !string.IsNullOrEmpty(item.Nopen))
                                {
                                    <span class="badge badge-success">NPE TERBIT</span>
                                }
                                else if (item.Status == "SENT")
                                {
                                    <span class="badge badge-sent">SENT</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; justify-content: center; gap: 4px;">
                                    <a href="/Peb/Detail?id=@item.Car" class="btn btn-sm btn-primary" title="Lihat Detail & Review">
                                        Detail
                                    </a>
                                    <a href="/Peb/PrintPdf?id=@item.Car" target="_blank" class="btn btn-sm btn-secondary" title="Cetak Dokumen PDF BC 3.0">
                                        PDF
                                    </a>
                                    <a href="/Ceisa/Tracking?car=@item.Car&type=PEB" class="btn btn-sm btn-secondary" title="Tracking CEISA 4.0">
                                        🛰️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
