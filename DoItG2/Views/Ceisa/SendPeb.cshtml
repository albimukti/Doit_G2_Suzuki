@model List<DoItG2.Models.PEB.PebHeaderModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Transmisi PEB ke CEISA 4.0";
}

<div class="card" style="max-width: 1200px; margin: 0 auto;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #e0f2fe; color: #0369a1; display: flex; align-items: center; justify-content: center; font-size: 22px;">
                🛫
            </div>
            <div>
                <h2 class="card-title" style="margin: 0; font-size: 18px;">Transmisi Dokumen PEB ke CEISA 4.0</h2>
                <div class="card-subtitle">Pengiriman data ekspor kendaraan &amp; spare part Suzuki ke REST API Bea Cukai (NPE)</div>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="/Peb" class="btn btn-secondary">
                Kembali ke Daftar PEB
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin: 16px 24px 0;">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 16px 24px 0;">✕ @TempData["Error"]</div>
    }

    <div style="padding: 24px;">
        <!-- CEISA Gateway Status Badge -->
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #22c55e; display: inline-block; box-shadow: 0 0 8px #22c55e;"></span>
                <span style="font-size: 13px; font-weight: 600; color: #166534;">CEISA 4.0 Ekspor Gateway Connected (Eksportir: PT. Suzuki Indomobil Motor)</span>
            </div>
            <span class="badge badge-success">API READY</span>
        </div>

        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nomor CAR (AJU)</th>
                        <th>Pembeli / Negara</th>
                        <th>Nilai FOB</th>
                        <th style="text-align: center;">Approval Status</th>
                        <th style="text-align: center;">Status CEISA</th>
                        <th style="text-align: center; width: 220px;">Aksi Transmisi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                Tidak ada dokumen PEB yang siap ditransmisikan.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var isApproved = item.ApprovalStatus == "APPROVED";
                        var isTransmitted = item.Status == "APPROVED" || !string.IsNullOrEmpty(item.Nopen);
                        <tr>
                            <td>
                                <a href="/Peb/Detail?id=@item.Car" style="font-family: monospace; font-weight: 700; color: #1e3a8a; text-decoration: none;">
                                    @item.Car
                                </a>
                            </td>
                            <td style="font-weight: 600;">@item.NamaBeli (@item.NegBeli)</td>
                            <td style="font-family: monospace;">$@item.Fob.ToString("N2")</td>
                            <td style="text-align: center;">
                                @if (isApproved)
                                {
                                    <span class="badge badge-success">APPROVED</span>
                                }
                                else if (item.ApprovalStatus == "PENDING_APPROVAL")
                                {
                                    <span class="badge badge-warning">MENUNGGU APPROVAL</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (isTransmitted)
                                {
                                    <span class="badge badge-success">NPE TERBIT</span>
                                }
                                else if (item.Status == "SENT")
                                {
                                    <span class="badge badge-sent">SENT</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">BELUM DIKIRIM</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; justify-content: center; gap: 6px;">
                                    @if (!isTransmitted)
                                    {
                                        <form method="post" action="/Ceisa/TransmitPeb" onsubmit="DoIt.showLoading('Mengirim PEB ke CEISA 4.0...')">
                                            <input type="hidden" name="car" value="@item.Car" />
                                            <button type="submit" class="btn btn-sm btn-primary" style="font-weight: 700;">
                                                🚀 Kirim CEISA
                                            </button>
                                        </form>
                                    }
                                    <a href="/Ceisa/Tracking?car=@item.Car&type=PEB" class="btn btn-sm btn-secondary" title="Tracking Timeline">
                                        🛰️ Tracking
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
