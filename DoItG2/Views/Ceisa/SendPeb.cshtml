@model DoItG2.Models.CEISA.CeisaSendPebViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Transmisi PEB ke CEISA 4.0";
    var activeTab = Model.ActiveTab;
}

<style>
    .ceisa-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }
    .ceisa-stat-card {
        background: var(--bg-card, #ffffff);
        border: 1px solid var(--border-color, #e2e8f0);
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: border-color 0.15s ease;
        text-decoration: none;
        color: inherit;
    }
    .ceisa-stat-card:hover {
        border-color: #cbd5e1;
    }
    .ceisa-stat-val {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-primary, #0f172a);
        line-height: 1.1;
        font-family: 'JetBrains Mono', monospace;
    }
    .ceisa-stat-lbl {
        font-size: 11.5px;
        color: var(--text-muted, #64748b);
        font-weight: 600;
        margin-top: 3px;
    }

    .ceisa-tabs-bar {
        display: flex;
        gap: 6px;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
        margin-bottom: 16px;
        overflow-x: auto;
    }
    .ceisa-tab-item {
        padding: 9px 14px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-muted, #64748b);
        text-decoration: none;
        border-radius: 6px 6px 0 0;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: all 0.15s ease;
    }
    .ceisa-tab-item:hover {
        color: var(--text-primary, #0f172a);
    }
    .ceisa-tab-item.active {
        color: #1e40af;
        border-bottom-color: #1e40af;
        font-weight: 700;
        background: #f8fafc;
    }
    .ceisa-tab-badge {
        padding: 1px 6px;
        border-radius: 6px;
        font-size: 10.5px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
    }

    .error-detail-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 11px;
        color: #991b1b;
        margin-top: 5px;
        line-height: 1.35;
        text-align: left;
    }
</style>

<div class="card" style="max-width: 1300px; margin: 0 auto;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div>
            <h2 class="card-title" style="margin: 0; font-size: 18px; font-weight: 700;">Transmisi PEB ke CEISA 4.0</h2>
            <div class="card-subtitle" style="font-size: 12px; margin-top: 2px;">
                Pengiriman Dokumen Pabean Ekspor (BC 3.0) ke REST API Bea Cukai
            </div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="/Peb/Create" class="btn btn-primary">
                + Buat PEB Baru
            </a>
            <a href="/Peb" class="btn btn-secondary">
                Daftar PEB
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin: 16px 24px 0;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 16px 24px 0;">@TempData["Error"]</div>
    }

    <div style="padding: 20px 24px;">
        <!-- CEISA Gateway Status Bar -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px 16px; border-radius: 8px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #16a34a; display: inline-block;"></span>
                <span style="font-size: 12px; font-weight: 600; color: #1e293b;">
                    Gateway: <span style="font-family: monospace; color: #1e40af;">api.beacukai.go.id (v4.0 REST)</span>
                </span>
                <span style="color: #cbd5e1;">|</span>
                <span style="font-size: 12px; color: #64748b;">
                    Entitas: <strong>@(User.FindFirst("Entity")?.Value ?? "SIM")</strong> (NPWP: @(User.FindFirst("EntityNpwp")?.Value ?? "01.129.737.1-411.000"))
                </span>
            </div>
            <span class="badge badge-success" style="font-size: 10px; font-weight: 700;">SANDBOX CONNECTED</span>
        </div>

        <!-- Summary Statistics Grid -->
        <div class="ceisa-stats-grid">
            <a href="?tab=queue" class="ceisa-stat-card" style="@(activeTab == "queue" ? "border-color: #1e40af; background: #f8fafc;" : "")">
                <div>
                    <div class="ceisa-stat-val">@Model.QueueCount</div>
                    <div class="ceisa-stat-lbl">Antrean Belum Kirim</div>
                </div>
            </a>
            <a href="?tab=ready" class="ceisa-stat-card" style="@(activeTab == "ready" ? "border-color: #16a34a; background: #f8fafc;" : "")">
                <div>
                    <div class="ceisa-stat-val" style="color: #16a34a;">@Model.ReadyCount</div>
                    <div class="ceisa-stat-lbl">Siap Transmisi</div>
                </div>
            </a>
            <a href="?tab=failed" class="ceisa-stat-card" style="@(activeTab == "failed" ? "border-color: #dc2626; background: #f8fafc;" : "")">
                <div>
                    <div class="ceisa-stat-val" style="color: #dc2626;">@Model.FailedCount</div>
                    <div class="ceisa-stat-lbl">Gagal / Perlu Koreksi</div>
                </div>
            </a>
            <a href="?tab=pending" class="ceisa-stat-card" style="@(activeTab == "pending" ? "border-color: #d97706; background: #f8fafc;" : "")">
                <div>
                    <div class="ceisa-stat-val" style="color: #d97706;">@Model.PendingCount</div>
                    <div class="ceisa-stat-lbl">Menunggu Approval</div>
                </div>
            </a>
            <a href="?tab=history" class="ceisa-stat-card" style="@(activeTab == "history" ? "border-color: #4f46e5; background: #f8fafc;" : "")">
                <div>
                    <div class="ceisa-stat-val" style="color: #4f46e5;">@Model.HistoryCount</div>
                    <div class="ceisa-stat-lbl">Berhasil Terkirim</div>
                </div>
            </a>
        </div>

        <!-- Interactive Tabs Bar -->
        <div class="ceisa-tabs-bar">
            <a href="?tab=queue" class="ceisa-tab-item @(activeTab == "queue" ? "active" : "")">
                <span>Antrean Transmisi</span>
                <span class="ceisa-tab-badge" style="background: #e2e8f0; color: #334155;">@Model.QueueCount</span>
            </a>
            <a href="?tab=ready" class="ceisa-tab-item @(activeTab == "ready" ? "active" : "")">
                <span>Siap Transmisi</span>
                <span class="ceisa-tab-badge" style="background: #dcfce7; color: #166534;">@Model.ReadyCount</span>
            </a>
            <a href="?tab=failed" class="ceisa-tab-item @(activeTab == "failed" ? "active" : "")">
                <span>Gagal / Terkendala</span>
                <span class="ceisa-tab-badge" style="background: #fee2e2; color: #991b1b;">@Model.FailedCount</span>
            </a>
            <a href="?tab=pending" class="ceisa-tab-item @(activeTab == "pending" ? "active" : "")">
                <span>Menunggu Approval</span>
                <span class="ceisa-tab-badge" style="background: #fef3c7; color: #92400e;">@Model.PendingCount</span>
            </a>
            <a href="?tab=history" class="ceisa-tab-item @(activeTab == "history" ? "active" : "")">
                <span>Riwayat Berhasil</span>
                <span class="ceisa-tab-badge" style="background: #e0e7ff; color: #3730a3;">@Model.HistoryCount</span>
            </a>
        </div>

        <!-- Table Content -->
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 170px;">Nomor CAR (AJU)</th>
                        <th>Pembeli &amp; Negara Tujuan</th>
                        <th style="width: 140px;">Nilai FOB</th>
                        <th style="text-align: center; width: 200px;">Status Alur</th>
                        <th style="text-align: center; width: 170px;">Status CEISA</th>
                        <th style="text-align: center; width: 210px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px 20px; color: var(--text-muted);">
                                <div style="font-size: 13.5px; font-weight: 600; color: var(--text-primary);">
                                    @(activeTab == "history" ? "Belum ada dokumen yang terkirim." :
                                      (activeTab == "failed" ? "Tidak ada dokumen yang gagal transmisi." :
                                      (activeTab == "ready" ? "Tidak ada dokumen yang siap dikirim saat ini." :
                                      "Tidak ada dokumen dalam antrean pengiriman.")))
                                </div>
                                <div style="font-size: 12px; margin-top: 3px; color: var(--text-muted);">
                                    Dokumen yang telah sukses terkirim otomatis berpindah ke tab 'Riwayat Berhasil'.
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var isApproved = item.ApprovalStatus == "APPROVED";
                        var isFailed = item.ApprovalStatus == "FAILED" || item.ApprovalStatus == "REJECTED";
                        var isPending = item.ApprovalStatus == "PENDING_APPROVAL" || item.ApprovalStatus == "PENDING";
                        var isTransmitted = item.ApprovalStatus == "TRANSMITTED" || item.Status == "APPROVED" || !string.IsNullOrWhiteSpace(item.Nopen);

                        <tr>
                            <td>
                                <a href="/Peb/Detail?id=@item.Car" style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #1e40af; text-decoration: none; font-size: 12.5px;">
                                    @item.Car
                                </a>
                                <div style="font-size: 10.5px; color: var(--text-muted); margin-top: 2px;">
                                    Netto: @item.Netto.ToString("N2") Kg
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary); font-size: 13px;">@item.NamaBeli</div>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                    Negara: <span class="badge badge-info" style="font-size: 10px; padding: 1px 6px;">@item.NegBeli</span>
                                </div>
                            </td>
                            <td style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600;">
                                $@item.Fob.ToString("N2")
                            </td>
                            <td style="text-align: center;">
                                @if (isTransmitted)
                                {
                                    <span class="badge badge-sent" style="font-weight: 700;">TERKIRIM</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge badge-success" style="font-weight: 700;">SIAP TRANSMISI</span>
                                }
                                else if (isFailed)
                                {
                                    <span class="badge badge-danger" style="font-weight: 700;">GAGAL TRANSMISI</span>
                                    @if (!string.IsNullOrWhiteSpace(item.ReviewNotes))
                                    {
                                        <div class="error-detail-box" title="@item.ReviewNotes">
                                            @item.ReviewNotes
                                        </div>
                                    }
                                }
                                else if (isPending)
                                {
                                    <span class="badge badge-warning" style="font-weight: 700;">MENUNGGU APPROVAL</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="font-weight: 700;">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (item.Status == "APPROVED" || !string.IsNullOrWhiteSpace(item.Nopen))
                                {
                                    <span class="badge badge-success" style="font-weight: 700;">
                                        NPE: @(string.IsNullOrEmpty(item.Nopen) ? "TERBIT" : item.Nopen)
                                    </span>
                                }
                                else if (isFailed)
                                {
                                    <span class="badge badge-danger" style="font-weight: 700;">TERKENDALA</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge badge-success" style="font-weight: 600;">SIAP KIRIM</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">BELUM DIKIRIM</span>
                                }
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <div style="display: inline-flex; justify-content: center; align-items: center; gap: 5px; flex-wrap: nowrap;">
                                    @if (isApproved)
                                    {
                                        <form method="post" action="/Ceisa/TransmitPeb" onsubmit="DoIt.showLoading('Mengirim ke CEISA 4.0...')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="car" value="@item.Car" />
                                            <button type="submit" class="btn btn-sm btn-primary" style="padding: 4px 9px; font-size: 11px; font-weight: 700;">
                                                Kirim CEISA
                                            </button>
                                        </form>
                                    }
                                    else if (isFailed)
                                    {
                                        <form method="post" action="/Ceisa/TransmitPeb" onsubmit="DoIt.showLoading('Mencoba transmisi ulang...')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="car" value="@item.Car" />
                                            <button type="submit" class="btn btn-sm btn-warning" style="padding: 4px 9px; font-size: 11px; font-weight: 700;" title="Coba Kirim Ulang">
                                                Coba Lagi
                                            </button>
                                        </form>
                                        <a href="/Peb/Edit?id=@item.Car" class="btn btn-sm btn-secondary" style="padding: 4px 9px; font-size: 11px;">
                                            Edit
                                        </a>
                                    }
                                    else if (isPending)
                                    {
                                        <a href="/Peb/Detail?id=@item.Car" class="btn btn-sm btn-secondary" style="padding: 4px 9px; font-size: 11px; font-weight: 600;">
                                            Review
                                        </a>
                                    }
                                    else if (isTransmitted)
                                    {
                                        <a href="/Peb/Detail?id=@item.Car" class="btn btn-sm btn-success" style="padding: 4px 9px; font-size: 11px; font-weight: 700;">
                                            Lihat NPE
                                        </a>
                                    }

                                    <a href="/Ceisa/Tracking?car=@item.Car&type=PEB" class="btn btn-sm btn-secondary" style="padding: 4px 9px; font-size: 11px;" title="Tracking Status">
                                        Tracking
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
