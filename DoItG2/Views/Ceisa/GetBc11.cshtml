@{
    Layout = "_Layout";
    ViewData["Title"] = "Tarik Data BC 1.1 (Manifes CEISA 4.0)";
}

<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(16,185,129,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Tarik Data Manifes BC 1.1 dari CEISA 4.0</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Pengambilan data manifes kapal/pesawat (Nomor BC 1.1, Tanggal BC 1.1, Pelabuhan Asal &amp; Bongkar) langsung dari API CEISA Bea Cukai</p>
            </div>
        </div>
    </div>
</div>

<div class="glass-card" style="max-width: 680px; margin: 0 auto; padding: 24px;">
    <h3 style="font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px;">Sync Data Manifes Kedatangan Barang</h3>
    <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 20px;">Masukkan Nomor CAR Dokumen PIB dan Nomor BC 1.1 resmi untuk memperbarui data pengangkutan pada dokumen pabean.</p>

    <form method="post" action="/Ceisa/ProcessGetBc11">
        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Nomor CAR Dokumen PIB <span class="required">*</span></label>
            <input type="text" name="carNo" class="form-control" placeholder="Contoh: 00003001062620260714902144" required style="font-family: 'JetBrains Mono', monospace; height: 42px;" />
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 14px; margin-bottom: 16px;">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Nomor BC 1.1 (Manifes) <span class="required">*</span></label>
                <input type="text" name="noBc11" class="form-control" placeholder="Contoh: 001284" required style="font-family: 'JetBrains Mono', monospace; height: 42px;" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Tanggal BC 1.1</label>
                <input type="date" name="tglBc11" class="form-control" style="height: 42px;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 24px;">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Pelabuhan Asal (Muat)</label>
                <input type="text" name="pelMuat" class="form-control" value="JPTYO - TOKYO, JAPAN" style="height: 42px;" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Pelabuhan Bongkar</label>
                <input type="text" name="pelBongkar" class="form-control" value="IDTPP - TANJUNG PRIOK" style="height: 42px;" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; height: 44px; font-size: 14px; font-weight: 700;">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"/></svg>
            Tarik Data BC 1.1 dari CEISA 4.0
        </button>
    </form>
</div>
