@model List<DoItG2.Models.Auth.UserModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manajemen Pengguna";
    int activeCount = Model.Count(u => u.IsActive);
}

<!-- Hero Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(16,185,129,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Manajemen Pengguna &amp; Hak Akses</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Pengelolaan 3 Role Utama: Staf Ekspor-Impor, Admin Dokumen, &amp; Manajer Operasional</p>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
            <div style="background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.18); border-radius: var(--border-radius-sm); padding: 7px 14px; text-align: center;">
                <div style="font-size: 18px; font-weight: 800; color: var(--accent-primary); letter-spacing: -0.3px;">@Model.Count</div>
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total User</div>
            </div>
            <div style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.18); border-radius: var(--border-radius-sm); padding: 7px 14px; text-align: center;">
                <div style="font-size: 18px; font-weight: 800; color: var(--accent-success); letter-spacing: -0.3px;">@activeCount</div>
                <div style="font-size: 10px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Aktif</div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px;">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px;">✕ @TempData["Error"]</div>
}

<div class="user-management-grid">

    <!-- Left: User Table -->
    <div class="glass-card" style="padding: 0; overflow: hidden;">
        <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
            <div style="font-size: 14px; font-weight: 700; color: var(--text-primary);">Daftar Pengguna Terdaftar</div>
            <span style="font-size: 11px; color: var(--text-muted); background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 3px 10px; border-radius: 20px;">@Model.Count akun</span>
        </div>
        <div class="table-wrapper" style="border: none; border-radius: 0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Pengguna</th>
                        <th>Nama Lengkap</th>
                        <th>Email</th>
                        <th>Role Resmi</th>
                        <th>Status</th>
                        <th style="text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 48px; color: var(--text-muted);">
                                <div style="font-size: 28px; margin-bottom: 8px; opacity: 0.4;">👤</div>
                                <div style="font-size: 13px; font-weight: 500;">Belum ada pengguna terdaftar</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var roleDisplay = user.UserType switch {
                                "ADMIN_DOKUMEN" or "ADMIN" => ("Admin Dokumen", "rgba(239,68,68,0.12)", "#dc2626", "Pengelolaan arsip digital"),
                                "MANAJER_OPS" or "SUPERVISOR" or "MANAGER" => ("Manajer Operasional", "rgba(59,130,246,0.12)", "#2563eb", "Monitoring & keputusan strategis"),
                                _ => ("Staf Ekspor-Impor", "rgba(16,185,129,0.12)", "#059669", "Operator input/pengiriman")
                            };
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex-shrink: 0; box-shadow: 0 3px 8px var(--accent-primary-glow);">
                                            @(string.IsNullOrEmpty(user.UserName) ? "U" : user.UserName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="code-badge" style="font-size: 11.5px;">@user.UserName</span>
                                    </div>
                                </td>
                                <td style="font-weight: 600; color: var(--text-primary); font-size: 13px;">@user.FullName</td>
                                <td style="font-size: 12px; color: var(--text-secondary);">@(string.IsNullOrEmpty(user.Email) ? "—" : user.Email)</td>
                                <td>
                                    <div>
                                        <span style="font-size: 11px; font-weight: 700; background: @roleDisplay.Item2; color: @roleDisplay.Item3; padding: 3px 9px; border-radius: 6px; display: inline-flex; align-items: center;">
                                            @roleDisplay.Item1
                                        </span>
                                        <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">@roleDisplay.Item4</div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-approved">
                                            <span class="status-dot active" style="width: 6px; height: 6px;"></span>
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-rejected">Non-Aktif</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (user.IsActive && user.UserName != "admin" && user.UserName != User.Identity?.Name)
                                    {
                                        <form method="post" action="/User/Deactivate" style="display: inline;">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Nonaktifkan pengguna @user.UserName?')" style="padding: 4px 10px; font-size: 11px;">
                                                Nonaktifkan
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-size: 12px;">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right: Add User Form -->
    <div class="glass-card card-shine" style="padding: 22px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border-color);">
            <div style="width: 34px; height: 34px; border-radius: 9px; background: rgba(16,185,129,0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-success);">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            </div>
            <h3 style="font-size: 14.5px; font-weight: 700; color: var(--text-primary); margin: 0;">Tambah Pengguna Baru</h3>
        </div>

        <form method="post" action="/User/Create">
            <div class="form-group">
                <label class="form-label">Username <span class="required">*</span></label>
                <input type="text" name="username" class="form-control" placeholder="Contoh: budi.santoso" required style="font-family: 'JetBrains Mono', monospace;" />
            </div>
            <div class="form-group">
                <label class="form-label">Nama Lengkap <span class="required">*</span></label>
                <input type="text" name="fullname" class="form-control" placeholder="Contoh: Budi Santoso" required />
            </div>
            <div class="form-group">
                <label class="form-label">Email Perusahaan <span class="required">*</span></label>
                <input type="email" name="email" class="form-control" placeholder="Contoh: budi@suzuki.co.id" required />
            </div>
            <div class="form-group">
                <label class="form-label">Role Pengguna <span class="required">*</span></label>
                <select name="role" class="form-control" required style="font-size: 13px;">
                    <option value="STAFF_EXIM">Staf ekspor-impor (operator input/pengiriman)</option>
                    <option value="ADMIN_DOKUMEN">Admin dokumen (pengelolaan arsip digital)</option>
                    <option value="MANAJER_OPS">Manajer operasional (monitoring &amp; keputusan strategis)</option>
                </select>
            </div>

            <div style="background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.15); border-radius: var(--border-radius-sm); padding: 12px 14px; margin-bottom: 20px; display: flex; align-items: flex-start; gap: 10px;">
                <svg width="16" height="16" fill="none" stroke="var(--accent-primary)" viewBox="0 0 24 24" style="flex-shrink: 0; margin-top: 2px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <div style="font-size: 11.5px; color: var(--text-secondary); line-height: 1.5;">Password default untuk pengguna baru: <span class="code-badge" style="font-size: 11px;">Admin@123</span></div>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 11px; font-size: 13.5px; font-weight: 700; letter-spacing: 0.2px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                Simpan Pengguna Baru
            </button>
        </form>
    </div>
</div>
