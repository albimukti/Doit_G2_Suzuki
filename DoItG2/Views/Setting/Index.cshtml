@model List<dynamic>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pengaturan Sistem";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-24" style="display: flex; align-items: center; gap: 10px;">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span style="font-weight: 500;">@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-24" style="display: flex; align-items: center; gap: 10px;">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span style="font-weight: 500;">@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Page Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.15)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Pengaturan Sistem Global</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Kelola parameter konfigurasi &bull; Mode simulasi SILO &bull; Endpoint CEISA 4.0</p>
            </div>
        </div>
        <span class="badge badge-approved" style="padding: 6px 14px; font-size: 12px;">
            <span class="status-dot active" style="width: 7px; height: 7px; margin-right: 5px;"></span>
            Mode Operasional Live
        </span>
    </div>
</div>

<!-- Settings Cards -->
<div style="max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
    @foreach (var setting in Model)
    {
        <div class="glass-card card-shine" style="padding: 0; overflow: hidden; animation: fadeSlideUp 0.5s ease both;">
            <form method="post" action="/Setting/UpdateSetting" id="form-@setting.Key">
                <input type="hidden" name="key" value="@setting.Key" />
                <div class="setting-item-grid">
                    <!-- Left: Key Info -->
                    <div style="padding: 20px 22px; border-right: 1px solid var(--border-color);">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                            <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent-primary); box-shadow: 0 0 6px var(--accent-primary);"></div>
                            <span class="code-badge" style="font-size: 12.5px; font-weight: 700;">@setting.Key</span>
                        </div>
                        <div style="font-size: 12.5px; color: var(--text-secondary); line-height: 1.5;">@setting.Desc</div>
                    </div>

                    <!-- Middle: Value Control -->
                    <div style="padding: 20px 22px; display: flex; align-items: center;">
                        @if (setting.Key == "USE_MOCK_SILO")
                        {
                            <div style="display: flex; align-items: center; gap: 16px;">
                                <label class="switch">
                                    <input type="checkbox" id="mockToggle" @(setting.Value == "true" ? "checked" : "") onchange="updateMockValue(this)" />
                                    <span class="slider"></span>
                                </label>
                                <input type="hidden" name="value" id="mockValueInput" value="@setting.Value" />
                                <div>
                                    <div id="mockStatusText" style="font-size: 13.5px; font-weight: 700; color: @(setting.Value == "true" ? "var(--accent-warning)" : "var(--accent-success)");">
                                        @(setting.Value == "true" ? "✦ Aktif — Mode Simulasi Mock" : "✓ Non-Aktif — Oracle Riil")
                                    </div>
                                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 3px;">Toggle untuk beralih mode Oracle SILO</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="text" name="value" class="form-control" value="@setting.Value" style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 500;" />
                        }
                    </div>

                    <!-- Right: Save Button -->
                    <div style="padding: 20px 20px; display: flex; align-items: center; border-left: 1px solid var(--border-color);">
                        <button type="submit" class="btn btn-primary" style="padding: 9px 18px; font-weight: 600; letter-spacing: 0.2px;">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            Simpan
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }
</div>

<!-- Info Box -->
<div style="max-width: 960px; margin: 20px auto 0; padding: 15px 18px; border-radius: var(--border-radius); background: rgba(59,130,246,0.04); border: 1px solid rgba(59,130,246,0.12); display: flex; align-items: flex-start; gap: 12px; animation: fadeSlideUp 0.6s ease both;">
    <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59,130,246,0.1); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); flex-shrink: 0;">
        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.6;">
        <strong style="color: var(--text-primary);">Catatan Konfigurasi:</strong> Perubahan parameter seperti <span class="code-badge" style="font-size: 10.5px;">USE_MOCK_SILO</span> atau <span class="code-badge" style="font-size: 10.5px;">CEISA_API_URL</span> berlaku secara <em>real-time</em> tanpa perlu restart. Setiap perubahan dicatat otomatis di <strong>Audit Log Aktivitas</strong>.
    </div>
</div>

@section Scripts {
<script>
function updateMockValue(checkbox) {
    const valInput = document.getElementById('mockValueInput');
    const textStatus = document.getElementById('mockStatusText');
    if (checkbox.checked) {
        valInput.value = 'true';
        textStatus.textContent = '✦ Aktif — Mode Simulasi Mock';
        textStatus.style.color = 'var(--accent-warning)';
    } else {
        valInput.value = 'false';
        textStatus.textContent = '✓ Non-Aktif — Oracle Riil';
        textStatus.style.color = 'var(--accent-success)';
    }
}
</script>
}
