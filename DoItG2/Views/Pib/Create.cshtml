            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="' + barangCounter + '" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgHs[]" class="form-control req-field" placeholder="23099020" maxlength="10" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgDesc[]" class="form-control req-field" placeholder="Uraian barang" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgVal[]" class="form-control" placeholder="0.00" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgQty[]" class="form-control req-field" placeholder="0" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgSat[]" class="form-control" placeholder="KGM - Kilogram" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
            + '</div>';
        document.getElementById('barangRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPibTabs();
    };

    DoIt.addDocRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 60px 180px 1fr 140px 120px 40px; gap:10px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="DocKd[]" class="form-control"><option value="380">380 - INVOICE</option><option value="740">740 - AWB</option><option value="861">861 - FORM D</option><option value="000">000 - LAINNYA</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocNo[]" class="form-control req-field" placeholder="Nomor dokumen" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocTg[]" class="form-control" placeholder="DD-MM-YYYY" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocFas[]" class="form-control" placeholder="Fasilitas" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
