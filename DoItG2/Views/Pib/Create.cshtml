</div>

@section Styles {
<style>
    .pib-tabs {
        display: flex;
        gap: 4px;
        overflow-x: auto;
        padding: 0 24px;
        margin: 0 -24px 24px;
        border-bottom: 2px solid var(--border-color);
        scrollbar-width: thin;
    }
    .pib-tab {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 14px;
        border: none;
        background: none;
        color: var(--text-secondary);
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
        margin-bottom: -2px;
        border-radius: 6px 6px 0 0;
    }
    .pib-tab:hover {
        color: var(--text-primary);
        background: var(--bg-secondary);
    }
    .pib-tab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }

    /* Tab Success (Lengkap - Hijau) */
    .pib-tab.tab-success {
        color: #15803d !important;
        border-bottom-color: #16a34a !important;
        background: rgba(22, 163, 74, 0.1) !important;
    }
    .pib-tab.tab-success .tab-num {
        background: #16a34a !important;
        color: #ffffff !important;
    }
    .pib-tab.tab-success .tab-icon::after {
        content: ' ✓';
        font-weight: 900;
        color: #16a34a;
    }

    /* Tab Danger (Belum Lengkap / Kosong - Merah) */
    .pib-tab.tab-danger {
        color: #dc2626 !important;
        border-bottom-color: #dc2626 !important;
        background: rgba(220, 38, 38, 0.1) !important;
    }
    .pib-tab.tab-danger .tab-num {
        background: #dc2626 !important;
        color: #ffffff !important;
    }
    .pib-tab.tab-danger .tab-icon::after {
        content: ' ✕';
        font-weight: 900;
        color: #dc2626;
    }

    .tab-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 11px;
        font-weight: 700;
        transition: all 0.2s ease;
    }
    .pib-tab.active .tab-num {
        background: var(--primary);
        color: white;
    }
    .pib-panel {
        display: none;
        padding: 0 24px 8px;
        animation: fadeInPanel 0.3s ease;
    }
    .pib-panel.active {
        display: block;
    }
    @@keyframes fadeInPanel {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }
    .panel-icon {
        color: var(--primary);
        flex-shrink: 0;
    }
    .entity-section {
        background: var(--bg-secondary);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid var(--border-color);
    }
    .section-subtitle {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 12px;
    }
    .doc-row {
        padding: 8px 0;
    }

    /* Input Field Real-time Status Colors */
    .form-control.field-valid {
        border-color: #16a34a !important;
        background-color: rgba(22, 163, 74, 0.03) !important;
    }
    .form-control.field-invalid {
        border-color: #dc2626 !important;
        background-color: rgba(220, 38, 38, 0.04) !important;
    }
</style>
}

@section Scripts {
<script>
(function() {
    var currentTab = 1;
    var totalTabs = 9;

    window.DoIt = window.DoIt || {};

    DoIt.switchPibTab = function(n) {
        currentTab = n;
        document.querySelectorAll('.pib-tab').forEach(function(t) {
            t.classList.toggle('active', parseInt(t.dataset.tab) === n);
        });
        document.querySelectorAll('.pib-panel').forEach(function(p) {
            p.classList.toggle('active', p.id === 'pibPanel' + n);
        });
        document.getElementById('prevTabBtn').style.display = n > 1 ? '' : 'none';
        document.getElementById('nextTabBtn').style.display = n < totalTabs ? '' : 'none';
        document.getElementById('submitPibBtn').style.display = n === totalTabs ? '' : 'none';

        DoIt.validateAllPibTabs();
    };

    DoIt.nextPibTab = function() {
        if (currentTab < totalTabs) {
            DoIt.switchPibTab(currentTab + 1);
        }
    };

    DoIt.prevPibTab = function() {
        if (currentTab > 1) DoIt.switchPibTab(currentTab - 1);
    };

    // Dynamic Tab & Field Validation System (Green for complete, Red for empty/invalid)
    DoIt.validateAllPibTabs = function() {
        for (var i = 1; i <= totalTabs; i++) {
            var panel = document.getElementById('pibPanel' + i);
            var tabBtn = document.querySelector('.pib-tab[data-tab="' + i + '"]');
            if (!panel || !tabBtn) continue;

            var reqFields = panel.querySelectorAll('.req-field, [required]');
            var isComplete = true;
            var hasAttemptedInput = false;

            reqFields.forEach(function(input) {
                var val = (input.value || '').trim();
                if (val !== '') {
                    hasAttemptedInput = true;
                    input.classList.add('field-valid');
                    input.classList.remove('field-invalid');
                } else {
                    isComplete = false;
                    input.classList.remove('field-valid');
                    if (input.dataset.touched === 'true') {
                        input.classList.add('field-invalid');
                    }
                }
            });

            tabBtn.classList.remove('tab-success', 'tab-danger');
            if (isComplete && reqFields.length > 0) {
                tabBtn.classList.add('tab-success');
            } else if (!isComplete && (hasAttemptedInput || i === currentTab || tabBtn.dataset.touched === 'true')) {
                tabBtn.classList.add('tab-danger');
            }
        }
    };

    DoIt.copyPibImportir = function(target) {
        var id = document.getElementById('pib_IdImp').value;
        var nitku = document.getElementById('pib_NitkuImp').value;
        var nm = document.getElementById('pib_NmImo').value;
        var al = document.getElementById('pib_AlImp').value;

        if (target === 'pemilik') {
            document.getElementById('pib_IdPemilik').value = id;
            document.getElementById('pib_NitkuPemilik').value = nitku;
            document.getElementById('pib_NmPemilik').value = nm;
            document.getElementById('pib_AlPemilik').value = al;
        } else if (target === 'pemusatan') {
            document.getElementById('pib_IdPemusatan').value = id;
            document.getElementById('pib_NitkuPemusatan').value = nitku;
            document.getElementById('pib_NmPemusatan').value = nm;
            document.getElementById('pib_AlPemusatan').value = al;
        }
        DoIt.toast('Data Importir disalin ke ' + target, 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.copyPibPengirim = function() {
        var nm = document.getElementById('pib_NmPenjual').value;
        var al = document.getElementById('pib_AlPenjual').value;
        var neg = document.getElementById('pib_NegPenjual').value;

        document.getElementById('pib_NmPemasok').value = nm;
        document.getElementById('pib_AlPemasok').value = al;
        document.getElementById('pib_NegPemasok').value = neg;
        DoIt.toast('Data Pengirim disalin dari Penjual', 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.fillPibSampleData = function() {
        document.getElementById('pib_Car').value = '000020-000000-20251123-000005';
        document.getElementById('pib_PelTujuan').value = 'IDCGK - CENGKARENG / SOEKARNO HATTA (U)';
        document.getElementById('pib_KdKantor').value = '050100 - KPU BEA DAN CUKAI TIPE C SOEKARNO-HATTA';
        document.getElementById('pib_JnsPib').value = '1';
        document.getElementById('pib_JnsImp').value = '1';
        document.getElementById('pib_JnsBayar').value = '1';

        document.getElementById('pib_IdImp').value = '00174392740460000';
        document.getElementById('pib_NitkuImp').value = '0017439274046000000000';
        document.getElementById('pib_NmImo').value = 'NNKGO INDONESIA';
        document.getElementById('pib_AlImp').value = 'DAAN MOGOT';

        DoIt.copyPibImportir('pemilik');
        DoIt.copyPibImportir('pemusatan');

        document.getElementById('pib_NmPenjual').value = 'NESTLE (THAI) LTD';
        document.getElementById('pib_AlPenjual').value = '999/9 RAMA 1 ROAD KWAENG PATHUMWAN,KHET PATHUMWAN, BANGKOK';
        document.getElementById('pib_NegPenjual').value = 'TH - THAILAND';
        DoIt.copyPibPengirim();

        document.getElementById('pib_NoApi').value = '2325256234234';
        document.getElementById('pib_StatusApi').value = 'LAINNYA';
        document.getElementById('pib_Afiliasi').value = 'AFL';

        document.getElementById('pib_NmAngkut').value = 'SUMATRA';
        document.getElementById('pib_NoVoyFlight').value = '2003';
        document.getElementById('pib_BenderaVoy').value = 'SG - SINGAPORE';
        document.getElementById('pib_TglTiba').value = '11-11-2025';
        document.getElementById('pib_PelMuat').value = 'THBKK - LAEM CHABANG';
        document.getElementById('pib_PelBongkar').value = 'IDCGK - CENGKARENG';
        document.getElementById('pib_Gudang').value = 'AF03 - ANGKASA PURA KARGO';

        document.getElementById('pib_KdVal').value = 'JPY';
        document.getElementById('pib_Ndpbm').value = '107.027';
        document.getElementById('pib_Fob').value = '27,100.00';
        document.getElementById('pib_NilaiPabeanValas').value = '24,209.01';
        document.getElementById('pib_Cif').value = '2,720,853.24';
        document.getElementById('pib_Freight').value = '485.00';
        document.getElementById('pib_Asuransi').value = 'DALAM NEGERI 100.0000';
        document.getElementById('pib_VoluntaryDeclaration').value = '1270.56';
        document.getElementById('pib_Bruto').value = '0.20177400';
        document.getElementById('pib_Netto').value = '0.20177000';

        document.getElementById('pib_KodeBank').value = '008';
        document.getElementById('pib_NoNtpn').value = '2608191100018899';
        document.getElementById('pib_StatusBayar').value = 'LUNAS';
        document.getElementById('pib_NilaiBm').value = '15000000';
        document.getElementById('pib_NilaiPpn').value = '33000000';
        document.getElementById('pib_NilaiPph').value = '7500000';
        document.getElementById('pib_NilaiPnbp').value = '100000';
        DoIt.recalcPibPungutan();

        document.getElementById('pib_TempatPernyataan').value = 'JAKARTA';
        document.getElementById('pib_TglPernyataan').value = '24-11-2025';
        document.getElementById('pib_NamaPernyataan').value = 'ABD';
        document.getElementById('pib_JabatanPernyataan').value = 'MANAGER';

        DoIt.toast('Sample data BC 2.0 berhasil diisikan seluruh tab!', 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.recalcPibPungutan = function() {
        var bm = parseFloat(document.getElementById('pib_NilaiBm')?.value || 0);
        var ppn = parseFloat(document.getElementById('pib_NilaiPpn')?.value || 0);
        var pph = parseFloat(document.getElementById('pib_NilaiPph')?.value || 0);
        var pnbp = parseFloat(document.getElementById('pib_NilaiPnbp')?.value || 0);
        var total = bm + ppn + pph + pnbp;
        var displayEl = document.getElementById('pib_TotalPungutanDisplay');
        if (displayEl) {
            displayEl.value = 'Rp ' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    };

    var barangCounter = 1;
    DoIt.addBarangRow = function() {
        barangCounter++;
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 50px 130px 1fr 100px 110px 110px 40px; gap:8px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="' + barangCounter + '" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgHs[]" class="form-control req-field" placeholder="23099020" maxlength="10" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgDesc[]" class="form-control req-field" placeholder="Uraian barang" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgVal[]" class="form-control" placeholder="0.00" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgQty[]" class="form-control req-field" placeholder="0" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="BrgSat[]" class="form-control" placeholder="KGM - Kilogram" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
            + '</div>';
        document.getElementById('barangRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPibTabs();
    };

    DoIt.addDocRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 60px 180px 1fr 140px 120px 40px; gap:10px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="DocKd[]" class="form-control"><option value="380">380 - INVOICE</option><option value="740">740 - AWB</option><option value="861">861 - FORM D</option><option value="000">000 - LAINNYA</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocNo[]" class="form-control req-field" placeholder="Nomor dokumen" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocTg[]" class="form-control" placeholder="DD-MM-YYYY" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="DocFas[]" class="form-control" placeholder="Fasilitas" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
            + '</div>';
        document.getElementById('docRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPibTabs();
    };

    DoIt.addKemasanRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 60px 100px 180px 1fr 40px; gap:12px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="number" name="KmsJml[]" class="form-control req-field" placeholder="0" min="1" required /></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="KmsJns[]" class="form-control req-field" required><option value="CT">CT - Carton</option><option value="PK">PK - Package</option><option value="PX">PX - Pallet</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="KmsMerk[]" class="form-control" placeholder="SESUAI IS" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
            + '</div>';
        document.getElementById('kemasanRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPibTabs();
    };

    DoIt.addContainerRow = function() {
        var html = '<div class="doc-row" style="display:grid; grid-template-columns: 60px 180px 120px 140px 1fr 40px; gap:12px; align-items:end; margin-bottom:12px;">'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" value="+" class="form-control" readonly style="text-align:center;background:var(--bg-secondary)" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="ContNo[]" class="form-control" placeholder="DNLU5203872" maxlength="17" /></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="ContUkr[]" class="form-control"><option value="20">20 FEET</option><option value="40">40 FEET</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><select name="ContMuat[]" class="form-control"><option value="L">F - LCL / FCL</option><option value="F">FCL</option></select></div>'
            + '<div class="form-group" style="margin-bottom:0"><input type="text" name="ContTipe[]" class="form-control" value="General / Dry Cargo" /></div>'
            + '<button type="button" class="btn btn-secondary" style="padding:6px;height:36px" onclick="this.parentElement.remove();DoIt.validateAllPibTabs()">&times;</button>'
            + '</div>';
        document.getElementById('containerRows').insertAdjacentHTML('beforeend', html);
        DoIt.validateAllPibTabs();
    };

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('#pibForm input, #pibForm select, #pibForm textarea').forEach(function(el) {
            el.addEventListener('input', function() {
                el.dataset.touched = 'true';
                var tabId = el.closest('.pib-panel')?.id?.replace('pibPanel', '');
                if (tabId) {
                    var btn = document.querySelector('.pib-tab[data-tab="' + tabId + '"]');
                    if (btn) btn.dataset.touched = 'true';
                }
                DoIt.validateAllPibTabs();
            });
            el.addEventListener('change', function() {
                el.dataset.touched = 'true';
                DoIt.validateAllPibTabs();
            });
        });

        DoIt.validateAllPibTabs();
    });
})();
</script>
}
