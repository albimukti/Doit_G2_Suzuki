        <!-- TAB 9: Pernyataan -->
        <div class="pib-panel" id="pibPanel9">
            <h3 class="panel-title">
                <svg class="panel-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Pernyataan Keabsahan Dokumen Impor
            </h3>
            
            <div style="background:var(--bg-secondary); padding:16px; border-radius:8px; margin-bottom:20px; font-size:13px; color:var(--text-secondary);">
                Dengan ini saya menyatakan bertanggung jawab atas kebenaran hal-hal yang diberitahukan dalam dokumen ini dan keabsahan dokumen pelengkap pabean yang menjadi dasar pembuatan dokumen ini.
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Tempat Dokumen Dibuat<span class="required">*</span></label>
                    <input type="text" name="TempatPernyataan" id="pib_TempatPernyataan" class="form-control req-field" value="JAKARTA" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Tanggal Pernyataan<span class="required">*</span></label>
                    <input type="text" name="TglPernyataan" id="pib_TglPernyataan" class="form-control req-field" value="24-11-2025" required />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Nama Penanggung Jawab<span class="required">*</span></label>
                    <input type="text" name="NamaPernyataan" id="pib_NamaPernyataan" class="form-control req-field" value="ABD" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Jabatan<span class="required">*</span></label>
                    <input type="text" name="JabatanPernyataan" id="pib_JabatanPernyataan" class="form-control req-field" value="MANAGER" required />
                </div>
            </div>
        </div>

        <!-- Navigation & Submit -->
        <div class="pib-nav" style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <button type="button" class="btn btn-secondary" id="prevTabBtn" onclick="DoIt.prevPibTab()" style="display:none">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                Sebelumnya
            </button>
            <div style="flex:1"></div>
            <div style="display:flex;gap:12px">
                <a href="/Pib" class="btn btn-secondary">Batal</a>
                <button type="button" class="btn btn-primary" id="nextTabBtn" onclick="DoIt.nextPibTab()">
                    Selanjutnya
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
                <button type="submit" class="btn btn-primary" id="submitPibBtn" style="display:none">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Simpan Dokumen PIB
                </button>
            </div>
        </div>
    </form>
</div>

@section Styles {
<style>
    /* Uiverse.io Menu Expandable Tab System - Clean Flexbox without Collision */
    .pib-tabs.menu {
        padding: 0.5rem;
        background-color: var(--bg-card, #ffffff);
        position: relative;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 8px;
        border-radius: 15px;
        box-shadow: 0 10px 25px 0 rgba(0, 0, 0, 0.075);
        border: 1px solid var(--border-color, #e2e8f0);
        margin: 0 0 24px 0;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .pib-tab.link {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0;
        width: 58px;
        min-width: 58px;
        height: 46px;
        padding: 0 10px;
        border-radius: 10px;
        position: relative;
        z-index: 1;
        overflow: hidden;
        transform-origin: center left;
        transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.25s cubic-bezier(0.4, 0, 0.2, 1), gap 0.25s cubic-bezier(0.4, 0, 0.2, 1), padding 0.25s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, border-color 0.2s ease;
        text-decoration: none;
        color: var(--text-secondary, #64748b);
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        flex-shrink: 0;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
    }

    .pib-tab.link::before {
        position: absolute;
        z-index: -1;
        content: "";
        display: block;
        border-radius: 10px;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        transform: translateX(100%);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: center right;
        background-color: var(--bg-hover, #f1f5f9);
    }

    .pib-tab .tab-icon.link-icon {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: static;
        margin: 0;
        transition: transform 0.2s ease, color 0.2s ease;
        color: inherit;
    }

    .pib-tab .tab-icon.link-icon svg {
        width: 22px;
        height: 22px;
        stroke-width: 2;
    }

    .pib-tab .tab-label.link-title {
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        white-space: nowrap;
        transform: translateX(6px);
        transition: max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 13px;
        font-weight: 700;
        text-indent: 0;
        margin: 0;
        padding: 0;
        display: inline-block;
    }

    /* Hover & Focus state: Expand Tab smoothly without overlapping icon */
    .pib-tab.link:hover,
    .pib-tab.link:focus {
        outline: 0;
        width: auto;
        min-width: 140px;
        padding: 0 16px;
        gap: 8px;
        color: var(--text-primary, #0f172a);
    }

    .pib-tab.link:hover::before,
    .pib-tab.link:focus::before {
        transform: translateX(0);
    }

    .pib-tab.link:hover .tab-label.link-title,
    .pib-tab.link:focus .tab-label.link-title {
        max-width: 130px;
        opacity: 1;
        transform: translateX(0);
    }

    /* Active State: Always Expanded with Vibrant Primary Accent */
    .pib-tab.link.active {
        width: auto;
        min-width: 145px;
        padding: 0 16px;
        gap: 8px;
        background: linear-gradient(135deg, var(--accent-primary, #2563eb), #1d4ed8) !important;
        color: #ffffff !important;
        border-color: transparent !important;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
    }

    .pib-tab.link.active::before {
        transform: translateX(0);
        background-color: transparent !important;
    }

    .pib-tab.link.active .tab-label.link-title {
        max-width: 130px;
        opacity: 1;
        transform: translateX(0);
        color: #ffffff !important;
    }

    .pib-tab.link.active .tab-icon.link-icon {
        color: #ffffff !important;
    }

    /* Tab Status Validation Colors */
    .pib-tab.tab-success {
        border-bottom: 3px solid #16a34a !important;
    }
    .pib-tab.tab-success .tab-icon.link-icon {
        color: #16a34a;
    }
    .pib-tab.active.tab-success .tab-icon.link-icon {
        color: #ffffff !important;
    }

    .pib-tab.tab-danger {
        border-bottom: 3px solid #dc2626 !important;
    }
    .pib-tab.tab-danger .tab-icon.link-icon {
        color: #dc2626;
    }
    .pib-tab.active.tab-danger .tab-icon.link-icon {
        color: #ffffff !important;
    }
    .pib-panel {
        display: none;
        padding: 0 24px 8px;
        animation: fadeInPanel 0.3s ease;
    }
    .pib-panel.active {
        display: block;
    }
    @@keyframes fadeInPanel {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }
    .panel-icon {
        color: var(--primary);
        flex-shrink: 0;
    }
    .entity-section {
        background: var(--bg-secondary);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid var(--border-color);
    }
    .section-subtitle {
        font-size: 14px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 12px;
    }
    .doc-row {
        padding: 8px 0;
    }

    /* Input Field Real-time Status Colors */
    .form-control.field-valid {
        border-color: #16a34a !important;
        background-color: rgba(22, 163, 74, 0.03) !important;
    }
    .form-control.field-invalid {
        border-color: #dc2626 !important;
        background-color: rgba(220, 38, 38, 0.04) !important;
    }
</style>
}

@section Scripts {
<script>
(function() {
    var currentTab = 1;
    var totalTabs = 9;

    window.DoIt = window.DoIt || {};

    DoIt.switchPibTab = function(n) {
        currentTab = n;
        document.querySelectorAll('.pib-tab').forEach(function(t) {
            t.classList.toggle('active', parseInt(t.dataset.tab) === n);
        });
        document.querySelectorAll('.pib-panel').forEach(function(p) {
            p.classList.toggle('active', p.id === 'pibPanel' + n);
        });
        document.getElementById('prevTabBtn').style.display = n > 1 ? '' : 'none';
        document.getElementById('nextTabBtn').style.display = n < totalTabs ? '' : 'none';
        document.getElementById('submitPibBtn').style.display = n === totalTabs ? '' : 'none';

        DoIt.validateAllPibTabs();
    };

    DoIt.nextPibTab = function() {
        if (currentTab < totalTabs) {
            DoIt.switchPibTab(currentTab + 1);
        }
    };

    DoIt.prevPibTab = function() {
        if (currentTab > 1) DoIt.switchPibTab(currentTab - 1);
    };

    var pibTabNames = ['Header', 'Entitas', 'Dokumen', 'Pengangkut', 'Kemasan & Peti', 'Transaksi', 'Detail Barang', 'Pungutan', 'Pernyataan'];

    // Dynamic Tab & Field Validation System (Green = complete, Red = ada field kosong)
    DoIt.validateAllPibTabs = function(forceHighlight) {
        var invalidTabs = [];

        for (var i = 1; i <= totalTabs; i++) {
            var panel = document.getElementById('pibPanel' + i);
            var tabBtn = document.querySelector('.pib-tab[data-tab="' + i + '"]');
            if (!panel || !tabBtn) continue;

            var reqFields = panel.querySelectorAll('.req-field, [required]');
            var isComplete = true;

            reqFields.forEach(function(input) {
                var val = (input.value || '').trim();
                if (val !== '') {
                    input.classList.add('field-valid');
                    input.classList.remove('field-invalid');
                } else {
                    isComplete = false;
                    input.classList.remove('field-valid');
                    // Warnai field merah jika dipaksa atau sudah disentuh
                    if (forceHighlight || input.dataset.touched === 'true') {
                        input.classList.add('field-invalid');
                    }
                }
            });

            // Pemeriksaan khusus baris dinamis per tab
            if (i === 3) {
                var docInputs = panel.querySelectorAll('[name="DocNo[]"]');
                var hasDoc = Array.from(docInputs).some(function(inp) { return (inp.value || '').trim() !== ''; });
                if (!hasDoc) isComplete = false;
            } else if (i === 7) {
                var hsInputs = panel.querySelectorAll('[name="BrgHs[]"]');
                var hasItem = Array.from(hsInputs).some(function(inp) { return (inp.value || '').trim() !== ''; });
                if (!hasItem) isComplete = false;
            }

            tabBtn.classList.remove('tab-success', 'tab-danger');
            if (reqFields.length === 0 && i !== 3 && i !== 7) {
                // Tab tanpa field wajib
            } else if (isComplete) {
                tabBtn.classList.add('tab-success');
            } else {
                tabBtn.classList.add('tab-danger');
                invalidTabs.push({
                    index: i,
                    name: 'Tab ' + i + ' (' + (pibTabNames[i - 1] || '') + ')',
                    panel: panel
                });
            }
        }

        return invalidTabs;
    };

    // Validasi Peringatan Saat Menekan Tombol Simpan PIB
    DoIt.validatePibBeforeSubmit = function(e) {
        var invalidTabs = DoIt.validateAllPibTabs(true);
        if (invalidTabs && invalidTabs.length > 0) {
            if (e && typeof e.preventDefault === 'function') e.preventDefault();

            var firstInvalid = invalidTabs[0];
            var invalidNames = invalidTabs.map(function(t) { return t.name; }).join('\n• ');

            // Otomatis pindah ke tab pertama yang belum lengkap
            DoIt.switchPibTab(firstInvalid.index);

            // Fokus ke field pertama yang masih kosong
            var firstEmptyInput = firstInvalid.panel.querySelector('.field-invalid, [required]:invalid, .req-field:not(.field-valid), [name="DocNo[]"], [name="BrgHs[]"]');
            if (firstEmptyInput) {
                setTimeout(function() {
                    firstEmptyInput.focus();
                }, 150);
            }

            // Tampilkan notifikasi peringatan
            if (typeof DoIt.toast === 'function') {
                DoIt.toast('⚠️ Dokumen PIB belum lengkap! Masih ada ' + invalidTabs.length + ' tab bertanda merah.', 'error');
            }

            if (typeof DoIt.confirmModal === 'function' || typeof DoIt.alert === 'function') {
                DoIt.alert(
                    'Dokumen PIB (BC 2.0) belum dapat disimpan karena terdapat ' + invalidTabs.length + ' tab yang belum terisi lengkap (berwarna merah):\n\n• ' + invalidNames + '\n\nSilakan lengkapi semua tab bertanda merah terlebih dahulu.',
                    '⚠️ Peringatan: Dokumen Belum Lengkap'
                );
            } else {
                alert('⚠️ PERINGATAN: DOKUMEN PIB BELUM LENGKAP!\n\nDokumen tidak dapat disimpan karena masih ada ' + invalidTabs.length + ' tab yang belum terisi (berwarna merah):\n\n• ' + invalidNames + '\n\nHarap lengkapi semua tab bertanda merah terlebih dahulu sebelum menyimpan dokumen.');
            }

            return false;
        }

        if (typeof DoIt.showLoading === 'function') {
            DoIt.showLoading('Menyimpan dokumen PIB (BC 2.0)...');
        }
        return true;
    };

    DoIt.copyPibImportir = function(target) {
        var id = document.getElementById('pib_IdImp').value;
        var nitku = document.getElementById('pib_NitkuImp').value;
        var nm = document.getElementById('pib_NmImo').value;
        var al = document.getElementById('pib_AlImp').value;

        if (target === 'pemilik') {
            document.getElementById('pib_IdPemilik').value = id;
            document.getElementById('pib_NitkuPemilik').value = nitku;
            document.getElementById('pib_NmPemilik').value = nm;
            document.getElementById('pib_AlPemilik').value = al;
        } else if (target === 'pemusatan') {
            document.getElementById('pib_IdPemusatan').value = id;
            document.getElementById('pib_NitkuPemusatan').value = nitku;
            document.getElementById('pib_NmPemusatan').value = nm;
            document.getElementById('pib_AlPemusatan').value = al;
        }
        DoIt.toast('Data Importir disalin ke ' + target, 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.copyPibPengirim = function() {
        var nm = document.getElementById('pib_NmPenjual').value;
        var al = document.getElementById('pib_AlPenjual').value;
        var neg = document.getElementById('pib_NegPenjual').value;

        document.getElementById('pib_NmPemasok').value = nm;
        document.getElementById('pib_AlPemasok').value = al;
        document.getElementById('pib_NegPemasok').value = neg;
        DoIt.toast('Data Pengirim disalin dari Penjual', 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.fillPibSampleData = async function() {
        var tabNames = ['Header', 'Entitas', 'Dokumen', 'Pengangkut', 'Kemasan & Peti', 'Transaksi', 'Barang', 'Pungutan', 'Pernyataan'];
        var activeTabName = tabNames[currentTab - 1] || ('Tab ' + currentTab);
        var confirmed = await DoIt.confirm(
            'Isi sample data CEISA 4.0 (BC 2.0) untuk Tab ' + currentTab + ' – ' + activeTabName + '?',
            'Konfirmasi Isi Sample Data'
        );
        if (!confirmed) return;

        switch (currentTab) {
            case 1:
                if (document.getElementById('pib_Car')) document.getElementById('pib_Car').value = '000020-000000-20251123-000005';
                if (document.getElementById('pib_PelTujuan')) document.getElementById('pib_PelTujuan').value = 'IDCGK - CENGKARENG / SOEKARNO HATTA (U)';
                if (document.getElementById('pib_KdKantor')) document.getElementById('pib_KdKantor').value = '050100 - KPU BEA DAN CUKAI TIPE C SOEKARNO-HATTA';
                if (document.getElementById('pib_JnsPib')) document.getElementById('pib_JnsPib').value = '1';
                if (document.getElementById('pib_JnsImp')) document.getElementById('pib_JnsImp').value = '1';
                if (document.getElementById('pib_JnsBayar')) document.getElementById('pib_JnsBayar').value = '1';
                break;
            case 2:
                if (document.getElementById('pib_IdImp')) document.getElementById('pib_IdImp').value = '00174392740460000';
                if (document.getElementById('pib_NitkuImp')) document.getElementById('pib_NitkuImp').value = '0017439274046000000000';
                if (document.getElementById('pib_NmImo')) document.getElementById('pib_NmImo').value = 'NNKGO INDONESIA';
                if (document.getElementById('pib_AlImp')) document.getElementById('pib_AlImp').value = 'DAAN MOGOT';
                DoIt.copyPibImportir('pemilik');
                DoIt.copyPibImportir('pemusatan');
                if (document.getElementById('pib_NmPenjual')) document.getElementById('pib_NmPenjual').value = 'NESTLE (THAI) LTD';
                if (document.getElementById('pib_AlPenjual')) document.getElementById('pib_AlPenjual').value = '999/9 RAMA 1 ROAD KWAENG PATHUMWAN, BANGKOK';
                if (document.getElementById('pib_NegPenjual')) document.getElementById('pib_NegPenjual').value = 'TH - THAILAND';
                DoIt.copyPibPengirim();
                if (document.getElementById('pib_NoApi')) document.getElementById('pib_NoApi').value = '2325256234234';
                if (document.getElementById('pib_StatusApi')) document.getElementById('pib_StatusApi').value = 'LAINNYA';
                if (document.getElementById('pib_Afiliasi')) document.getElementById('pib_Afiliasi').value = 'AFL';
                break;
            case 3:
                var docKd = document.querySelector('[name="DocKd[]"]'); if (docKd) docKd.value = '380';
                var docNo = document.querySelector('[name="DocNo[]"]'); if (docNo) docNo.value = '4002310125';
                var docTg = document.querySelector('[name="DocTg[]"]'); if (docTg) docTg.value = '04-11-2025';
                var docFas = document.querySelector('[name="DocFas[]"]'); if (docFas) docFas.value = '00 - ATGA';
                break;
            case 4:
                if (document.getElementById('pib_NoBc11')) document.getElementById('pib_NoBc11').value = 'BC11';
                if (document.getElementById('pib_TglBc11')) document.getElementById('pib_TglBc11').value = '11-11-2025';
                if (document.getElementById('pib_NoPosBc11')) document.getElementById('pib_NoPosBc11').value = '07';
                if (document.getElementById('pib_NoSubPos')) document.getElementById('pib_NoSubPos').value = '00';
                if (document.getElementById('pib_CaraAngkut')) document.getElementById('pib_CaraAngkut').value = '4';
                if (document.getElementById('pib_NmAngkut')) document.getElementById('pib_NmAngkut').value = 'SUMATRA';
                if (document.getElementById('pib_NoVoyFlight')) document.getElementById('pib_NoVoyFlight').value = '2003';
                if (document.getElementById('pib_BenderaVoy')) document.getElementById('pib_BenderaVoy').value = 'SG - SINGAPORE';
                if (document.getElementById('pib_TglTiba')) document.getElementById('pib_TglTiba').value = '11-11-2025';
                if (document.getElementById('pib_PelMuat')) document.getElementById('pib_PelMuat').value = 'THBKK - LAEM CHABANG';
                if (document.getElementById('pib_PelBongkar')) document.getElementById('pib_PelBongkar').value = 'IDCGK - CENGKARENG';
                if (document.getElementById('pib_Gudang')) document.getElementById('pib_Gudang').value = 'AF03 - ANGKASA PURA KARGO';
                break;
            case 5:
                var kmsJml = document.querySelector('[name="KmsJml[]"]'); if (kmsJml) kmsJml.value = '4543';
                var kmsJns = document.querySelector('[name="KmsJns[]"]'); if (kmsJns) kmsJns.value = 'CT';
                var kmsMerk = document.querySelector('[name="KmsMerk[]"]'); if (kmsMerk) kmsMerk.value = 'SESUAI IS';
                var contNo = document.querySelector('[name="ContNo[]"]'); if (contNo) contNo.value = 'DNLU5203872';
                var contUkr = document.querySelector('[name="ContUkr[]"]'); if (contUkr) contUkr.value = '20';
                var contMuat = document.querySelector('[name="ContMuat[]"]'); if (contMuat) contMuat.value = 'L';
                break;
            case 6:
                if (document.getElementById('pib_KdVal')) document.getElementById('pib_KdVal').value = 'JPY';
                if (document.getElementById('pib_Ndpbm')) document.getElementById('pib_Ndpbm').value = '107.027';
                if (document.getElementById('pib_JnsTransaksi')) document.getElementById('pib_JnsTransaksi').value = 'KMB - PEMBAYARAN KEMUDIAN';
                if (document.getElementById('pib_Fob')) document.getElementById('pib_Fob').value = '27,100.00';
                if (document.getElementById('pib_NilaiPabeanValas')) document.getElementById('pib_NilaiPabeanValas').value = '24,209.01';
                if (document.getElementById('pib_Cif')) document.getElementById('pib_Cif').value = '2,720,853.24';
                if (document.getElementById('pib_Freight')) document.getElementById('pib_Freight').value = '485.00';
                if (document.getElementById('pib_Asuransi')) document.getElementById('pib_Asuransi').value = 'DALAM NEGERI 100.0000';
                if (document.getElementById('pib_VoluntaryDeclaration')) document.getElementById('pib_VoluntaryDeclaration').value = '1270.56';
                if (document.getElementById('pib_Bruto')) document.getElementById('pib_Bruto').value = '0.20177400';
                if (document.getElementById('pib_Netto')) document.getElementById('pib_Netto').value = '0.20177000';
                break;
            case 7:
                var brgHs = document.querySelector('[name="BrgHs[]"]'); if (brgHs) brgHs.value = '23099020';
                var brgDesc = document.querySelector('[name="BrgDesc[]"]'); if (brgDesc) brgDesc.value = 'FELIX ADT SALMON IN JELLY(6x12)50G TBR';
                var brgVal = document.querySelector('[name="BrgVal[]"]'); if (brgVal) brgVal.value = '8,382.00';
                var brgQty = document.querySelector('[name="BrgQty[]"]'); if (brgQty) brgQty.value = '3,570';
                var brgSat = document.querySelector('[name="BrgSat[]"]'); if (brgSat) brgSat.value = 'KGM - Kilogram';
                break;
            case 8:
                if (document.getElementById('pib_KodeBank')) document.getElementById('pib_KodeBank').value = '008';
                if (document.getElementById('pib_NoNtpn')) document.getElementById('pib_NoNtpn').value = '2608191100018899';
                if (document.getElementById('pib_StatusBayar')) document.getElementById('pib_StatusBayar').value = 'LUNAS';
                if (document.getElementById('pib_NilaiBm')) document.getElementById('pib_NilaiBm').value = '15000000';
                if (document.getElementById('pib_NilaiPpn')) document.getElementById('pib_NilaiPpn').value = '33000000';
                if (document.getElementById('pib_NilaiPph')) document.getElementById('pib_NilaiPph').value = '7500000';
                if (document.getElementById('pib_NilaiPnbp')) document.getElementById('pib_NilaiPnbp').value = '100000';
                DoIt.recalcPibPungutan();
                break;
            case 9:
                if (document.getElementById('pib_TempatPernyataan')) document.getElementById('pib_TempatPernyataan').value = 'JAKARTA';
                if (document.getElementById('pib_TglPernyataan')) document.getElementById('pib_TglPernyataan').value = '24-11-2025';
                if (document.getElementById('pib_NamaPernyataan')) document.getElementById('pib_NamaPernyataan').value = 'ABD';
                if (document.getElementById('pib_JabatanPernyataan')) document.getElementById('pib_JabatanPernyataan').value = 'MANAGER';
                break;
        }

        // Tandai semua field di tab aktif sebagai touched
        var curPanel = document.getElementById('pibPanel' + currentTab);
        if (curPanel) {
            curPanel.querySelectorAll('input, select, textarea').forEach(function(el) {
                el.dataset.touched = 'true';
            });
        }
        document.querySelector('.pib-tab[data-tab="' + currentTab + '"]').dataset.touched = 'true';

        DoIt.toast('Sample data Tab ' + currentTab + ' (' + activeTabName + ') berhasil diisikan!', 'success');
        DoIt.validateAllPibTabs();
    };

    DoIt.recalcPibPungutan = function() {
        var bm = parseFloat(document.getElementById('pib_NilaiBm')?.value || 0);
        var ppn = parseFloat(document.getElementById('pib_NilaiPpn')?.value || 0);
        var pph = parseFloat(document.getElementById('pib_NilaiPph')?.value || 0);
        var pnbp = parseFloat(document.getElementById('pib_NilaiPnbp')?.value || 0);
        var total = bm + ppn + pph + pnbp;
        var displayEl = document.getElementById('pib_TotalPungutanDisplay');
        if (displayEl) {
            displayEl.value = 'Rp ' + total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    };

    var barangCounter = 1;
