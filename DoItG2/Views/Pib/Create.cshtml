    document.addEventListener('DOMContentLoaded', function() {
        // Reset semua nilai field agar tidak terisi oleh browser autocomplete
        document.querySelectorAll('#pibForm input[type="text"], #pibForm input[type="number"], #pibForm textarea').forEach(function(el) {
            el.value = '';
            el.removeAttribute('data-touched');
        });
        document.querySelectorAll('#pibForm select').forEach(function(el) {
            // Reset select ke opsi pertama yang kosong jika ada, atau biarkan default
            var firstEmpty = el.querySelector('option[value=""]');
            if (firstEmpty) el.value = '';
            el.removeAttribute('data-touched');
        });
        document.querySelectorAll('.pib-tab').forEach(function(btn) {
            btn.removeAttribute('data-touched');
        });

        // Pasang event listener
        document.querySelectorAll('#pibForm input, #pibForm select, #pibForm textarea').forEach(function(el) {
            el.addEventListener('input', function() {
                el.dataset.touched = 'true';
                var tabId = el.closest('.pib-panel')?.id?.replace('pibPanel', '');
                if (tabId) {
                    var btn = document.querySelector('.pib-tab[data-tab="' + tabId + '"]');
                    if (btn) btn.dataset.touched = 'true';
                }
                DoIt.validateAllPibTabs();
            });
            el.addEventListener('change', function() {
                el.dataset.touched = 'true';
                DoIt.validateAllPibTabs();
            });
        });

        // Real-time Check Duplicate CAR
        var carInput = document.getElementById('pib_Car');
        var carFeedback = document.getElementById('pib_car_feedback');
        if (carInput && carFeedback) {
            carInput.addEventListener('blur', async function() {
                var carVal = this.value.trim();
                if (!carVal) {
                    carFeedback.style.display = 'none';
                    return;
                }
                try {
                    var res = await fetch('/api/doc-lock/check-car-duplicate?car=' + encodeURIComponent(carVal) + '&docType=PIB');
                    var data = await res.json();
                    if (data.isDuplicate) {
                        carFeedback.style.display = 'block';
                        carFeedback.style.color = '#dc2626';
                        carFeedback.style.fontWeight = '600';
                        carFeedback.innerHTML = '⚠️ ' + data.message;
                        carInput.style.borderColor = '#dc2626';
                        carInput.setCustomValidity(data.message);
                    } else {
                        carFeedback.style.display = 'block';
                        carFeedback.style.color = '#16a34a';
                        carFeedback.style.fontWeight = '600';
                        carFeedback.innerHTML = '✓ Nomor Aju (CAR) tersedia';
                        carInput.style.borderColor = '#16a34a';
                        carInput.setCustomValidity('');
                    }
                } catch (err) {
                    console.error('Error checking CAR duplicate:', err);
                }
            });
        }

        DoIt.validateAllPibTabs();
    });
})();
</script>
