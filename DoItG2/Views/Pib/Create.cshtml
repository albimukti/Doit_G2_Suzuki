            <div class="form-group" style="background:var(--bg-secondary); padding:16px; border-radius:8px; border:1px solid var(--border-color);">
                <label class="form-label" style="font-weight:700; font-size:13px;">TOTAL PUNGUTAN IMPOR DIBAYAR (RP)</label>
                <input type="text" id="pib_TotalPungutanDisplay" class="form-control" value="Rp 55,600,000.00" readonly style="font-weight:800; font-size:18px; font-family:'JetBrains Mono',monospace; color:var(--primary); background:transparent; border:none;" />
