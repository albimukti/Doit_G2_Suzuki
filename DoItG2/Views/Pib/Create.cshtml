                    <input type="number" name="NilaiPph" id="pib_NilaiPph" class="form-control req-field" value="7500000" oninput="DoIt.recalcPibPungutan();DoIt.validateAllPibTabs()" required />
                </div>
                <div class="form-group">
                    <label class="form-label">PNBP Bea Cukai Rp<span class="required">*</span></label>
                    <input type="number" name="NilaiPnbp" id="pib_NilaiPnbp" class="form-control req-field" value="100000" oninput="DoIt.recalcPibPungutan();DoIt.validateAllPibTabs()" required />
