@model List<DoItG2.Models.PIB.PibResponModel>
@{
    Layout = "_Layout";
}

<div class="card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Respons Bea Cukai (PIB)</h2>
            <div class="card-subtitle">Riwayat dokumen respon (SPPB, SPJM, SPTNP) dari portal CEISA 4.0</div>
        </div>
    </div>

    <div class="table-wrapper" style="margin-top: 16px;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nomor CAR (AJU)</th>
                    <th>Kode Respon</th>
                    <th>Nama Pemasok</th>
                    <th>Nomor Dok Respon</th>
                    <th>Tanggal Respon</th>
                    <th>Kantor Bea Cukai</th>
                    <th>Deskripsi Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                            Tidak ada dokumen respon Bea Cukai ditemukan.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var badgeClass = item.ResKd switch
                        {
                            "300" => "badge-approved", // SPPB
                            "200" => "badge-sent",
                            _ => "badge-pending"
                        };
                        var statusText = item.ResKd switch
                        {
                            "300" => "SPPB",
                            "200" => "TERDAFTAR",
                            _ => "RESPON " + item.ResKd
                        };
                        <tr>
                            <td>
                                <a href="/Pib/Detail/@item.Car" style="font-weight:600; text-decoration:none; color:var(--accent-primary);">@item.Car</a>
                            </td>
                            <td>
                                <span class="badge @badgeClass">@statusText</span>
                            </td>
                            <td>@item.NamaImp</td>
                            <td style="font-weight:500;">@item.DokResNo</td>
                            <td>@item.ResTg</td>
                            <td>KPBC @item.Kpbc</td>
                            <td>@item.Deskripsi</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
