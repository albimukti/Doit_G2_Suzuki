@model List<DoItG2.Models.PIB.PibHeaderModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Daftar PIB (BC 2.0)";
}

<div class="card" style="max-width: 1300px; margin: 0 auto;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 class="card-title" style="margin: 0; font-size: 18px; font-weight: 700;">Pemberitahuan Impor Barang (PIB - BC 2.0)</h2>
            <div class="card-subtitle">Pengelolaan dokumen impor, approval internal, validasi otomatis, dan transmisi CEISA 4.0</div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a class="btn btn-secondary" href="/Pib/DownloadTemplate">
                Download Template
            </a>
            <a class="btn btn-secondary" href="/Pib/Upload">
                Upload Excel
            </a>
            <a class="btn btn-primary" href="/Pib/Create">
                + Buat PIB Baru
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin: 16px 24px 0;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin: 16px 24px 0;">@TempData["Error"]</div>
    }

    <div style="padding: 20px 24px;">
        <!-- Filter Bar -->
        <form method="get" style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <input type="text" name="search" class="form-control" placeholder="Cari Nomor CAR, Nama Pemasok, NOPEN, SPPB..." value="@Context.Request.Query["search"]" />
            </div>
            <div style="width: 220px;">
                <select name="approvalStatus" class="form-control">
                    <option value="">Semua Tahapan Alur</option>
                    <option value="DRAFT" selected="@(Context.Request.Query["approvalStatus"] == "DRAFT")">1. Draft Perekaman</option>
                    <option value="PENDING_APPROVAL" selected="@(Context.Request.Query["approvalStatus"] == "PENDING_APPROVAL")">2. Menunggu Approval</option>
                    <option value="APPROVED" selected="@(Context.Request.Query["approvalStatus"] == "APPROVED")">3. Disetujui (Siap Kirim)</option>
                    <option value="REJECTED" selected="@(Context.Request.Query["approvalStatus"] == "REJECTED")">4. Perlu Revisi</option>
                    <option value="TRANSMITTED" selected="@(Context.Request.Query["approvalStatus"] == "TRANSMITTED")">5. Terkirim ke CEISA</option>
                </select>
            </div>
            <div style="width: 160px;">
                <select name="status" class="form-control">
                    <option value="">Semua Respon BC</option>
                    <option value="DRAFT" selected="@(Context.Request.Query["status"] == "DRAFT")">Belum Transmisi</option>
                    <option value="NOPEN" selected="@(Context.Request.Query["status"] == "NOPEN")">NOPEN Terbit</option>
                    <option value="SPPB" selected="@(Context.Request.Query["status"] == "SPPB")">SPPB Terbit</option>
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">Filter</button>
            @if (Context.Request.Query.Count > 0)
            {
                <a href="/Pib" class="btn btn-secondary">Reset</a>
            }
        </form>

        <!-- Table Data -->
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nomor CAR (AJU)</th>
                        <th>Nama Pemasok</th>
                        <th>Valuta &amp; CIF</th>
                        <th>Pajak / Pungutan</th>
                        <th>No. Nopen / SPPB</th>
                        <th style="text-align: center;">Tahap Approval</th>
                        <th style="text-align: center;">Status CEISA</th>
                        <th style="text-align: center; width: 170px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                Tidak ada dokumen PIB ditemukan. Silakan buat baru atau tarik dari Oracle SILO.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="/Pib/Detail?id=@item.Car" style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #1e40af; text-decoration: none;">
                                    @item.Car
                                </a>
                                @if (item.AsalData == "S")
                                {
                                    <span class="badge badge-info" style="font-size: 10px; margin-left: 4px;" title="Di-import dari SILO">SILO</span>
                                }
                            </td>
                            <td style="font-weight: 600;">@item.NmPemasok</td>
                            <td style="font-family: 'JetBrains Mono', monospace; font-size: 13px;">
                                @item.KdVal @item.Cif
                            </td>
                            <td style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; color: #0f172a;">
                                Rp @item.TotalPungutan.ToString("N0")
                            </td>
                            <td style="font-size: 12px;">
                                @if (!string.IsNullOrEmpty(item.SppbNo))
                                {
                                    <span style="color: #059669; font-weight: 700;">SPPB: @item.SppbNo</span>
                                }
                                else if (!string.IsNullOrEmpty(item.PibNo))
                                {
                                    <span style="color: #2563eb; font-weight: 700;">NOPEN: @item.PibNo</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">-</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (item.ApprovalStatus == "APPROVED")
                                {
                                    <span class="badge badge-success" style="font-weight: 700;">DISETUJUI</span>
                                }
                                else if (item.ApprovalStatus == "PENDING_APPROVAL" || item.ApprovalStatus == "PENDING")
                                {
                                    <span class="badge badge-warning" style="font-weight: 700;">MENUNGGU</span>
                                }
                                else if (item.ApprovalStatus == "REJECTED" || item.ApprovalStatus == "FAILED")
                                {
                                    <span class="badge badge-danger" style="font-weight: 700;">REVISI</span>
                                }
                                else if (item.ApprovalStatus == "TRANSMITTED" || item.Status == "SPPB" || item.Status == "NOPEN")
                                {
                                    <span class="badge badge-sent" style="font-weight: 700;">TERKIRIM</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="font-weight: 700;">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (item.Status == "SPPB")
                                {
                                    <span class="badge badge-success">SPPB TERBIT</span>
                                }
                                else if (item.Status == "NOPEN")
                                {
                                    <span class="badge badge-sent">NOPEN</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">DRAFT</span>
                                }
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <div style="display: inline-flex; justify-content: center; gap: 5px; flex-wrap: nowrap;">
                                    <a href="/Pib/Detail?id=@item.Car" class="btn btn-sm btn-primary" style="padding: 4px 9px; font-size: 11px; font-weight: 600;" title="Lihat Detail & Review">
                                        Detail
                                    </a>
                                    <a href="/Pib/PrintPdf?id=@item.Car" target="_blank" class="btn btn-sm btn-secondary" style="padding: 4px 9px; font-size: 11px;" title="Cetak Dokumen PDF BC 2.0">
                                        PDF
                                    </a>
                                    <a href="/Ceisa/Tracking?car=@item.Car&type=PIB" class="btn btn-sm btn-secondary" style="padding: 4px 9px; font-size: 11px;" title="Tracking CEISA 4.0">
                                        Track
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
