@model DoItG2.Models.PIB.PibHeaderModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Detail PIB (BC 2.0) — {Model.Car}";
    var isApproved = Model.ApprovalStatus == "APPROVED";
    var isPending = Model.ApprovalStatus == "PENDING_APPROVAL";
    var isDraft = string.IsNullOrEmpty(Model.ApprovalStatus) || Model.ApprovalStatus == "DRAFT";
    var isTransmitted = Model.ApprovalStatus == "TRANSMITTED" || !string.IsNullOrEmpty(Model.SppbNo);
}

<style>
    .doc-stepper-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }
    .doc-step-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        transition: all 0.2s ease;
    }
    .doc-step-item.step-done {
        background: #f0fdf4;
        border-color: #86efac;
    }
    .doc-step-item.step-done-final {
        background: #ecfdf5;
        border-color: #10b981;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
    }
    .doc-step-item.step-active {
        background: #eff6ff;
        border-color: #3b82f6;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
    }
    .doc-step-item.step-rejected {
        background: #fef2f2;
        border-color: #fca5a5;
    }
    .doc-step-item.step-pending {
        opacity: 0.65;
    }
    .step-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 13px;
        flex-shrink: 0;
        background: #cbd5e1;
        color: #475569;
    }
    .step-done .step-badge {
        background: #16a34a;
        color: #ffffff;
    }
    .step-done-final .step-badge {
        background: #059669;
        color: #ffffff;
    }
    .step-active .step-badge {
        background: #2563eb;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    }
    .step-rejected .step-badge {
        background: #dc2626;
        color: #ffffff;
    }
    .step-title {
        font-weight: 700;
        font-size: 13px;
        color: #0f172a;
    }
    .step-desc {
        font-size: 11px;
        color: #64748b;
        margin-top: 1px;
    }
    .workflow-guidance-box {
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
</style>

<div style="display: flex; flex-direction: column; gap: 20px; max-width: 1200px; margin: 0 auto;">
    @if (ViewBag.IsLockedByOther == true)
    {
        <div style="background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 12px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.15);">
            <div style="display: flex; align-items: center; gap: 14px;">
                <div style="font-size: 28px;">🔒</div>
                <div>
                    <div style="font-weight: 700; color: #92400e; font-size: 15px;">
                        DOKUMEN SEDANG DIAKSES / DIEDIT PENGGUNA LAIN
                    </div>
                    <div style="font-size: 13px; color: #b45309; margin-top: 2px;">
                        Dokumen ini sedang dibuka/diedit oleh <strong>@ViewBag.LockedByName</strong> (<em>@ViewBag.LockedByUser</em>) sejak <strong>@ViewBag.LockedAt</strong>. Anda berada dalam mode <strong>Hanya Baca (Read-Only)</strong>.
                    </div>
                </div>
            </div>
            @if (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.Contains("ADMIN") == true)
            {
                <button type="button" class="btn btn-danger" onclick="forceUnlockDocument('@Model.Car')" style="white-space: nowrap; font-size: 13px; padding: 8px 16px;">
                    🔓 Buka Paksa Kunci (Force Unlock)
                </button>
            }
        </div>
    }

    <!-- 4-Stage Visual Workflow Stepper Card -->
    <div class="card" style="padding: 18px 22px; border: 1px solid var(--border-color, #e2e8f0); background: #ffffff;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
            <div style="font-size: 13px; font-weight: 700; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px;">
                Tahapan Alur Persetujuan &amp; Transmisi PIB
            </div>
            <div style="font-size: 12px; color: var(--text-muted);">
                CAR: <strong style="font-family: 'JetBrains Mono', monospace; color: #1e40af;">@Model.Car</strong>
            </div>
        </div>

        <!-- 4 Step Items Grid -->
        <div class="doc-stepper-grid">
            <!-- Step 1: Draft -->
            <div class="doc-step-item @(isDraft || Model.ApprovalStatus == "REJECTED" ? "step-active" : "step-done")">
                <div class="step-badge">
                    @(isDraft || Model.ApprovalStatus == "REJECTED" ? "1" : "✓")
                </div>
                <div class="step-content">
                    <div class="step-title">1. Perekaman Draft</div>
                    <div class="step-desc">Input data barang &amp; pabean</div>
                </div>
            </div>

            <!-- Step 2: Approval -->
            <div class="doc-step-item @(isPending ? "step-active" : (isApproved || isTransmitted ? "step-done" : (Model.ApprovalStatus == "REJECTED" ? "step-rejected" : "step-pending")))">
                <div class="step-badge">
                    @(isApproved || isTransmitted ? "✓" : (Model.ApprovalStatus == "REJECTED" ? "✕" : "2"))
                </div>
                <div class="step-content">
                    <div class="step-title">2. Review Supervisor</div>
                    <div class="step-desc">
                        @(Model.ApprovalStatus == "REJECTED" ? "Perlu perbaikan data" : (isApproved || isTransmitted ? $"Disetujui ({Model.ApprovedBy ?? "Supervisor"})" : "Verifikasi & approval"))
                    </div>
                </div>
            </div>

            <!-- Step 3: CEISA Transmission -->
            <div class="doc-step-item @(isApproved && !isTransmitted ? "step-active" : (isTransmitted ? "step-done" : "step-pending"))">
                <div class="step-badge">
                    @(isTransmitted ? "✓" : "3")
                </div>
                <div class="step-content">
                    <div class="step-title">3. Transmisi CEISA</div>
                    <div class="step-desc">Kirim data ke REST API BC</div>
                </div>
            </div>

            <!-- Step 4: Customs Response -->
            <div class="doc-step-item @(isTransmitted ? "step-done-final" : "step-pending")">
                <div class="step-badge">
                    @(isTransmitted ? "✓" : "4")
                </div>
                <div class="step-content">
                    <div class="step-title">4. Respon SPPB</div>
                    <div class="step-desc">
                        @(string.IsNullOrEmpty(Model.SppbNo) ? "Izin pengeluaran barang" : $"No. SPPB: {Model.SppbNo}")
                    </div>
                </div>
            </div>
        </div>

        <!-- Next Action Guidance Box -->
        <div class="workflow-guidance-box" style="@(isTransmitted ? "background: #f0fdf4; border: 1px solid #bbf7d0;" : (isApproved ? "background: #eff6ff; border: 1px solid #bfdbfe;" : (isPending ? "background: #fffbeb; border: 1px solid #fde68a;" : (Model.ApprovalStatus == "REJECTED" ? "background: #fef2f2; border: 1px solid #fecaca;" : "background: #f8fafc; border: 1px solid #e2e8f0;"))))">
            <div style="max-width: 780px;">
                <div style="font-weight: 700; font-size: 13px; color: #0f172a;">
                    @(isTransmitted ? "Dokumen Selesai Ditransmisikan ke CEISA 4.0" :
                      (isApproved ? "Dokumen Disetujui Secara Internal — Siap Dikirim ke Bea Cukai" :
                      (isPending ? "Dokumen Sedang Menunggu Persetujuan Supervisor / Manajer" :
                      (Model.ApprovalStatus == "REJECTED" ? "Dokumen Dikembalikan untuk Revisi / Perbaikan Data" :
                      "Tahap Perekaman Dokumen Draft PIB"))))
                </div>
                <div style="font-size: 12px; color: #475569; margin-top: 3px; line-height: 1.4;">
                    @if (isTransmitted)
                    {
                        <span>Dokumen telah resmi diterima CEISA 4.0 Bea Cukai dengan Nomor Pendaftaran <strong>@Model.PibNo</strong> dan status <strong>SPPB (@(string.IsNullOrEmpty(Model.SppbNo) ? "TERBIT" : Model.SppbNo))</strong>.</span>
                    }
                    else if (isApproved)
                    {
                        <span>Dokumen telah diperiksa dan disetujui. Silakan klik tombol <strong>'Kirim ke CEISA 4.0'</strong> untuk mengirim data ke gateway Bea Cukai.</span>
                    }
                    else if (isPending)
                    {
                        <span>Diajukan oleh <strong>@(string.IsNullOrEmpty(Model.SubmittedBy) ? "Operator" : Model.SubmittedBy)</strong>. Supervisor dapat memeriksa kalkulasi pabean lalu memilih <strong>Setujui</strong> atau <strong>Minta Revisi</strong>.</span>
                    }
                    else if (Model.ApprovalStatus == "REJECTED")
                    {
                        <span>Catatan Revisi: <strong>@(string.IsNullOrEmpty(Model.ReviewNotes) ? "Periksa kembali kelengkapan pabean" : Model.ReviewNotes)</strong>. Silakan edit dokumen lalu ajukan kembali.</span>
                    }
                    else
                    {
                        <span>Pastikan kelengkapan data barang, dokumen lampiran, dan nilai pabean sudah benar. Klik <strong>'Ajukan Persetujuan'</strong> untuk meneruskan ke Supervisor.</span>
                    }
                </div>
            </div>

            <!-- Primary Guidance Action Button -->
            <div>
                @if (isDraft || Model.ApprovalStatus == "REJECTED")
                {
                    <button type="button" class="btn btn-warning" onclick="openSubmitModal('@Model.Car')" style="font-weight: 700;">
                        Ajukan Persetujuan
                    </button>
                }
                else if (isPending)
                {
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn btn-success" onclick="openApproveModal('@Model.Car')" style="font-weight: 700;">
                            Setujui Dokumen
                        </button>
                        <button type="button" class="btn btn-danger" onclick="openRejectModal('@Model.Car')" style="font-weight: 700;">
                            Minta Revisi
                        </button>
                    </div>
                }
                else if (isApproved && !isTransmitted)
                {
                    <form method="post" action="/Ceisa/TransmitPib" style="display:inline;" onsubmit="DoIt.showLoading('Mentransmisikan dokumen ke CEISA 4.0...')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="car" value="@Model.Car" />
                        <button type="submit" class="btn btn-primary" style="font-weight: 700;">
                            Kirim ke CEISA 4.0
                        </button>
                    </form>
                }
                else if (isTransmitted)
                {
                    <a href="/Ceisa/Tracking?car=@Model.Car&type=PIB" class="btn btn-secondary" style="font-weight: 600;">
                        Tracking Status
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Top Action & Info Bar -->
    <div class="card" style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <h2 style="font-size: 17px; font-weight: 700; color: var(--text-primary); margin:0;">PIB (BC 2.0) — @Model.Car</h2>
                    @if (isTransmitted)
                    {
                        <span class="badge badge-sent" style="font-weight: 700;">SPPB / TERKIRIM</span>
                    }
                    else if (isApproved)
                    {
                        <span class="badge badge-success" style="font-weight: 700;">APPROVED (SIAP TRANSMISI)</span>
                    }
                    else if (isPending)
                    {
                        <span class="badge badge-warning" style="font-weight: 700;">MENUNGGU APPROVAL</span>
                    }
                    else if (Model.ApprovalStatus == "REJECTED")
                    {
                        <span class="badge badge-danger" style="font-weight: 700;">PERLU REVISI</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary" style="font-weight: 700;">DRAFT PEREKAMAN</span>
                    }
                </div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                    Importir: <strong>PT. SUZUKI INDOMOBIL MOTOR</strong> | Valuta: <strong>@Model.KdVal</strong> | CIF: <strong>@Model.Cif @Model.KdVal</strong>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
            <a href="/Pib/Edit?id=@Model.Car" class="btn btn-secondary" style="font-weight: 600;" title="Edit Data Dokumen">
                Edit Dokumen
            </a>
            <button type="button" class="btn btn-secondary" onclick="validateDocument('@Model.Car')">
                Validasi
            </button>
            <button type="button" class="btn btn-secondary" onclick="recalculateTax('@Model.Car')">
                Hitung Pajak
            </button>
            <a href="/Pib/PrintPdf?id=@Model.Car" target="_blank" class="btn btn-secondary">
                PDF
            </a>
            <a href="/Pib/ExportJson?id=@Model.Car" class="btn btn-secondary">
                JSON
            </a>
            <a href="/Ceisa/Tracking?car=@Model.Car&type=PIB" class="btn btn-secondary">
                Tracking
            </a>
            <a href="/Approval" class="btn btn-secondary">
                Approval Center
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }


    <!-- Tax & Duty Summary Widget -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
        <div class="card" style="padding: 14px 16px; border-left: 3px solid #3b82f6;">
            <div style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Nilai Pabean (IDR)</div>
            <div style="font-size: 18px; font-weight: 800; color: #1e3a8a; margin-top: 4px;" id="valNilaiPabean">
                Rp @Model.NilaiPabean.ToString("N0")
            </div>
            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">NDPBM: Rp @Model.Ndpbm</div>
        </div>
        <div class="card" style="padding: 14px 16px; border-left: 3px solid #10b981;">
            <div style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Bea Masuk (BM)</div>
            <div style="font-size: 18px; font-weight: 800; color: #059669; margin-top: 4px;" id="valBm">
                Rp @Model.TotalBm.ToString("N0")
            </div>
            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">Fasilitas: KITE Pembebasan</div>
        </div>
        <div class="card" style="padding: 14px 16px; border-left: 3px solid #f59e0b;">
            <div style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">PPN Impor (11%)</div>
            <div style="font-size: 18px; font-weight: 800; color: #d97706; margin-top: 4px;" id="valPpn">
                Rp @Model.TotalPpn.ToString("N0")
            </div>
            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">Pajak Pertambahan Nilai</div>
        </div>
        <div class="card" style="padding: 14px 16px; border-left: 3px solid #6366f1;">
            <div style="font-size: 11px; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Total Tagihan Pungutan</div>
            <div style="font-size: 18px; font-weight: 800; color: #4338ca; margin-top: 4px;" id="valTotalPungutan">
                Rp @Model.TotalPungutan.ToString("N0")
            </div>
            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">Termasuk PPH Pasal 22</div>
        </div>
    </div>

    <!-- Multi Tab Section -->
    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="pib-tabs" style="padding: 10px 16px 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; gap: 6px; flex-wrap: wrap;">
            <button type="button" class="btn btn-sm btn-primary tab-nav active" data-tab="tab-barang" onclick="switchDetailTab('tab-barang', this)">Rincian Barang (@Model.Details.Count)</button>
            <button type="button" class="btn btn-sm btn-secondary tab-nav" data-tab="tab-entitas" onclick="switchDetailTab('tab-entitas', this)">Entitas &amp; Pengangkut</button>
            <button type="button" class="btn btn-sm btn-secondary tab-nav" data-tab="tab-dokumen" onclick="switchDetailTab('tab-dokumen', this)">Dokumen &amp; Kemasan (@Model.Documents.Count)</button>
            <button type="button" class="btn btn-sm btn-secondary tab-nav" data-tab="tab-respon" onclick="switchDetailTab('tab-respon', this)">Respons CEISA (@Model.Responses.Count)</button>
            <button type="button" class="btn btn-sm btn-secondary tab-nav" data-tab="tab-approval" onclick="switchDetailTab('tab-approval', this)">Riwayat Approval (@Model.ApprovalLogs.Count)</button>
        </div>

        <div style="padding: 24px;">
            <!-- Tab Barang -->
            <div id="tab-barang" class="detail-tab-pane">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;">No</th>
                                <th>HS Code</th>
                                <th>Uraian Barang</th>
                                <th style="text-align: right;">Jumlah</th>
                                <th>Satuan</th>
                                <th style="text-align: right;">Harga Satuan (@Model.KdVal)</th>
                                <th style="text-align: right;">Total Nilai CIF</th>
                                <th style="text-align: center;">Fasilitas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Details.Count == 0)
                            {
                                <tr><td colspan="8" style="text-align: center; color: #94a3b8; padding: 24px;">Belum ada data barang. Silakan upload Excel atau isi form manual.</td></tr>
                            }
                            @foreach (var itm in Model.Details)
                            {
                                <tr>
                                    <td style="text-align: center; font-weight: bold;">@itm.Serial</td>
                                    <td><span style="font-family: monospace; font-weight: 700; color: #1e3a8a;">@itm.HsNo</span></td>
                                    <td style="font-weight: 600;">@itm.GoodDesc1</td>
                                    <td style="text-align: right; font-family: monospace;">@itm.Quantity.ToString("N2")</td>
                                    <td><span class="badge badge-secondary">@itm.UnitType</span></td>
                                    <td style="text-align: right; font-family: monospace;">@itm.UnitVal.ToString("N2")</td>
                                    <td style="text-align: right; font-family: monospace; font-weight: 700; color: #0f172a;">@itm.CifPerUnit.ToString("N2")</td>
                                    <td style="text-align: center;"><span class="badge badge-success">@itm.KdFas</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab Entitas -->
            <div id="tab-entitas" class="detail-tab-pane" style="display: none;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                    <div style="background: #f8fafc; padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <h4 style="margin: 0 0 12px; font-size: 14px; color: #1e3a8a; font-weight: 700;">Data Importir &amp; PPJK</h4>
                        <table style="width: 100%; font-size: 13px; line-height: 2;">
                            <tr><td style="width: 140px; color: #64748b;">Nama Importir</td><td>: <strong>@Model.NmImo</strong></td></tr>
                            <tr><td style="color: #64748b;">NPWP Importir</td><td>: <strong>@Model.IdImp</strong></td></tr>
                            <tr><td style="color: #64748b;">Alamat</td><td>: @Model.AlImp</td></tr>
                            <tr><td style="color: #64748b;">Kantor Pabean</td><td>: <strong>@Model.KdKantor</strong></td></tr>
                        </table>
                    </div>
                    <div style="background: #f8fafc; padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <h4 style="margin: 0 0 12px; font-size: 14px; color: #1e3a8a; font-weight: 700;">Data Pemasok &amp; Pengangkutan</h4>
                        <table style="width: 100%; font-size: 13px; line-height: 2;">
                            <tr><td style="width: 140px; color: #64748b;">Nama Pemasok</td><td>: <strong>@Model.NmPemasok</strong></td></tr>
                            <tr><td style="color: #64748b;">Negara Asal</td><td>: <strong>@Model.NegPemasok</strong></td></tr>
                            <tr><td style="color: #64748b;">Sarana Angkut</td><td>: @Model.NmAngkut (Voy: @Model.NoVoyFlight)</td></tr>
                            <tr><td style="color: #64748b;">Pel. Muat / Bongkar</td><td>: @Model.PelMuat ➔ @Model.PelBongkar</td></tr>
                            <tr><td style="color: #64748b;">Manifes BC 1.1</td><td>: @(string.IsNullOrEmpty(Model.NoBc11) ? "-" : $"No. {Model.NoBc11} Pos: {Model.NoPosBc11}")</td></tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Tab Dokumen -->
            <div id="tab-dokumen" class="detail-tab-pane" style="display: none;">
                <h4 style="margin: 0 0 12px; font-size: 14px; color: #1e3a8a; font-weight: 700;">Dokumen Pelengkap Pabean</h4>
                <table class="data-table" style="margin-bottom: 24px;">
                    <thead>
                        <tr><th>Kode Dokumen</th><th>Nomor Dokumen</th><th>Tanggal Dokumen</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Documents.Count == 0) { <tr><td colspan="3" style="text-align: center; color: #94a3b8;">Belum ada dokumen dilampirkan.</td></tr> }
                        @foreach (var d in Model.Documents)
                        {
                            <tr><td><span class="badge badge-info">@d.DokKd</span></td><td><strong>@d.DokNo</strong></td><td>@d.DokTg</td></tr>
                        }
                    </tbody>
                </table>

                <h4 style="margin: 0 0 12px; font-size: 14px; color: #1e3a8a; font-weight: 700;">Peti Kemas / Kontainer</h4>
                <table class="data-table">
                    <thead>
                        <tr><th>Nomor Kontainer</th><th>Ukuran</th><th>Tipe Muatan</th><th>Jenis Kontainer</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Containers.Count == 0) { <tr><td colspan="4" style="text-align: center; color: #94a3b8;">Belum ada kontainer dicatat.</td></tr> }
                        @foreach (var c in Model.Containers)
                        {
                            <tr><td><strong>@c.NoCont</strong></td><td>@c.UkrCont Feet</td><td>@c.JnsMuat</td><td>@c.JnsCont</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tab Respon -->
            <div id="tab-respon" class="detail-tab-pane" style="display: none;">
                <table class="data-table">
                    <thead>
                        <tr><th>Kode Respon</th><th>Waktu Terima</th><th>No. Dokumen Respon</th><th>Tanggal Dokumen</th><th>Deskripsi Bea Cukai</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Responses.Count == 0) { <tr><td colspan="5" style="text-align: center; color: #94a3b8; padding: 20px;">Belum ada respon dari CEISA 4.0.</td></tr> }
                        @foreach (var r in Model.Responses)
                        {
                            <tr>
                                <td><span class="badge badge-success">@r.ResKd</span></td>
                                <td>@r.ResTg</td>
                                <td><strong>@r.DokResNo</strong></td>
                                <td>@r.DokResTg</td>
                                <td style="font-weight: 600;">@r.Deskripsi</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tab Approval History -->
            <div id="tab-approval" class="detail-tab-pane" style="display: none;">
                <table class="data-table">
                    <thead>
                        <tr><th>Waktu</th><th>Aksi</th><th>Status Baru</th><th>Diproses Oleh</th><th>Catatan</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.ApprovalLogs.Count == 0) { <tr><td colspan="5" style="text-align: center; color: #94a3b8; padding: 20px;">Belum ada riwayat approval.</td></tr> }
                        @foreach (var log in Model.ApprovalLogs)
                        {
                            <tr>
                                <td>@log.ActionDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td><span class="badge badge-primary">@log.Action</span></td>
                                <td><strong>@log.NewStatus</strong></td>
                                <td>👤 @log.ActionBy</td>
                                <td>@(log.Notes ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Approval Review -->
<div class="modal-overlay" id="approvalModal">
    <div class="modal-box" style="max-width: 480px;">
        <div class="modal-header">
            <h3 class="modal-title" id="approvalModalTitle">Persetujuan Dokumen</h3>
            <button type="button" class="modal-close" onclick="DoIt.closeModal('approvalModal')">&times;</button>
        </div>
        <form id="approvalForm" method="post">
            <input type="hidden" name="car" value="@Model.Car" />
            <div class="modal-body" style="padding: 20px;">
                <p id="approvalModalDesc" style="font-size: 13px; color: var(--text-secondary); margin-top: 0;"></p>
                <div class="form-group">
                    <label class="form-label">Catatan / Keterangan</label>
                    <textarea name="notes" id="approvalNotes" class="form-control" rows="3" placeholder="Masukkan catatan atau instruksi..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('approvalModal')">Batal</button>
                <button type="submit" class="btn btn-primary" id="approvalSubmitBtn">Kirim</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Validasi -->
<div class="modal-overlay" id="validationModal">
    <div class="modal-box" style="max-width: 600px;">
        <div class="modal-header">
            <h3 class="modal-title">Hasil Pemeriksaan Validasi Dokumen</h3>
            <button type="button" class="modal-close" onclick="DoIt.closeModal('validationModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 20px;" id="validationModalBody">
            <div style="text-align: center; padding: 20px; color: #64748b;">Memeriksa kepatuhan data...</div>
        </div>
        <div class="modal-footer" style="padding: 14px 20px; display: flex; justify-content: flex-end;">
            <button type="button" class="btn btn-primary" onclick="DoIt.closeModal('validationModal')">Tutup</button>
        </div>
    </div>
</div>

<script>
    function switchDetailTab(tabId, btn) {
        document.querySelectorAll('.detail-tab-pane').forEach(p => p.style.display = 'none');
        document.querySelectorAll('.tab-nav').forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-secondary');
        });
        document.getElementById(tabId).style.display = 'block';
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-primary');
    }

    function openSubmitModal(car) {
        document.getElementById('approvalModalTitle').innerText = 'Ajukan Dokumen untuk Review';
        document.getElementById('approvalModalDesc').innerText = 'Dokumen PIB akan diajukan ke Supervisor/Manager untuk diverifikasi sebelum dikirim ke CEISA.';
        document.getElementById('approvalForm').action = '/Pib/SubmitForApproval';
        document.getElementById('approvalSubmitBtn').className = 'btn btn-warning';
        document.getElementById('approvalSubmitBtn').innerText = 'Ajukan Review';
        DoIt.openModal('approvalModal');
    }

    function openApproveModal(car) {
        document.getElementById('approvalModalTitle').innerText = 'Persetujuan Supervisor (Approve)';
        document.getElementById('approvalModalDesc').innerText = 'Dokumen PIB telah diperiksa dan disetujui untuk transmisi langsung ke portal CEISA 4.0 Bea Cukai.';
        document.getElementById('approvalForm').action = '/Pib/ApproveDocument';
        document.getElementById('approvalSubmitBtn').className = 'btn btn-success';
        document.getElementById('approvalSubmitBtn').innerText = 'Setujui Dokumen';
        DoIt.openModal('approvalModal');
    }

    function openRejectModal(car) {
        document.getElementById('approvalModalTitle').innerText = 'Kembalikan untuk Revisi (Reject)';
        document.getElementById('approvalModalDesc').innerText = 'Tuliskan catatan perbaikan atau alasan penolakan agar operator dapat memperbaiki draft PIB.';
        document.getElementById('approvalForm').action = '/Pib/RejectDocument';
        document.getElementById('approvalSubmitBtn').className = 'btn btn-danger';
        document.getElementById('approvalSubmitBtn').innerText = 'Kembalikan Revisi';
        DoIt.openModal('approvalModal');
    }

    async function validateDocument(car) {
        DoIt.openModal('validationModal');
        document.getElementById('validationModalBody').innerHTML = '<div style="text-align:center;padding:20px;">Memeriksa kelengkapan pabean...</div>';
        
        try {
            const res = await fetch(`/Pib/ValidatePib?car=${encodeURIComponent(car)}`);
            const json = await res.json();
            const data = json.data;
            
            let html = '';
            if (data.isValid) {
                html = `
                    <div style="background:#ecfdf5;border:1px solid #a7f3d0;padding:16px;border-radius:8px;text-align:center;margin-bottom:14px;">
                        <div style="font-size:28px;color:#10b981;">✓</div>
                        <div style="font-weight:700;color:#065f46;font-size:16px;margin-top:4px;">Dokumen Lengkap & Valid!</div>
                        <div style="font-size:12px;color:#047857;margin-top:2px;">Semua field wajib, HS code, dan konsistensi hitungan sesuai standar CEISA 4.0.</div>
                    </div>
                `;
            } else {
                html = `
                    <div style="background:#fef2f2;border:1px solid #fecaca;padding:14px;border-radius:8px;margin-bottom:14px;">
                        <div style="font-weight:700;color:#991b1b;">Ditemukan ${data.errorCount} Error & ${data.warningCount} Warning:</div>
                    </div>
                `;
            }

            if (data.errors && data.errors.length > 0) {
                html += '<ul style="padding-left:20px;font-size:13px;line-height:1.8;color:#334155;">';
                data.errors.forEach(e => {
                    const color = e.severity === 2 ? '#dc2626' : (e.severity === 1 ? '#d97706' : '#2563eb');
                    const badge = e.severity === 2 ? 'ERROR' : (e.severity === 1 ? 'WARNING' : 'INFO');
                    html += `<li><strong style="color:${color}">[${badge} - ${e.tab}]</strong> ${e.message}</li>`;
                });
                html += '</ul>';
            }
            
            document.getElementById('validationModalBody').innerHTML = html;
        } catch (err) {
            document.getElementById('validationModalBody').innerHTML = `<div style="color:#dc2626;">Gagal memproses validasi: ${err.message}</div>`;
        }
    }

    async function recalculateTax(car) {
        DoIt.showLoading('Menghitung pajak & kurs terbaru...');
        try {
            const res = await fetch(`/Pib/CalculateTax`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `car=${encodeURIComponent(car)}`
            });
            const json = await res.json();
            DoIt.hideLoading();
            if (json.success) {
                const d = json.data;
                document.getElementById('valNilaiPabean').innerText = 'Rp ' + Math.round(d.nilaiPabean).toLocaleString('id-ID');
                document.getElementById('valBm').innerText = 'Rp ' + Math.round(d.beaMasukIdr).toLocaleString('id-ID');
                document.getElementById('valPpn').innerText = 'Rp ' + Math.round(d.ppnIdr).toLocaleString('id-ID');
                document.getElementById('valPungutan').innerText = 'Rp ' + Math.round(d.totalBayar).toLocaleString('id-ID');
                DoIt.toast('Kalkulasi pajak & kurs berhasil diperbarui!', 'success');
            }
        } catch (err) {
            DoIt.hideLoading();
            DoIt.toast('Gagal menghitung pajak: ' + err.message, 'danger');
        }
    }

    @if (ViewBag.IsLockedByOther != true)
    {
        <text>
        // Heartbeat document lock every 60s
        const heartbeatInterval = setInterval(() => {
            fetch('/api/doc-lock/heartbeat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ car: '@Model.Car', docType: 'PIB' })
            }).catch(console.error);
        }, 60000);

        window.addEventListener('beforeunload', () => {
            navigator.sendBeacon('/api/doc-lock/release', new Blob([JSON.stringify({ car: '@Model.Car' })], { type: 'application/json' }));
        });
        </text>
    }

    async function forceUnlockDocument(car) {
        if (!confirm(`Apakah Anda yakin ingin membuka paksa kunci dokumen CAR ${car}? User yang sedang mengakses akan kehilangan hak edit.`)) return;
        DoIt.showLoading('Membuka kunci dokumen...');
        try {
            const res = await fetch('/api/doc-lock/force-unlock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ car: car })
            });
            const json = await res.json();
            DoIt.hideLoading();
            if (json.success) {
                alert(json.message || 'Kunci berhasil dibuka!');
                window.location.reload();
            } else {
                alert(json.message || 'Gagal membuka kunci.');
            }
        } catch (err) {
            DoIt.hideLoading();
            alert('Gagal membuka kunci: ' + err.message);
        }
    }
</script>
