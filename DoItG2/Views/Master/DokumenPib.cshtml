@model List<DoItG2.Models.Common.MasterDokumenModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Dokumen Kepabeanan";
    var currentSearch = ViewBag.Search as string ?? "";
    int totalCount = Model.Count;
}

<!-- Hero Banner Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Master Jenis Dokumen Kepabeanan (Kode DJBC)</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Referensi kode dan deskripsi dokumen pelengkap pabean impor &amp; ekspor Suzuki</p>
            </div>
        </div>

        <div style="display: flex; gap: 10px;">
            <a href="/Master/ExportDokumenPibExcel" class="btn btn-success" style="height: 40px; padding: 0 16px; font-weight: 600;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Export Excel
            </a>
            <button type="button" class="btn btn-primary" onclick="DoIt.openModal('createDokumenModal')" style="height: 40px; padding: 0 16px; font-weight: 600;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                Tambah Dokumen
            </button>
        </div>
    </div>
</div>

<!-- Main Table -->
<div class="glass-card" style="padding: 0; overflow: hidden;">
    <div class="table-wrapper" style="border: none; border-radius: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 60px; text-align: center;">No</th>
                    <th style="width: 160px; text-align: center;">Kode DJBC</th>
                    <th>Nama Dokumen Kepabeanan</th>
                    <th style="width: 100px; text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 40px; color: var(--text-muted);">
                            Belum ada data Master Dokumen Pabean tercatat.
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px;">@(no++)</td>
                            <td style="text-align: center;"><span class="badge badge-sent" style="font-weight: 800; font-family: 'JetBrains Mono', monospace;">@item.KdDok</span></td>
                            <td style="font-weight: 700; color: var(--text-primary);">@item.NmDok</td>
                            <td style="text-align: center;"><span class="badge badge-approved">Aktif</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Dokumen Modal -->
<div class="modal-overlay" id="createDokumenModal">
    <div class="modal-box" style="max-width: 480px;">
        <div class="modal-header">
            <span class="modal-title">Tambah Dokumen Pabean Baru</span>
            <button class="modal-close" onclick="DoIt.closeModal('createDokumenModal')">&times;</button>
        </div>
        <form method="post" action="/Master/CreateDokumenPib">
            <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Kode Dokumen DJBC <span class="required">*</span></label>
                    <input type="text" name="kdDok" class="form-control" placeholder="Contoh: 380" required style="font-family: 'JetBrains Mono', monospace;" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Nama Dokumen Kepabeanan <span class="required">*</span></label>
                    <input type="text" name="nmDok" class="form-control" placeholder="Contoh: Commercial Invoice" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('createDokumenModal')">Batal</button>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">Simpan Dokumen</button>
            </div>
        </form>
    </div>
</div>
