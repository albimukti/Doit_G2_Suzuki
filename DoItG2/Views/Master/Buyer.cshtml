@model List<DoItG2.Models.Common.MasterBuyerModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Pembeli Ekspor (Buyer)";
    var currentSearch = ViewBag.Search as string ?? "";
    int totalCount = Model.Count;
}

<!-- Hero Banner Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(59,130,246,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-success); border: 1px solid rgba(16,185,129,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Master Pembeli Ekspor (Buyer Overseas)</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Database pembeli &amp; jaringan distributor mobil/motor Suzuki di mancanegara</p>
            </div>
        </div>

        <div style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.18); border-radius: var(--border-radius-sm); padding: 6px 16px; text-align: center;">
            <div style="font-size: 17px; font-weight: 800; color: var(--accent-success); font-family: 'JetBrains Mono', monospace;">@totalCount</div>
            <div style="font-size: 9.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total Buyer</div>
        </div>
    </div>
</div>

<!-- Filter Panel & Actions -->
<div class="glass-card mb-24" style="padding: 18px 22px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <form method="get" action="/Master/Buyer" style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 280px;">
            <div style="position: relative; flex: 1;">
                <input type="text" name="search" class="form-control" value="@currentSearch" placeholder="Cari Kode Pembeli, Nama Buyer, Alamat..." style="padding-left: 36px; height: 40px;" />
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 12px; top: 12px; color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 18px;">Cari</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a href="/Master/Buyer" class="btn btn-secondary" style="height: 40px; padding: 0 14px;">Reset</a>
            }
        </form>

        <button type="button" class="btn btn-primary" onclick="DoIt.openModal('createBuyerModal')" style="height: 40px; padding: 0 16px; font-weight: 600;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Tambah Buyer Baru
        </button>
    </div>
</div>

<!-- Main Table -->
<div class="glass-card" style="padding: 0; overflow: hidden;">
    <div class="table-wrapper" style="border: none; border-radius: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">No</th>
                    <th style="width: 150px;">Kode Pembeli</th>
                    <th>Nama Pembeli / Eksportir</th>
                    <th>Alamat Tujuan</th>
                    <th style="width: 110px; text-align: center;">Negara Tujuan</th>
                    <th style="width: 90px; text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                            Belum ada data Master Pembeli tercatat.
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px;">@(no++)</td>
                            <td><span class="code-badge">@item.KdPembeli</span></td>
                            <td style="font-weight: 700; color: var(--text-primary);">@item.NmPembeli</td>
                            <td style="font-size: 12.5px; color: var(--text-secondary);">@(string.IsNullOrEmpty(item.AlmPembeli) ? "-" : item.AlmPembeli)</td>
                            <td style="text-align: center;"><span class="badge badge-approved">@(string.IsNullOrEmpty(item.NegPembeli) ? "JP" : item.NegPembeli)</span></td>
                            <td style="text-align: center;"><span class="badge badge-approved">Aktif</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Buyer Modal -->
<div class="modal-overlay" id="createBuyerModal">
    <div class="modal-box" style="max-width: 520px;">
        <div class="modal-header">
            <span class="modal-title">Tambah Pembeli Ekspor Baru</span>
            <button class="modal-close" onclick="DoIt.closeModal('createBuyerModal')">&times;</button>
        </div>
        <form method="post" action="/Master/CreateBuyer">
            <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Kode Pembeli <span class="required">*</span></label>
                        <input type="text" name="kdPembeli" class="form-control" placeholder="Contoh: BUY-MY-01" required style="font-family: 'JetBrains Mono', monospace;" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Negara Tujuan</label>
                        <input type="text" name="negPembeli" class="form-control" value="MY" />
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Nama Pembeli / Distributor <span class="required">*</span></label>
                    <input type="text" name="nmPembeli" class="form-control" placeholder="Contoh: BOUSTEAD SDN BERHAD" required />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Alamat Lengkap</label>
                    <textarea name="almPembeli" class="form-control" rows="2" placeholder="Contoh: KUALA LUMPUR, MALAYSIA"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('createBuyerModal')">Batal</button>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">Simpan Buyer</button>
            </div>
        </form>
    </div>
</div>
