@model List<DoItG2.Models.Common.MasterPartModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Part Suzuki";
    var currentSearch = ViewBag.Search as string ?? "";
    int totalCount = Model.Count;
    int distinctHsCount = Model.Select(m => m.HsCode).Where(h => !string.IsNullOrEmpty(h)).Distinct().Count();
}

<!-- Hero Banner Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Database Master Part Suzuki</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Inventori suku cadang Suzuki &bull; Pemetaan HS Code Bea Cukai &bull; Upload &amp; Export Excel</p>
            </div>
        </div>

        <!-- Metric Badges -->
        <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
            <div style="background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.18); border-radius: var(--border-radius-sm); padding: 6px 14px; text-align: center;">
                <div style="font-size: 17px; font-weight: 800; color: var(--accent-primary); font-family: 'JetBrains Mono', monospace;">@totalCount</div>
                <div style="font-size: 9.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total Part</div>
            </div>
            <div style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.18); border-radius: var(--border-radius-sm); padding: 6px 14px; text-align: center;">
                <div style="font-size: 17px; font-weight: 800; color: var(--accent-success); font-family: 'JetBrains Mono', monospace;">@distinctHsCount</div>
                <div style="font-size: 9.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Pos HS Code</div>
            </div>
        </div>
    </div>
</div>

<!-- Action Controls & Filter Panel -->
<div class="glass-card mb-24" style="padding: 18px 22px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <!-- Filter Form -->
        <form method="get" action="/Master/Part" style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 280px;">
            <div style="position: relative; flex: 1;">
                <input type="text" name="search" class="form-control" value="@currentSearch" placeholder="Cari Part No, Nama Part, HS Code, Subinv, Plant..." style="padding-left: 36px; height: 40px;" />
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 12px; top: 12px; color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 18px; font-weight: 600;">
                Cari
            </button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a href="/Master/Part" class="btn btn-secondary" style="height: 40px; padding: 0 14px;">Reset</a>
            }
        </form>

        <!-- Action Buttons -->
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <!-- Download Template Button -->
            <a asp-action="DownloadPartTemplate" class="btn btn-secondary" style="height: 40px; padding: 0 14px; font-size: 12.5px;" title="Download Template Excel (.xlsx)">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Template Excel
            </a>

            <!-- Upload Excel Button -->
            <button type="button" class="btn btn-warning" onclick="DoIt.openModal('uploadPartModal')" style="height: 40px; padding: 0 16px; font-weight: 600; font-size: 12.5px;" title="Unggah data Master Part dari Excel">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                Upload Excel
            </button>

            <!-- Export Excel Button -->
            <a href="/Master/ExportPartExcel?search=@currentSearch" class="btn btn-success" style="height: 40px; padding: 0 16px; font-weight: 600; font-size: 12.5px;" title="Export data Master Part ke file Excel">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Export Excel
            </a>

            <!-- Tambah Part Manual -->
            <button type="button" class="btn btn-primary" onclick="DoIt.openModal('createPartModal')" style="height: 40px; padding: 0 16px; font-weight: 600; font-size: 12.5px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                Tambah Part
            </button>
        </div>
    </div>
</div>

<!-- Main Table Card -->
<div class="glass-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 16px 22px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
        <div style="font-size: 14px; font-weight: 700; color: var(--text-primary);">Daftar Master Part Suzuki</div>
        <span style="font-size: 11.5px; color: var(--text-muted); background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 3px 10px; border-radius: 20px;">@totalCount entri ditampilkan</span>
    </div>

    <div class="table-wrapper" style="border: none; border-radius: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">No</th>
                    <th style="width: 170px;">Nomor Part</th>
                    <th>Nama Part / Deskripsi</th>
                    <th style="width: 130px; text-align: center;">HS Code</th>
                    <th style="width: 90px; text-align: center;">Satuan</th>
                    <th style="width: 120px;">Subinventory</th>
                    <th style="width: 90px; text-align: center;">Plant</th>
                    <th style="width: 100px; text-align: center;">Negara Asal</th>
                    <th style="width: 90px; text-align: center;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 48px; color: var(--text-muted);">
                            <div style="font-size: 32px; margin-bottom: 8px; opacity: 0.4;">📦</div>
                            <div style="font-size: 13.5px; font-weight: 600;">Belum ada data Master Part Suzuki tercatat.</div>
                            <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">Gunakan tombol <strong>Upload Excel</strong> di atas untuk memasukkan data inventori.</div>
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px;">@(no++)</td>
                            <td>
                                <span class="code-badge" style="font-size: 12px; font-weight: 700;">@item.PartNo</span>
                            </td>
                            <td style="font-weight: 600; color: var(--text-primary); font-size: 13px;">@item.PartName</td>
                            <td style="text-align: center;">
                                @if (!string.IsNullOrEmpty(item.HsCode))
                                {
                                    <span class="code-badge" style="color: var(--accent-success); border-color: rgba(16,185,129,0.2); background: rgba(16,185,129,0.06); font-size: 11.5px;">@item.HsCode</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-size: 12px;">—</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <span class="badge badge-draft" style="font-weight: 700;">@(string.IsNullOrEmpty(item.Satuan) ? "PCS" : item.Satuan)</span>
                            </td>
                            <td style="font-size: 12.5px; color: var(--text-secondary);">@(string.IsNullOrEmpty(item.Subinventory) ? "—" : item.Subinventory)</td>
                            <td style="text-align: center; font-size: 12.5px; color: var(--text-secondary);">@(string.IsNullOrEmpty(item.Plant) ? "—" : item.Plant)</td>
                            <td style="text-align: center;">
                                <span class="badge badge-approved" style="font-size: 10.5px;">@(string.IsNullOrEmpty(item.NegAsal) ? "JP" : item.NegAsal)</span>
                            </td>
                            <td style="text-align: center;">
                                <form method="post" action="/Master/DeletePart" style="display: inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Nonaktifkan Part @item.PartNo?')" style="padding: 3px 8px; font-size: 10.5px;" title="Nonaktifkan Part">
                                        Hapus
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Upload Excel Modal -->
<div class="modal-overlay" id="uploadPartModal">
    <div class="modal-box" style="max-width: 520px;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245,158,11,0.12); display: flex; align-items: center; justify-content: center; color: var(--accent-warning);">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                </div>
                <span class="modal-title" style="font-size: 15px; font-weight: 700;">Upload Master Part Excel</span>
            </div>
            <button class="modal-close" onclick="DoIt.closeModal('uploadPartModal')">&times;</button>
        </div>
        <form method="post" action="/Master/UploadPartExcel" enctype="multipart/form-data">
            <div class="modal-body" style="padding: 20px;">
                <div style="background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.18); border-radius: var(--border-radius-sm); padding: 14px; margin-bottom: 18px; font-size: 12px; color: var(--text-secondary); line-height: 1.5;">
                    <strong style="color: var(--text-primary);">Petunjuk Upload Excel:</strong>
                    <ul style="margin: 6px 0 0 16px; padding: 0;">
                        <li>Format file harus <strong>.xlsx</strong> atau <strong>.xls</strong></li>
                        <li>Gunakan struktur kolom: <code>PART_NO</code>, <code>PART_NAME</code>, <code>HS_CODE</code>, <code>SATUAN</code>, <code>SUBINVENTORY</code>, <code>PLANT</code>, <code>NEGASAL</code></li>
                        <li>Jika Nomor Part sudah ada di database, sistem akan otomatis memperbarui datanya (Upsert).</li>
                    </ul>
                </div>

                <div class="form-group">
                    <label class="form-label">Pilih File Excel <span class="required">*</span></label>
                    <input type="file" name="excelFile" class="form-control" accept=".xlsx, .xls" required style="padding: 8px;" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('uploadPartModal')">Batal</button>
                <button type="submit" class="btn btn-warning" style="font-weight: 700;">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                    Unggah &amp; Memproses
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Create Part Modal -->
<div class="modal-overlay" id="createPartModal">
    <div class="modal-box" style="max-width: 560px;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59,130,246,0.12); display: flex; align-items: center; justify-content: center; color: var(--accent-primary);">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                </div>
                <span class="modal-title" style="font-size: 15px; font-weight: 700;">Tambah Master Part Baru</span>
            </div>
            <button class="modal-close" onclick="DoIt.closeModal('createPartModal')">&times;</button>
        </div>
        <form method="post" action="/Master/CreatePart">
            <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Nomor Part <span class="required">*</span></label>
                        <input type="text" name="partNo" class="form-control" placeholder="Contoh: 13780-68K00" required style="font-family: 'JetBrains Mono', monospace;" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">HS Code Bea Cukai</label>
                        <input type="text" name="hsCode" class="form-control" placeholder="Contoh: 84213120" style="font-family: 'JetBrains Mono', monospace;" />
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Nama Part / Deskripsi <span class="required">*</span></label>
                    <input type="text" name="partName" class="form-control" placeholder="Contoh: FILTER COMP AIR" required />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Satuan</label>
                        <input type="text" name="satuan" class="form-control" value="PCS" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Subinventory</label>
                        <input type="text" name="subinventory" class="form-control" placeholder="RAW" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Plant</label>
                        <input type="text" name="plant" class="form-control" placeholder="P1" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label">Negara Asal</label>
                        <input type="text" name="negAsal" class="form-control" value="JP" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('createPartModal')">Batal</button>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">Simpan Master Part</button>
            </div>
        </form>
    </div>
</div>
