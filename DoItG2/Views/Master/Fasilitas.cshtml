@model List<DoItG2.Models.Common.MasterFasilitasModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Fasilitas Pabean / SKEP";
    var currentSearch = ViewBag.Search as string ?? "";
    int totalCount = Model.Count;
}

<!-- Hero Banner Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(239,68,68,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-warning); border: 1px solid rgba(245,158,11,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Master Surat Keputusan (SKEP) Fasilitas Kepabeanan</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Pengelolaan SKEP Fasilitas KITE, Tempat Penimbunan Berikat (TPB), dan Kawasan Bebas</p>
            </div>
        </div>

        <div style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.18); border-radius: var(--border-radius-sm); padding: 6px 16px; text-align: center;">
            <div style="font-size: 17px; font-weight: 800; color: var(--accent-warning); font-family: 'JetBrains Mono', monospace;">@totalCount</div>
            <div style="font-size: 9.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total SKEP</div>
        </div>
    </div>
</div>

<!-- Filter Panel & Actions -->
<div class="glass-card mb-24" style="padding: 18px 22px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <form method="get" action="/Master/Fasilitas" style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 280px;">
            <div style="position: relative; flex: 1;">
                <input type="text" name="search" class="form-control" value="@currentSearch" placeholder="Cari Nomor SKEP, Jenis Fasilitas, Deskripsi..." style="padding-left: 36px; height: 40px;" />
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 12px; top: 12px; color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 18px;">Cari</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a href="/Master/Fasilitas" class="btn btn-secondary" style="height: 40px; padding: 0 14px;">Reset</a>
            }
        </form>

        <button type="button" class="btn btn-primary" onclick="DoIt.openModal('createFasilitasModal')" style="height: 40px; padding: 0 16px; font-weight: 600;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Tambah SKEP Fasilitas
        </button>
    </div>
</div>

<!-- Main Table -->
<div class="glass-card" style="padding: 0; overflow: hidden;">
    <div class="table-wrapper" style="border: none; border-radius: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">No</th>
                    <th style="width: 220px;">Nomor SKEP Bea Cukai</th>
                    <th style="width: 120px; text-align: center;">Tanggal SKEP</th>
                    <th style="width: 140px; text-align: center;">Jenis Fasilitas</th>
                    <th>Keterangan / Peruntukan</th>
                    <th style="width: 90px; text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                            Belum ada data SKEP Fasilitas Pabean tercatat.
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px;">@(no++)</td>
                            <td><span class="code-badge" style="font-weight: 700;">@item.NoSkep</span></td>
                            <td style="text-align: center; font-size: 12px;">@(item.TglSkep.HasValue ? item.TglSkep.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td style="text-align: center;"><span class="badge badge-warning">@item.JenisFasilitas</span></td>
                            <td style="font-size: 12.5px; color: var(--text-secondary);">@(string.IsNullOrEmpty(item.Deskripsi) ? "-" : item.Deskripsi)</td>
                            <td style="text-align: center;"><span class="badge badge-approved">Aktif</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Fasilitas Modal -->
<div class="modal-overlay" id="createFasilitasModal">
    <div class="modal-box" style="max-width: 520px;">
        <div class="modal-header">
            <span class="modal-title">Tambah SKEP Fasilitas Baru</span>
            <button class="modal-close" onclick="DoIt.closeModal('createFasilitasModal')">&times;</button>
        </div>
        <form method="post" action="/Master/CreateFasilitas">
            <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Nomor SKEP Bea Cukai <span class="required">*</span></label>
                        <input type="text" name="noSkep" class="form-control" placeholder="Contoh: SKEP-128/KM.4/2024" required style="font-family: 'JetBrains Mono', monospace;" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Tanggal SKEP</label>
                        <input type="date" name="tglSkep" class="form-control" />
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Jenis Fasilitas</label>
                    <select name="jenisFasilitas" class="form-control">
                        <option value="KITE Pembebasan">KITE Pembebasan (BCL.KT01)</option>
                        <option value="KITE Pengembalian">KITE Pengembalian (BCL.KT02)</option>
                        <option value="Kawasan Berikat (KB)">Kawasan Berikat (KB)</option>
                        <option value="Pusat Logistik Berikat">Pusat Logistik Berikat (PLB)</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Keterangan / Deskripsi</label>
                    <textarea name="deskripsi" class="form-control" rows="2" placeholder="Contoh: Fasilitas Pembebasan Bea Masuk Bahan Baku Otomotif PT. Suzuki Indomobil Motor"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('createFasilitasModal')">Batal</button>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">Simpan SKEP</button>
            </div>
        </form>
    </div>
</div>
