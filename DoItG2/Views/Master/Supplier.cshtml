@model List<DoItG2.Models.Common.MasterSupplierModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Pemasok Impor (Supplier)";
    var currentSearch = ViewBag.Search as string ?? "";
    int totalCount = Model.Count;
}

<!-- Hero Banner Header -->
<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Master Pemasok Impor (Supplier Overseas)</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Pengelolaan database pemasok suku cadang &amp; komponen Suzuki dari luar negeri</p>
            </div>
        </div>

        <div style="background: rgba(59,130,246,0.08); border: 1px solid rgba(59,130,246,0.18); border-radius: var(--border-radius-sm); padding: 6px 16px; text-align: center;">
            <div style="font-size: 17px; font-weight: 800; color: var(--accent-primary); font-family: 'JetBrains Mono', monospace;">@totalCount</div>
            <div style="font-size: 9.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Total Supplier</div>
        </div>
    </div>
</div>

<!-- Filter Panel & Actions -->
<div class="glass-card mb-24" style="padding: 18px 22px;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <form method="get" action="/Master/Supplier" style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 280px;">
            <div style="position: relative; flex: 1;">
                <input type="text" name="search" class="form-control" value="@currentSearch" placeholder="Cari Kode Pemasok, Nama Supplier, Alamat..." style="padding-left: 36px; height: 40px;" />
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 12px; top: 12px; color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 18px;">Cari</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a href="/Master/Supplier" class="btn btn-secondary" style="height: 40px; padding: 0 14px;">Reset</a>
            }
        </form>

        <button type="button" class="btn btn-primary" onclick="DoIt.openModal('createSupplierModal')" style="height: 40px; padding: 0 16px; font-weight: 600;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Tambah Supplier Baru
        </button>
    </div>
</div>

<!-- Main Table -->
<div class="glass-card" style="padding: 0; overflow: hidden;">
    <div class="table-wrapper" style="border: none; border-radius: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">No</th>
                    <th style="width: 150px;">Kode Pemasok</th>
                    <th>Nama Pemasok / Supplier</th>
                    <th>Alamat Lengkap</th>
                    <th style="width: 110px; text-align: center;">Negara Asal</th>
                    <th style="width: 90px; text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                            Belum ada data Master Pemasok tercatat.
                        </td>
                    </tr>
                }
                else
                {
                    int no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--text-muted); font-size: 12px;">@(no++)</td>
                            <td><span class="code-badge">@item.KdPemasok</span></td>
                            <td style="font-weight: 700; color: var(--text-primary);">@item.NmPemasok</td>
                            <td style="font-size: 12.5px; color: var(--text-secondary);">@(string.IsNullOrEmpty(item.AlmPemasok) ? "-" : item.AlmPemasok)</td>
                            <td style="text-align: center;"><span class="badge badge-approved">@(string.IsNullOrEmpty(item.NegPemasok) ? "JP" : item.NegPemasok)</span></td>
                            <td style="text-align: center;"><span class="badge badge-approved">Aktif</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Supplier Modal -->
<div class="modal-overlay" id="createSupplierModal">
    <div class="modal-box" style="max-width: 520px;">
        <div class="modal-header">
            <span class="modal-title">Tambah Pemasok Impor Baru</span>
            <button class="modal-close" onclick="DoIt.closeModal('createSupplierModal')">&times;</button>
        </div>
        <form method="post" action="/Master/CreateSupplier">
            <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Kode Pemasok <span class="required">*</span></label>
                        <input type="text" name="kdPemasok" class="form-control" placeholder="Contoh: SUP-SMC-01" required style="font-family: 'JetBrains Mono', monospace;" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Negara Asal</label>
                        <input type="text" name="negPemasok" class="form-control" value="JP" />
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Nama Pemasok / Supplier <span class="required">*</span></label>
                    <input type="text" name="nmPemasok" class="form-control" placeholder="Contoh: SUZUKI MOTOR CORPORATION" required />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Alamat Lengkap</label>
                    <textarea name="almPemasok" class="form-control" rows="2" placeholder="Contoh: 300 Takatsuka-cho, Minami-ku, Hamamatsu-shi, Shizuoka-ken"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="DoIt.closeModal('createSupplierModal')">Batal</button>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">Simpan Supplier</button>
            </div>
        </form>
    </div>
</div>
