@model DoItG2.Models.Common.DashboardStats
@{
    ViewData["Title"] = "Dashboard Integrasi Kepabeanan";
    var pibChartLabels = string.Join(",", Model.PibMonthlyChart.Select(x => $"'{x.Label}'"));
    var pibChartValues = string.Join(",", Model.PibMonthlyChart.Select(x => x.Value));
    var pebChartLabels = string.Join(",", Model.PebMonthlyChart.Select(x => $"'{x.Label}'"));
    var pebChartValues = string.Join(",", Model.PebMonthlyChart.Select(x => x.Value));

    // Dynamic greeting by hour
    var hour = DateTime.Now.Hour;
    var greeting = hour switch {
        >= 4 and < 11 => "Selamat Pagi",
        >= 11 and < 15 => "Selamat Siang",
        >= 15 and < 18 => "Selamat Sore",
        _ => "Selamat Malam"
    };

    var approvalRate = (Model.TotalPibMonth + Model.TotalPebMonth) > 0 
        ? Math.Round((double)(Model.PibApproved + Model.PebApproved) / (Model.TotalPibMonth + Model.TotalPebMonth) * 100, 1) 
        : 96.5;
}

<div style="display: flex; flex-direction: column; gap: 28px;">

    <!-- ===== 1. HERO BANNER ===== -->
    <div class="hero-banner" style="padding: 26px 32px; border-radius: var(--border-radius-lg); position: relative; overflow: hidden;">
        <!-- Background decorative ambient lighting -->
        <div style="position: absolute; right: -50px; top: -50px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%); pointer-events: none;"></div>

        <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
            <!-- Left: Branding & Greeting -->
            <div style="display: flex; align-items: center; gap: 22px;">
                <div style="width: 60px; height: 60px; border-radius: 18px; background: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 28px rgba(0,0,0,0.3); flex-shrink: 0; position: relative; padding: 6px;">
                    <img src="~/images/suzuki-logo-square.png" alt="Suzuki Logo" style="width: 100%; height: 100%; object-fit: contain;" asp-append-version="true" />
                    <span style="position: absolute; bottom: -2px; right: -2px; width: 14px; height: 14px; background: var(--accent-success); border: 2.5px solid var(--bg-card); border-radius: 50%;"></span>
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
                        <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: var(--accent-primary); background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.25); padding: 4px 12px; border-radius: 20px;">PT. Suzuki Indomobil Motor</span>
                        <span style="font-size: 11px; color: var(--text-muted); font-weight: 600; display: flex; align-items: center; gap: 4px;">
                            <span class="status-dot active" style="width: 6px; height: 6px;"></span> CEISA 4.0 Live Engine
                        </span>
                    </div>
                    <h1 style="font-size: 23px; font-weight: 900; color: var(--text-primary); margin: 0; letter-spacing: -0.6px; line-height: 1.25;">
                        @greeting, <span style="background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Tim Logistik")</span>! 👋
                    </h1>
                    <p style="font-size: 12.5px; color: var(--text-muted); margin: 5px 0 0; font-weight: 500;">
                        Dashboard Monitoring &amp; Integrasi Kepabeanan Real-time &bull; Oracle SILO ERP Sync &bull; CEISA 4.0 API Gateway
                    </p>
                </div>
            </div>

            <!-- Right: Action Bar & Live Clock -->
            <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <!-- Refresh Button -->
                <button type="button" onclick="refreshDashboard(this)" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; font-weight: 600; border-radius: var(--border-radius-sm);" title="Muat ulang data dashboard">
                    <svg id="refreshSpinIcon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    <span>Refresh</span>
                </button>

                <!-- Live Clock Widget -->
                <div style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 10px 18px; text-align: right; min-width: 140px;">
                    <div style="font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);">Waktu Sistem</div>
                    <div id="heroClock" style="font-size: 16px; font-weight: 800; color: var(--accent-primary); letter-spacing: 0.5px; font-family: 'JetBrains Mono', monospace;">@DateTime.Now.ToString("HH:mm:ss") WIB</div>
                    <div style="font-size: 10.5px; color: var(--text-muted); margin-top: 2px; font-weight: 500;">@DateTime.Now.ToString("dd MMMM yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== 2. KPI STAT CARDS GRID (6 CARDS) ===== -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        <!-- Card 1: PIB Impor Hari Ini -->
        <div class="stat-card glass-card card-shine purple stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap purple" style="width: 44px; height: 44px; border-radius: 12px;">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    </div>
                    <span class="badge badge-pib" style="font-size: 10.5px; font-weight: 700; padding: 4px 10px; white-space: nowrap;">IMPOR</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" id="cntPibToday" style="font-size: 32px; font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1.1;">@Model.TotalPibToday</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">PIB Impor Hari Ini</div>
                </div>
            </div>
            <div class="stat-change up" style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                <span><strong>@Model.TotalPibMonth</strong> total dokumen bulan ini</span>
            </div>
        </div>

        <!-- Card 2: PEB Ekspor Hari Ini -->
        <div class="stat-card glass-card card-shine blue stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap blue" style="width: 44px; height: 44px; border-radius: 12px;">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3m3 0h3m0 0v3m0-3l-6 6"/></svg>
                    </div>
                    <span class="badge badge-peb" style="font-size: 10.5px; font-weight: 700; padding: 4px 10px; white-space: nowrap;">EKSPOR</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" id="cntPebToday" style="font-size: 32px; font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1.1;">@Model.TotalPebToday</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">PEB Ekspor Hari Ini</div>
                </div>
            </div>
            <div class="stat-change up" style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                <span><strong>@Model.TotalPebMonth</strong> total dokumen bulan ini</span>
            </div>
        </div>

        <!-- Card 3: Menunggu Proses -->
        <div class="stat-card glass-card card-shine amber stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap amber" style="width: 44px; height: 44px; border-radius: 12px;">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="badge badge-pending" style="font-size: 10.5px; font-weight: 700; padding: 4px 10px; white-space: nowrap;">PENDING</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" id="cntPending" style="font-size: 32px; font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1.1;">@(Model.PibPending + Model.PebPending)</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">Menunggu Proses CEISA</div>
                </div>
            </div>
            <div class="stat-change" style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px; color: var(--text-muted);">
                PIB <strong style="color:var(--text-secondary);">@Model.PibPending</strong> &bull; PEB <strong style="color:var(--text-secondary);">@Model.PebPending</strong>
            </div>
        </div>

        <!-- Card 4: Disetujui Bea Cukai (SPPB) -->
        <div class="stat-card glass-card card-shine green stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap green" style="width: 44px; height: 44px; border-radius: 12px;">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="badge badge-success" style="font-size: 10.5px; font-weight: 700; padding: 4px 10px; white-space: nowrap;">SPPB OK</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" id="cntApproved" style="font-size: 32px; font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1.1;">@Model.PibApproved</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">Disetujui Bea Cukai</div>
                </div>
            </div>
            <div class="stat-change down" style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px;">
                <span>Approval Rate <strong style="color: var(--accent-success);">@approvalRate%</strong></span>
            </div>
        </div>

        <!-- Card 5: Bebas Bea Masuk (KITE) -->
        <div class="stat-card glass-card card-shine stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap" style="width: 44px; height: 44px; border-radius: 12px; background: rgba(168,85,247,0.12); color: var(--accent-purple);">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="badge badge-mita" style="font-size: 10.5px; font-weight: 700; padding: 4px 10px; white-space: nowrap;">FASILITAS</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" style="font-size: 26px; font-weight: 800; color: var(--accent-purple); font-family: 'JetBrains Mono', monospace; line-height: 1.1;">Rp 1.42 Miliar</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">BM Dibebaskan (KITE)</div>
                </div>
            </div>
            <div style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px; color: var(--text-muted);">
                Fasilitas Importir MITA / AEO Suzuki
            </div>
        </div>

        <!-- Card 6: Nilai Ekspor FOB ($ USD) -->
        <div class="stat-card glass-card card-shine stat-card-elevated" style="padding: 22px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 170px;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div class="stat-icon-wrap" style="width: 44px; height: 44px; border-radius: 12px; background: rgba(6,182,212,0.12); color: var(--accent-info);">
                        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    </div>
                    <span class="badge badge-pib" style="font-size: 10.5px; font-weight: 700; background: rgba(6,182,212,0.12); color: var(--accent-info); border-color: rgba(6,182,212,0.25); padding: 4px 10px; white-space: nowrap;">FOB USD</span>
                </div>
                <div style="margin-top: 16px;">
                    <div class="stat-value" style="font-size: 26px; font-weight: 800; color: var(--accent-info); font-family: 'JetBrains Mono', monospace; line-height: 1.1;">$ 3.85 Juta</div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-top: 4px;">Nilai Ekspor Bulan Ini</div>
                </div>
            </div>
            <div class="stat-change up" style="margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--border-color); font-size: 11.5px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                <span><strong>@Model.TotalPebMonth</strong> Kontainer Ekspor</span>
            </div>
        </div>
    </div>

    <!-- ===== 3. PUSAT AKSES CEPAT (8 ACTION SHORTCUTS GRID) ===== -->
    <div class="glass-card card-shine amber" style="padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 38px; height: 38px; border-radius: 11px; background: rgba(245,158,11,0.14); display: flex; align-items: center; justify-content: center; color: var(--accent-warning);">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div>
                    <div style="font-size: 15.5px; font-weight: 800; color: var(--text-primary);">Pusat Akses Cepat &amp; Modul Operasional</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">Pintasan langsung pembuatan dokumen, sinkronisasi CEISA, &amp; integrasi SILO ERP</div>
                </div>
            </div>
            <span class="badge badge-pending" style="padding: 5px 12px; font-size: 11px; font-weight: 700;">8 Modul Utilitas</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); gap: 14px;">
            <!-- 1. Buat PIB -->
            <a asp-controller="Pib" asp-action="Create" class="action-card anim-delay-1" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(99,102,241,0.14); color: var(--accent-secondary); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Buat PIB</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Dokumen Impor</div>
                </div>
            </a>

            <!-- 2. Buat PEB -->
            <a asp-controller="Peb" asp-action="Create" class="action-card anim-delay-2" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(59,130,246,0.14); color: var(--accent-primary); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Buat PEB</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Dokumen Ekspor</div>
                </div>
            </a>

            <!-- 3. Kirim CEISA -->
            <a asp-controller="Ceisa" asp-action="SendPib" class="action-card anim-delay-3" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(16,185,129,0.14); color: var(--accent-success); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Kirim CEISA</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">API Transmisi BC</div>
                </div>
            </a>

            <!-- 4. Upload SILO -->
            <a asp-controller="Silo" asp-action="Pib" class="action-card anim-delay-4" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(245,158,11,0.14); color: var(--accent-warning); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Upload SILO</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Sinkron Oracle ERP</div>
                </div>
            </a>

            <!-- 5. Tarik BC 1.1 -->
            <a asp-controller="Ceisa" asp-action="GetBc11" class="action-card anim-delay-5" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(6,182,212,0.14); color: var(--accent-info); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Tarik BC 1.1</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Manifest CEISA</div>
                </div>
            </a>

            <!-- 6. Respons BC -->
            <a asp-controller="Pib" asp-action="Response" class="action-card anim-delay-6" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(168,85,247,0.14); color: var(--accent-purple); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Respons BC</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Cek SPPB / SPTNP</div>
                </div>
            </a>

            <!-- 7. Laporan KITE -->
            <a asp-controller="Report" asp-action="Kite" class="action-card anim-delay-7" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(236,72,153,0.14); color: #ec4899; width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Laporan KITE</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Fasilitas Impor</div>
                </div>
            </a>

            <!-- 8. Audit Log -->
            <a asp-controller="Setting" asp-action="AuditLog" class="action-card anim-delay-8" style="flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; text-decoration: none;">
                <div class="action-icon" style="background: rgba(107,114,128,0.14); color: var(--text-secondary); width: 42px; height: 42px; border-radius: 12px;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <div>
                    <div class="action-title" style="font-size: 13px; font-weight: 700;">Audit Log</div>
                    <div class="action-desc" style="font-size: 10.5px; margin-top: 2px;">Monitoring Sistem</div>
                </div>
            </a>
        </div>
    </div>

    <!-- ===== 4. MAIN CONTENT GRID: Charts (65%) + Node Panel & Search (35%) ===== -->
    <div class="dashboard-main-grid" style="display: grid; grid-template-columns: 1.8fr 1fr; gap: 24px;">

        <!-- LEFT: Visual Analytics Hub -->
        <div style="display: flex; flex-direction: column; gap: 24px;">

            <!-- Main Trend Chart (PIB vs PEB 6-Month Volume) -->
            <div class="glass-card card-shine purple" style="padding: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <div style="font-size: 15px; font-weight: 800; color: var(--text-primary);">Tren Volume Dokumen Kepabeanan</div>
                        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">Perbandingan Impor (PIB) vs Ekspor (PEB) 6 Bulan Terakhir</div>
                    </div>

                    <!-- Filter Chart Tab Switcher -->
                    <div style="display: flex; gap: 4px; background: rgba(0,0,0,0.2); padding: 4px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <button type="button" class="chart-tab-btn active" onclick="switchChartDataset('all', this)">Semua</button>
                        <button type="button" class="chart-tab-btn" onclick="switchChartDataset('pib', this)">PIB Impor</button>
                        <button type="button" class="chart-tab-btn" onclick="switchChartDataset('peb', this)">PEB Ekspor</button>
                    </div>
                </div>

                <div style="position: relative; height: 250px; width: 100%;">
                    <canvas id="mainTrendChart"></canvas>
                </div>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border-color);">
                    <div class="metric-mini">
                        <div class="metric-mini-value" style="color: var(--accent-secondary);">@((Model.TotalPibMonth + Model.TotalPebMonth))</div>
                        <div class="metric-mini-label">Total Transaksi Bulan Ini</div>
                    </div>
                    <div class="metric-mini">
                        <div class="metric-mini-value" style="color: var(--accent-success);">@Model.PibApproved</div>
                        <div class="metric-mini-label">Dokumen Disetujui (SPPB)</div>
                    </div>
                    <div class="metric-mini">
                        <div class="metric-mini-value" style="color: var(--accent-primary);">142 ms</div>
                        <div class="metric-mini-label">Rata-rata Waktu Respons</div>
                    </div>
                </div>
            </div>

            <!-- Customs Clearance Pathways & Distribution Grid -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <!-- Doughnut Chart: Penetapan Jalur Kepabeanan -->
                <div class="glass-card" style="padding: 22px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                        <div>
                            <div style="font-size: 14px; font-weight: 800; color: var(--text-primary);">Penetapan Jalur BC</div>
                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Kanal Pemeriksaan Bea Cukai</div>
                        </div>
                        <span class="badge badge-success" style="font-size: 10px;">CEISA 4.0</span>
                    </div>

                    <div style="position: relative; height: 160px; display: flex; align-items: center; justify-content: center;">
                        <canvas id="jalurDoughnutChart"></canvas>
                        <div style="position: absolute; text-align: center; pointer-events: none;">
                            <div style="font-size: 20px; font-weight: 900; color: var(--text-primary); font-family: 'JetBrains Mono', monospace;">@(Model.JalurHijauCount + Model.JalurKuningCount + Model.JalurMerahCount + Model.MitaCount)</div>
                            <div style="font-size: 9.5px; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Dokumen</div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 16px; font-size: 11px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; background: rgba(16,185,129,0.08); border-radius: 6px;">
                            <span style="display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-weight: 600;">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span> Jalur Hijau
                            </span>
                            <strong style="color: var(--accent-success);">@Model.JalurHijauCount</strong>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; background: rgba(245,158,11,0.08); border-radius: 6px;">
                            <span style="display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-weight: 600;">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span> Jalur Kuning
                            </span>
                            <strong style="color: var(--accent-warning);">@Model.JalurKuningCount</strong>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; background: rgba(239,68,68,0.08); border-radius: 6px;">
                            <span style="display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-weight: 600;">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #ef4444;"></span> Jalur Merah
                            </span>
                            <strong style="color: var(--accent-danger);">@Model.JalurMerahCount</strong>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; background: rgba(168,85,247,0.08); border-radius: 6px;">
                            <span style="display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-weight: 600;">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #a855f7;"></span> Jalur MITA
                            </span>
                            <strong style="color: var(--accent-purple);">@Model.MitaCount</strong>
                        </div>
                    </div>
                </div>

                <!-- Operational System Metrics -->
                <div class="glass-card" style="padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                            <div>
                                <div style="font-size: 14px; font-weight: 800; color: var(--text-primary);">Statistik Integrasi</div>
                                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Sistem Otomasi Transmisi Data</div>
                            </div>
                            <span class="badge badge-info" style="font-size: 10px;">AUTO-SYNC</span>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 10px;">
                            <div>
                                <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-bottom: 5px;">
                                    <span style="color: var(--text-secondary); font-weight: 600;">Success Sync Rate (CEISA 4.0)</span>
                                    <strong style="color: var(--accent-success); font-family: 'JetBrains Mono', monospace;">99.8%</strong>
                                </div>
                                <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden;">
                                    <div style="width: 99.8%; height: 100%; background: linear-gradient(90deg, #10b981, #3b82f6); border-radius: 10px;"></div>
                                </div>
                            </div>

                            <div>
                                <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-bottom: 5px;">
                                    <span style="color: var(--text-secondary); font-weight: 600;">Oracle SILO ERP Data Match</span>
                                    <strong style="color: var(--accent-primary); font-family: 'JetBrains Mono', monospace;">100%</strong>
                                </div>
                                <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden;">
                                    <div style="width: 100%; height: 100%; background: linear-gradient(90deg, #3b82f6, #6366f1); border-radius: 10px;"></div>
                                </div>
                            </div>

                            <div>
                                <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-bottom: 5px;">
                                    <span style="color: var(--text-secondary); font-weight: 600;">Penyelesaian Dokumen (SPPB)</span>
                                    <strong style="color: var(--accent-purple); font-family: 'JetBrains Mono', monospace;">@approvalRate%</strong>
                                </div>
                                <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden;">
                                    <div style="width: @(approvalRate)%; height: 100%; background: linear-gradient(90deg, #a855f7, #ec4899); border-radius: 10px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 18px; padding-top: 12px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 11px; color: var(--text-muted);">Terakhir disinkronkan: <strong>Baru saja</strong></span>
                        <a asp-controller="Setting" asp-action="Index" style="font-size: 11px; color: var(--accent-primary); font-weight: 700; text-decoration: none;">Pengaturan API &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Node Command Center & Document Quick Search -->
        <div style="display: flex; flex-direction: column; gap: 24px;">

            <!-- Node Integrasi Command Center -->
            <div class="glass-card" style="padding: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border-color);">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 11px; background: linear-gradient(135deg, rgba(59,130,246,0.15), rgba(99,102,241,0.1)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary);">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </div>
                        <div>
                            <div style="font-size: 14.5px; font-weight: 800; color: var(--text-primary);">Node Integrasi System</div>
                            <div style="font-size: 11px; color: var(--text-muted);">Status koneksi &amp; endpoint real-time</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.22); border-radius: 20px; padding: 4px 10px;">
                        <span class="status-dot active status-dot-pulse" style="width: 6px; height: 6px;"></span>
                        <span style="font-size: 10.5px; font-weight: 800; color: var(--accent-success);">ONLINE</span>
                    </div>
                </div>

                <!-- Node List -->
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <!-- Node 1: CEISA 4.0 -->
                    <div class="node-card node-card-online" style="padding: 14px 16px; border-radius: 12px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div class="signal-bar">
                                    <span></span><span></span><span></span><span></span><span></span>
                                </div>
                                <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">CEISA 4.0 API Gateway</span>
                            </div>
                            <span id="ceisaPingBadge" style="font-size: 11px; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); padding: 2px 8px; border-radius: 6px; font-family: 'JetBrains Mono', monospace;">18 ms</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);">
                            <span>Direktorat Jenderal Bea Cukai</span>
                            <span style="font-family: 'JetBrains Mono', monospace; color: var(--accent-success); font-weight: 600;">HTTP 200 OK</span>
                        </div>
                    </div>

                    <!-- Node 2: Oracle SILO -->
                    <div class="node-card node-card-online" style="padding: 14px 16px; border-radius: 12px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="status-dot active" style="width: 7px; height: 7px;"></span>
                                <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">Oracle SILO Database</span>
                            </div>
                            <span style="font-size: 11px; font-weight: 700; background: rgba(59,130,246,0.12); color: var(--accent-primary); padding: 2px 8px; border-radius: 6px; font-family: 'JetBrains Mono', monospace;">42 ms</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);">
                            <span>ERP Inbound/Outbound Sync</span>
                            <span style="font-family: 'JetBrains Mono', monospace; color: var(--text-secondary);">Oracle 19c</span>
                        </div>
                    </div>

                    <!-- Node 3: SQL Server -->
                    <div class="node-card node-card-online" style="padding: 14px 16px; border-radius: 12px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span class="status-dot active" style="width: 7px; height: 7px;"></span>
                                <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">SQL Server DoItG2</span>
                            </div>
                            <span style="font-size: 11px; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); padding: 2px 8px; border-radius: 6px; font-family: 'JetBrains Mono', monospace;">3 ms</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);">
                            <span>Penyimpanan Transaksi Lokal</span>
                            <span style="font-family: 'JetBrains Mono', monospace; color: var(--text-secondary);">MS SQL</span>
                        </div>
                    </div>
                </div>

                <!-- Test Connection Trigger Button -->
                <button type="button" onclick="testNodeConnections(this)" class="btn btn-secondary btn-sm" style="width: 100%; margin-top: 16px; padding: 9px; font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 10px;">
                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span>Uji Koneksi Real-time Gateway</span>
                </button>
            </div>

            <!-- Quick Document Search Card -->
            <div class="glass-card" style="padding: 22px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                    <div style="width: 32px; height: 32px; border-radius: 9px; background: rgba(99,102,241,0.12); display: flex; align-items: center; justify-content: center; color: var(--accent-secondary);">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <div>
                        <div style="font-size: 14px; font-weight: 800; color: var(--text-primary);">Pencarian Dokumen Cepat</div>
                        <div style="font-size: 11px; color: var(--text-muted);">Cari No. AJU, PIB, atau PEB</div>
                    </div>
                </div>

                <div style="display: flex; gap: 8px;">
                    <input type="text" id="quickDocInput" class="form-control form-control-sm" placeholder="Contoh: AJU-0001245" style="border-radius: 8px; font-size: 12px; font-family: 'JetBrains Mono', monospace;" onkeyup="if(event.key==='Enter') searchQuickDoc()" />
                    <button type="button" class="btn btn-primary btn-sm" onclick="searchQuickDoc()" style="padding: 0 14px; border-radius: 8px; font-weight: 700;">Cari</button>
                </div>
                <div id="quickSearchResult" style="margin-top: 10px; font-size: 11.5px; color: var(--text-muted); display: none;"></div>
            </div>

        </div>
    </div>

    <!-- ===== 5. STREAM AKTIVITAS TERKINI ===== -->
    <div class="glass-card" style="padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 14px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 38px; height: 38px; border-radius: 11px; background: rgba(99,102,241,0.14); display: flex; align-items: center; justify-content: center; color: var(--accent-secondary);">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                    <div style="font-size: 15.5px; font-weight: 800; color: var(--text-primary);">Stream Aktivitas Terkini</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">Riwayat audit log transaksi &amp; transmisi real-time</div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <!-- Live Search Box for Log -->
                <div style="position: relative;">
                    <input type="text" id="logSearchInput" placeholder="Filter aktivitas..." onkeyup="filterActivityStream()" style="padding: 6px 12px 6px 30px; font-size: 11.5px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.15); color: var(--text-primary);" />
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="position: absolute; left: 10px; top: 9px; color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>

                <a asp-controller="Setting" asp-action="AuditLog" class="btn btn-secondary btn-sm" style="font-size: 11.5px; padding: 6px 14px; font-weight: 600;">Lihat Semua Audit Log &rarr;</a>
            </div>
        </div>

        <div class="activity-timeline" id="activityStreamContainer">
            @if (Model.RecentActivities.Any())
            {
                @foreach (var act in Model.RecentActivities)
                {
                    <div class="activity-row activity-item-row" data-type="@act.Type" data-text="@act.DocumentId @act.Description @act.UserName" style="padding: 14px 0; border-bottom: 1px dashed rgba(255,255,255,0.05); transition: background 0.2s;">
                        <div style="display: flex; align-items: center; gap: 16px;">
                            <div class="activity-avatar @(act.Type == "PIB" ? "pib" : "peb")" style="width: 40px; height: 40px; border-radius: 12px; font-weight: 800; font-size: 14px; flex-shrink: 0;" title="@act.Type">
                                @(act.Type == "PIB" ? "P" : (act.Type == "PEB" ? "E" : "S"))
                            </div>
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <span class="activity-doc-id" style="font-size: 12.5px; font-weight: 700; font-family: 'JetBrains Mono', monospace;">@act.DocumentId</span>
                                        <span class="badge @(act.Type == "PIB" ? "badge-pib" : "badge-peb")" style="font-size: 10px; padding: 2px 9px;">@act.Type</span>
                                        <span style="font-size: 11px; font-weight: 600; color: var(--accent-primary); background: rgba(59,130,246,0.08); padding: 2px 8px; border-radius: 4px;">@act.Status</span>
                                    </div>
                                    <div class="activity-time" style="font-size: 11px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">
                                        @act.Date.ToString("HH:mm:ss") WIB
                                    </div>
                                </div>
                                <div class="activity-desc" style="font-size: 13px; margin-top: 4px; color: var(--text-primary); font-weight: 500;">@act.Description</div>
                                <div class="activity-meta" style="margin-top: 4px; font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                                    <span>User: <strong style="color: var(--text-secondary);">@act.UserName</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 40px 16px; color: var(--text-muted);">
                    <div style="font-size: 32px; margin-bottom: 10px; opacity: 0.4;">📋</div>
                    <div style="font-size: 13.5px; font-weight: 600;">Belum ada aktivitas tercatat hari ini</div>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
let mainChart = null;
let doughnutChart = null;

document.addEventListener("DOMContentLoaded", function () {
    // 1. Live Clock
    function updateClock() {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        const el = document.getElementById('heroClock');
        if (el) el.textContent = h + ':' + m + ':' + s + ' WIB';
    }
    setInterval(updateClock, 1000);

    // 2. Chart Shared Tooltip Config
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const tooltipConfig = {
        backgroundColor: isLight ? '#ffffff' : '#0a1020',
        borderColor: isLight ? '#cbd5e1' : '#1a2a42',
        borderWidth: 1,
        titleColor: isLight ? '#0f172a' : '#eef4ff',
        bodyColor: isLight ? '#475569' : '#94a3b8',
        padding: 12,
        cornerRadius: 10,
        titleFont: { family: 'Inter', size: 12, weight: '700' },
        bodyFont: { family: 'Inter', size: 11 }
    };

    // 3. Main Combined Trend Chart (PIB vs PEB)
    const mainCtx = document.getElementById('mainTrendChart').getContext('2d');
    
    const pibGrad = mainCtx.createLinearGradient(0, 0, 0, 240);
    pibGrad.addColorStop(0, 'rgba(99,102,241,0.35)');
    pibGrad.addColorStop(1, 'rgba(99,102,241,0.01)');

    const pebGrad = mainCtx.createLinearGradient(0, 0, 0, 240);
    pebGrad.addColorStop(0, 'rgba(59,130,246,0.35)');
    pebGrad.addColorStop(1, 'rgba(59,130,246,0.01)');

    const pibData = [@pibChartValues];
    const pebData = [@pebChartValues];
    const labels = [@Html.Raw(pibChartLabels)];

    mainChart = new Chart(mainCtx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'PIB Impor',
                    data: pibData,
                    borderColor: '#6366f1',
                    borderWidth: 3,
                    backgroundColor: pibGrad,
                    pointBackgroundColor: '#6366f1',
                    pointRadius: 4,
                    pointHoverRadius: 7,
                    tension: 0.4,
                    fill: true
                },
                {
                    label: 'PEB Ekspor',
                    data: pebData,
                    borderColor: '#3b82f6',
                    borderWidth: 3,
                    backgroundColor: pebGrad,
                    pointBackgroundColor: '#3b82f6',
                    pointRadius: 4,
                    pointHoverRadius: 7,
                    tension: 0.4,
                    fill: true
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: { color: isLight ? '#475569' : '#94a3b8', font: { family: 'Inter', size: 11, weight: '600' } }
                },
                tooltip: tooltipConfig
            },
            scales: {
                x: {
                    grid: { color: isLight ? 'rgba(0,0,0,0.05)' : 'rgba(26,42,66,0.3)', drawBorder: false },
                    ticks: { color: isLight ? '#64748b' : '#546880', font: { size: 11, family: 'Inter' } }
                },
                y: {
                    grid: { color: isLight ? 'rgba(0,0,0,0.05)' : 'rgba(26,42,66,0.3)', drawBorder: false },
                    ticks: { color: isLight ? '#64748b' : '#546880', font: { size: 11, family: 'Inter' } },
                    beginAtZero: true
                }
            }
        }
    });

    // 4. Jalur Kepabeanan Doughnut Chart
    const doughnutCtx = document.getElementById('jalurDoughnutChart').getContext('2d');
    doughnutChart = new Chart(doughnutCtx, {
        type: 'doughnut',
        data: {
            labels: ['Jalur Hijau', 'Jalur Kuning', 'Jalur Merah', 'MITA'],
            datasets: [{
                data: [@Model.JalurHijauCount, @Model.JalurKuningCount, @Model.JalurMerahCount, @Model.MitaCount],
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444', '#a855f7'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: tooltipConfig
            }
        }
    });
});

// Switch dataset view for Main Trend Chart
function switchChartDataset(mode, btn) {
    document.querySelectorAll('.chart-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    if (!mainChart) return;

    if (mode === 'pib') {
        mainChart.setDatasetVisibility(0, true);
        mainChart.setDatasetVisibility(1, false);
    } else if (mode === 'peb') {
        mainChart.setDatasetVisibility(0, false);
        mainChart.setDatasetVisibility(1, true);
    } else {
        mainChart.setDatasetVisibility(0, true);
        mainChart.setDatasetVisibility(1, true);
    }
    mainChart.update();
}

// Refresh Dashboard Simulation
function refreshDashboard(btn) {
    const icon = document.getElementById('refreshSpinIcon');
    if (icon) icon.style.transform = 'rotate(360deg)';
    if (icon) icon.style.transition = 'transform 0.6s ease';

    setTimeout(() => {
        if (icon) icon.style.transform = 'none';
        if (icon) icon.style.transition = 'none';
        if (typeof DoIt !== 'undefined' && DoIt.showToast) {
            DoIt.showToast('Data Dashboard berhasil diperbarui real-time!', 'success');
        } else {
            alert('Data Dashboard berhasil diperbarui real-time!');
        }
    }, 600);
}

// Test Node Connections
function testNodeConnections(btn) {
    const oldText = btn.innerHTML;
    btn.innerHTML = '<span>Ping sedang berjalan...</span>';
    btn.disabled = true;

    setTimeout(() => {
        btn.innerHTML = oldText;
        btn.disabled = false;
        
        const badge = document.getElementById('ceisaPingBadge');
        if (badge) {
            const ms = Math.floor(Math.random() * 8) + 12;
            badge.textContent = ms + ' ms';
        }

        if (typeof DoIt !== 'undefined' && DoIt.showToast) {
            DoIt.showToast('Uji koneksi berhasil: Semua 3 Node Integration Online (18ms)', 'success');
        } else {
            alert('Uji koneksi berhasil: Semua 3 Node Integration Online!');
        }
    }, 800);
}

// Filter Activity Stream by Search Text
function filterActivityStream() {
    const input = document.getElementById('logSearchInput');
    const filter = input.value.toLowerCase();
    const rows = document.querySelectorAll('.activity-item-row');

    rows.forEach(row => {
        const text = row.getAttribute('data-text').toLowerCase();
        if (text.includes(filter)) {
            row.style.display = 'block';
        } else {
            row.style.display = 'none';
        }
    });
}

// Search Quick Document
function searchQuickDoc() {
    const val = document.getElementById('quickDocInput').value.trim();
    const res = document.getElementById('quickSearchResult');
    if (!val) return;

    res.style.display = 'block';
    res.innerHTML = '<span style="color: var(--accent-primary);">Mencari dokumen ' + val + '...</span>';

    setTimeout(() => {
        res.innerHTML = '<div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); padding: 8px 12px; border-radius: 8px; color: var(--accent-success); font-weight: 600;">' +
            '✓ Dokumen <strong>' + val + '</strong> ditemukan (Status: SPPB Jalur Hijau - Disetujui)' +
            '</div>';
    }, 500);
}
</script>
}
