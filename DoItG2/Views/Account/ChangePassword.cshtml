@model DoItG2.Models.Auth.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Ubah Password";
}

<div class="hero-banner mb-24" style="padding: 20px 24px;">
    <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(99,102,241,0.12)); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); border: 1px solid rgba(59,130,246,0.2);">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; color: var(--text-primary); margin: 0; letter-spacing: -0.3px;">Ubah Password Akun Pengguna</h1>
                <p style="font-size: 12px; color: var(--text-muted); margin: 3px 0 0;">Perbarui password keamanan akun Anda untuk menjaga kerahasiaan akses sistem</p>
            </div>
        </div>
    </div>
</div>

<div class="glass-card" style="max-width: 480px; margin: 0 auto; padding: 24px;">
    <form method="post" action="/Account/ChangePassword">
        @Html.AntiForgeryToken()

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Password Saat Ini <span class="required">*</span></label>
            <input type="password" name="CurrentPassword" class="form-control" placeholder="Masukkan password lama Anda" required style="height: 42px;" />
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label">Password Baru <span class="required">*</span></label>
            <input type="password" name="NewPassword" class="form-control" placeholder="Minimal 6 karakter" required style="height: 42px;" />
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Konfirmasi Password Baru <span class="required">*</span></label>
            <input type="password" name="ConfirmPassword" class="form-control" placeholder="Ulangi password baru Anda" required style="height: 42px;" />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; height: 44px; font-size: 14px; font-weight: 700;">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Simpan Password Baru
        </button>
    </form>
</div>
