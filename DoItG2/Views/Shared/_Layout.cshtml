<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DO-IT G2 — Document Integration Tools Generasi 2 untuk PT. Suzuki Indomobil" />
    <title>@ViewData["Title"] — DO-IT G2</title>
    <link rel="icon" type="image/png" href="~/images/suzuki-logo-square.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
            const scale = localStorage.getItem('app-display-scale');
            if (scale && scale !== '100') {
                document.documentElement.setAttribute('data-scale', scale);
            }
        })();
    </script>
</head>
<body>
<!-- UIVERSE.IO LOADING SCREEN OVERLAY (By Praashoo7) -->
<div class="suzuki-loading-overlay fade-out" id="suzukiLoadingOverlay">
    <div class="loading-card">
        <div class="loading">
            <span class="l">L</span>
            <span class="o">o</span>
            <span class="a">a</span>
            <span class="d">d</span>
            <span class="i">i</span>
            <span class="n">n</span>
            <span class="g">g</span>
            <span class="d1">.</span>
            <span class="d2">.</span>
        </div>
        <div class="load">
            <div class="progress"></div>
            <div class="progress"></div>
            <div class="progress"></div>
            <div class="progress"></div>
        </div>
        <div class="suzuki-loading-status" id="suzukiLoadingStatus">Inisialisasi sistem...</div>
    </div>
</div>

<div class="app-wrapper">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
                <div class="logo-icon-img-container">
                    <img src="~/images/suzuki-logo-square.png" alt="Suzuki Logo" class="logo-img-square" asp-append-version="true" />
                </div>
                <div class="logo-text">
                    <div class="logo-title">DO-IT G2</div>
                    <div class="logo-subtitle" style="display: flex; align-items: center; gap: 5px; margin-top: 2px;">
                        @{
                            var activeEntity = User.FindFirst("Entity")?.Value ?? "SIM";
                            var isSis = activeEntity == "SIS";
                            var badgeBg = isSis ? "rgba(5, 150, 105, 0.15)" : "rgba(220, 38, 38, 0.15)";
                            var badgeColor = isSis ? "#059669" : "#dc2626";
                            var badgeBorder = isSis ? "rgba(5, 150, 105, 0.3)" : "rgba(220, 38, 38, 0.3)";
                        }
                        <span style="font-size: 9.5px; padding: 1px 5px; font-weight: 800; border-radius: 4px; background: @badgeBg; color: @badgeColor; border: 1px solid @badgeBorder;">@activeEntity</span>
                        <span style="font-size: 10.5px; color: var(--text-muted); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(isSis ? "Suzuki Sales" : "Suzuki Motor")</span>
                    </div>
                </div>
            </a>
        </div>

        @{
            var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "STAFF_EXIM";
            var isAdminRole = roleClaim.Contains("ADMIN", StringComparison.OrdinalIgnoreCase);
            var isManagerRole = roleClaim.Contains("MANAJER_OPS", StringComparison.OrdinalIgnoreCase) || roleClaim.Contains("VIEWER", StringComparison.OrdinalIgnoreCase);
            var isStaffRole = !isAdminRole && !isManagerRole;
        }
        <nav class="sidebar-nav">
            <!-- Dashboard -->
            <div class="nav-item">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    <span>Dashboard</span>
                </a>
            </div>

            <!-- 1. CEISA 4.0 -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navCeisa">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span>CEISA 4.0</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navCeisa">
                    @if (!isManagerRole)
                    {
                        <a class="nav-link" asp-controller="Ceisa" asp-action="SendPib">Kirim PIB ke CEISA</a>
                        <a class="nav-link" asp-controller="Ceisa" asp-action="SendPeb">Kirim PEB ke CEISA</a>
                    }
                    <a class="nav-link" asp-controller="Ceisa" asp-action="GetBc11">Tarik BC 1.1</a>
                </div>
            </div>

            <!-- 2. GET SILO -->
            @if (!isManagerRole)
            {
                <div class="nav-item">
                    <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navGetSilo">
                        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        <span>GET SILO</span>
                        <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                    <div class="nav-collapse" id="navGetSilo">
                        <a class="nav-link" asp-controller="Silo" asp-action="Pib">Tarik SILO PIB (Impor)</a>
                        <a class="nav-link" asp-controller="Silo" asp-action="Peb">Tarik SILO PEB (Ekspor)</a>
                    </div>
                </div>
            }

            <!-- 3. VIEW SILO -->
            <div class="nav-item">
                <a class="nav-link" asp-controller="Silo" asp-action="ViewSilo">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    <span>VIEW SILO</span>
                </a>
            </div>

            <!-- 4. PIB -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navPib">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    <span>PIB</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navPib">
                    <a class="nav-link" asp-controller="Pib" asp-action="Index">Daftar PIB</a>
                    @if (!isManagerRole)
                    {
                        <a class="nav-link" asp-controller="Pib" asp-action="Create">Buat PIB Baru</a>
                    }
                    <a class="nav-link" asp-controller="Pib" asp-action="Response">Respons PIB (SPPB/SPTNP)</a>
                    @if (!isManagerRole)
                    {
                        <a class="nav-link" asp-controller="Pib" asp-action="Upload">Upload Excel PIB</a>
                    }
                </div>
            </div>

            <!-- 5. PEB -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navPeb">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3m3 0h3m0 0v3m0-3l-6 6"/></svg>
                    <span>PEB</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navPeb">
                    <a class="nav-link" asp-controller="Peb" asp-action="Index">Daftar PEB</a>
                    @if (!isManagerRole)
                    {
                        <a class="nav-link" asp-controller="Peb" asp-action="Create">Buat PEB Baru</a>
                    }
                    <a class="nav-link" asp-controller="Peb" asp-action="Response">Respons PEB (NPE)</a>
                    @if (!isManagerRole)
                    {
                        <a class="nav-link" asp-controller="Peb" asp-action="Upload">Upload Excel PEB</a>
                    }
                </div>
            </div>

            <!-- 6. Send to SILO -->
            @if (!isManagerRole)
            {
                <div class="nav-item">
                    <a class="nav-link" asp-controller="Silo" asp-action="ExportToSilo">
                        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        <span>Send to SILO</span>
                    </a>
                </div>
            }

            <!-- Pusat Approval -->
            <div class="nav-item">
                <a class="nav-link" asp-controller="Approval" asp-action="Index">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Pusat Approval</span>
                </a>
            </div>

            <!-- 7. REPORT -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navReport">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>REPORT</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navReport">
                    <a class="nav-link" asp-controller="Report" asp-action="Pib">Laporan PIB</a>
                    <a class="nav-link" asp-controller="Report" asp-action="Peb">Laporan PEB</a>
                    <a class="nav-link" asp-controller="Report" asp-action="Kite">Laporan KITE</a>
                    <a class="nav-link" asp-controller="Report" asp-action="LapitInv">IT Inventory</a>
                    <a class="nav-link" asp-controller="Report" asp-action="Specialized">Laporan Khusus (MITA/AEO)</a>
                </div>
            </div>

            <!-- 8. MASTER -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navMaster">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s-8-1.79-8-4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                    <span>MASTER</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navMaster">
                    <a class="nav-link" asp-controller="Master" asp-action="KursPajak">Kurs Pajak (NDPBM)</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Part">Master Part Suzuki</a>
                    <a class="nav-link" asp-controller="Master" asp-action="DokumenPib">Dokumen Pabean</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Lartas">PI Lartas</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Supplier">Master Pemasok</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Buyer">Master Pembeli</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Fasilitas">SKEP Fasilitas</a>
                    <a class="nav-link" asp-controller="Master" asp-action="Pkb">Master PKB</a>
                </div>
            </div>

            <!-- 9. CONFIGURATION (Admin Dokumen Only) -->
            @if (isAdminRole)
            {
                <div class="nav-item">
                    <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navConfig">
                        <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        <span>CONFIGURATION</span>
                        <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                    <div class="nav-collapse" id="navConfig">
                        <a class="nav-link" asp-controller="Setting" asp-action="Index">Pengaturan Sistem</a>
                        <a class="nav-link" asp-controller="User" asp-action="Index">Kelola Pengguna</a>
                    </div>
                </div>
            }

            <!-- 10. UTILITY -->
            <div class="nav-item">
                <a class="nav-link dropdown-toggle-link" href="javascript:void(0)" data-toggle="sidebar-dropdown" data-target="#navUtility">
                    <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>
                    <span>UTILITY</span>
                    <svg class="nav-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </a>
                <div class="nav-collapse" id="navUtility">
                    <a class="nav-link" asp-controller="Setting" asp-action="AuditLog">Audit Log Aktivitas</a>
                    @if (isAdminRole)
                    {
                        <a class="nav-link" asp-controller="Setting" asp-action="Backup">Backup &amp; Restore DB</a>
                    }
                    <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Ubah Password</a>
                </div>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="user-info" onclick="DoIt.openModal('userMenuModal')" title="Menu Profil & Keluar">
                <div class="avatar-ring">
                    <div class="user-avatar">
                        @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0,1)?.ToUpper() ?? "U")
                    </div>
                    <span class="user-status-dot-footer"></span>
                </div>
                <div class="user-details">
                    <div class="user-name">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</div>
                    <div class="user-role">
                        @{
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            var roleTitle = role switch {
                                "ADMIN_DOKUMEN" or "ADMIN" => "Admin Dokumen",
                                "MANAJER_OPS" or "SUPERVISOR" or "MANAGER" => "Manajer Operasional",
                                _ => "Staf Ekspor-Impor"
                            };
                        }
                        @roleTitle
                    </div>
                </div>
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted); flex-shrink: 0;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
            </div>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-content">
        <header class="topbar">
            <div class="topbar-left">
                <button class="topbar-btn sidebar-toggle-btn" id="sidebarToggleBtn" title="Menu Sidebar">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div>
                    <div class="page-title">@ViewData["Title"]</div>
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <div class="breadcrumb-nav">@Html.Raw(ViewData["Breadcrumb"])</div>
                    }
                </div>
            </div>
            <div class="topbar-right">
                <!-- Active Entity Indicator: SIM (Red) vs SIS (Green) -->
                @{
                    var topEntity = User.FindFirst("Entity")?.Value ?? "SIM";
                    var topEntityName = User.FindFirst("EntityName")?.Value ?? "PT. Suzuki Indomobil Motor";
                    var topEntityKey = User.FindFirst("EntityKey")?.Value ?? "81";
                    var topIsSis = topEntity == "SIS";
                    var topBadgeBg = topIsSis ? "rgba(5, 150, 105, 0.12)" : "rgba(220, 38, 38, 0.12)";
                    var topBadgeColor = topIsSis ? "#059669" : "#dc2626";
                    var topBadgeBorder = topIsSis ? "rgba(5, 150, 105, 0.3)" : "rgba(220, 38, 38, 0.3)";
                }
                <div style="display: flex; align-items: center; gap: 8px; background: @topBadgeBg; border: 1px solid @topBadgeBorder; border-radius: 20px; padding: 4px 12px; font-size: 11px;" title="@topEntityName (Key: @topEntityKey)">
                    <span style="font-size: 10.5px; font-weight: 800; color: @topBadgeColor;">@topEntity</span>
                    <span style="color: var(--text-muted); font-size: 10px;">|</span>
                    <span style="font-weight: 600; color: var(--text-primary);">@topEntityName</span>
                </div>

                <div class="system-status-pill" title="Status Koneksi Integrasi System">
                    <span class="status-dot active"></span>
                    <span>CEISA 4.0 &amp; SILO Terhubung</span>
                </div>

                <!-- Display Resolution / Scale Selector -->
                <div style="display: flex; align-items: center; gap: 4px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); padding: 2px 8px; height: 32px;" title="Skala Tampilan / Resolusi Laptop">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted); flex-shrink: 0;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                    </svg>
                    <select id="displayScaleSelect" onchange="DoIt.setDisplayScale(this.value)" style="background: transparent; border: none; color: var(--text-secondary); font-size: 11px; font-weight: 600; cursor: pointer; outline: none; padding-right: 2px;">
                        <option value="100" style="background: var(--bg-card); color: var(--text-primary);">100% Layar</option>
                        <option value="85" style="background: var(--bg-card); color: var(--text-primary);">85% Laptop</option>
                        <option value="75" style="background: var(--bg-card); color: var(--text-primary);">75% Fullscreen</option>
                    </select>
                </div>

                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); padding: 4px 10px; font-size: 11px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;" id="topbarClock">--:-- WIB</div>
                
                <!-- Sound Effects Toggle Button -->
                <button class="topbar-btn" id="soundToggleBtn" onclick="DoIt.toggleSound()" title="Efek Suara Sistem (Aktif/Nonaktif)">
                    <svg id="soundIconOn" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/></svg>
                    <svg id="soundIconOff" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                </button>

                <button class="topbar-btn" id="themeToggleBtn" title="Ubah Tema">
                    <svg id="themeIconSun" class="theme-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
                    </svg>
                    <svg id="themeIconMoon" class="theme-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                </button>

                <!-- Notification Dropdown Popover Wrapper -->
                <div style="position: relative;" id="notifWrapper">
                    <button class="topbar-btn" id="notifBtn" title="Notifikasi Real-time" onclick="DoIt.toggleNotifDropdown(event)">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                        <span class="notif-dot" id="notifUnreadDot" style="display: none; background: #ef4444;"></span>
                    </button>

                    <div id="notifPopover" style="position: absolute; right: 0; top: calc(100% + 10px); width: 360px; max-height: 480px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius-md); box-shadow: var(--shadow-lg); padding: 0; display: none; z-index: 1000; overflow: hidden; flex-direction: column;">
                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding: 14px 16px; background: #f8fafc;">
                            <div style="font-size: 13px; font-weight: 700; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                                <span style="font-size: 16px;">🔔</span> Notifikasi &amp; Alert Pabean
                            </div>
                            <button type="button" onclick="DoIt.markAllNotifsRead()" style="background: none; border: none; font-size: 11px; color: #2563eb; font-weight: 600; cursor: pointer;">Tandai Semua Dibaca</button>
                        </div>

                        <div id="notifListContainer" style="overflow-y: auto; max-height: 380px; padding: 8px;">
                            <div style="text-align: center; padding: 24px; color: #94a3b8; font-size: 12px;">Memuat notifikasi...</div>
                        </div>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="topbar-btn" title="Logout">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </button>
                </form>
            </div>
        </header>

        <main class="page-body">
            @if (TempData["Success"] != null)
            {
                <input type="hidden" id="tempSuccess" value="@TempData["Success"]" />
            }
            @if (TempData["Error"] != null)
            {
                <input type="hidden" id="tempError" value="@TempData["Error"]" />
            }
            @RenderBody()
        </main>

        <!-- APP MAIN FOOTER -->
        <footer class="app-main-footer">
            <div class="footer-container">
                <div class="footer-left">
                    <div class="footer-brand">
                        <div class="footer-logo-box">
                            <img src="~/images/suzuki-logo-square.png" alt="Suzuki Emblem" asp-append-version="true" />
                        </div>
                        <div>
                            <div class="footer-title">PT. SUZUKI INDOMOBIL MOTOR</div>
                            <div class="footer-sub">DO-IT G2 Enterprise • Sistem Informasi Import &amp; Ekspor (CEISA 4.0)</div>
                        </div>
                    </div>
                </div>

                <div class="footer-center">
                    <div class="footer-links">
                        <a href="/">Dashboard</a>
                        <span class="footer-sep">•</span>
                        <a href="/Pib">Dokumen PIB (BC 2.0)</a>
                        <span class="footer-sep">•</span>
                        <a href="/Peb">Dokumen PEB (BC 3.0)</a>
                        <span class="footer-sep">•</span>
                        <a href="/Report/Pib">Laporan PIB</a>
                        <span class="footer-sep">•</span>
                        <a href="/Report/Peb">Laporan PEB</a>
                        <span class="footer-sep">•</span>
                        <a href="/Master/Part">Master Part</a>
                    </div>
                </div>

                <div class="footer-right">
                    <div class="footer-status-pill">
                        <span class="status-dot active"></span>
                        <span>CEISA 4.0 Connected • v2.5.0</span>
                    </div>
                    <div class="footer-copy">&copy; @DateTime.Now.Year PT. Suzuki Indomobil Motor. All rights reserved.</div>
                </div>
            </div>
        </footer>
    </div>
</div>

<!-- User Menu Modal -->
<div class="modal-overlay" id="userMenuModal">
    <div class="modal-box" style="max-width:320px">
        <div class="modal-header">
            <span class="modal-title">Akun Saya</span>
            <button class="modal-close" onclick="DoIt.closeModal('userMenuModal')">&times;</button>
        </div>
        <div class="modal-body" style="display:flex;flex-direction:column;gap:8px;padding:16px">
            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-secondary" style="justify-content:flex-start">
                Ganti Password
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger" style="width:100%;justify-content:flex-start">Logout</button>
            </form>
        </div>
    </div>
</div>

<!-- Cool System Warning Confirmation Modal -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box" style="max-width: 440px; padding: 24px; text-align: center; border: 1px solid rgba(245,158,11,0.3); box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 30px rgba(245,158,11,0.15); animation: fadeSlideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
        <div style="width: 60px; height: 60px; border-radius: 18px; background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(239,68,68,0.15)); border: 1px solid rgba(245,158,11,0.35); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: var(--accent-warning); box-shadow: 0 0 20px rgba(245,158,11,0.25);">
            <svg width="30" height="30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h3 class="confirm-title" style="font-size: 17px; font-weight: 800; color: var(--text-primary); margin: 0 0 8px;">Konfirmasi Tindakan Sistem</h3>
        <p class="confirm-message" style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin: 0 0 16px;"></p>
        
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); padding: 9px 12px; margin-bottom: 20px; font-size: 11px; color: var(--text-muted); display: flex; align-items: center; justify-content: center; gap: 6px;">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span>Aksi ini akan diverifikasi &amp; dicatat pada <strong>Audit Log Aktivitas</strong></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <button class="btn btn-secondary confirm-cancel" style="padding: 10px; font-weight: 600;">Batal</button>
            <button class="btn btn-danger confirm-ok" style="padding: 10px; font-weight: 700; background: linear-gradient(135deg, var(--accent-danger), #dc2626); border: none; box-shadow: 0 4px 14px rgba(239,68,68,0.3);">Ya, Lanjutkan</button>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
(function() {
    function updateTopbarClock() {
        var el = document.getElementById('topbarClock');
        if (!el) return;
        var now = new Date();
        var h = String(now.getHours()).padStart(2,'0');
        var m = String(now.getMinutes()).padStart(2,'0');
        el.textContent = h + ':' + m + ' WIB';
    }
    updateTopbarClock();
    setInterval(updateTopbarClock, 30000);
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

